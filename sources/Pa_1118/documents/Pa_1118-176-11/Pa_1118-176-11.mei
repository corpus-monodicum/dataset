]</rend></td><td><rend>lies ((orbem))</rend></td></tr></table></annot><annot startid="#m-9fe185f4-a3ce-46c5-a793-1083b1d4d763" endid="#m-079fb3f8-957b-4c3b-8d6f-d59be223d661" type="emendation" corresp="#m-comment-5"><table><tr><td><ptr target="#m-comment-5-notes-0"/></td><td><rend>(wie 4a)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-5-notes-1"/></td></tr></table></annot><annot startid="#m-d9cbf923-a1bd-4cd6-ad53-53088fbc345d" endid="#m-03da37c5-f203-4f5b-a020-8aee1965e42f"><table><tr><td><rend>((pulchra))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((pulcra))</rend></td></tr></table></annot><annot startid="#m-74f483d0-15e0-4752-9a41-2c8747b0a115" endid="#m-74f483d0-15e0-4752-9a41-2c8747b0a115"><table><tr><td><rend>((ho))</rend></td><td><rend>]</rend></td><td><rend>lies ((o))</rend></td></tr></table></annot><annot startid="#m-cc54c550-5611-4c74-829a-19a289a7d45b" endid="#m-2271fbf6-608f-414a-8ef5-e6fd2c1d748a" type="emendation"><table><tr><td><rend>((leuiasti)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((leuisti)), aber Notation für 4 Silben.</rend></td></tr></table></annot><annot startid="#m-02aa6847-0593-4b33-92b5-06bf8ae6c4b3" endid="#m-67c7887e-74b8-47e4-ab6e-f4f4933d9799" type="emendation"><table><tr><td><rend>((benignissimi))</rend></td><td><rend>]</rend></td><td><rend>((benignussimi))</rend></td></tr></table></annot><annot startid="#m-7fdc22ab-6071-403e-b448-67bdc0185b5d" endid="#m-57821868-a4af-411e-a71c-8115f7e90d04"><table><tr><td><rend>((hempta))</rend></td><td><rend>]</rend></td><td><rend>lies ((empta))</rend></td></tr></table></annot><annot startid="#m-47cd646c-47bd-43cf-aa3b-fe8d630afbb9" endid="#m-53d26e30-812c-4426-9c5e-be7f07548fd2" corresp="#m-comment-11"><table><tr><td><ptr target="#m-comment-11-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation ungenau, dem Eindruck nach:</rend></td><td><ptr target="#m-comment-11-notes-1"/></td><td><rend>, die Edition orientiert sich an 7a.</rend></td></tr></table></annot><annot startid="#m-cee8c888-b956-4b37-8543-5c3ed9b23f42" endid="#m-dd33b2c5-efd4-49d0-a15f-0bf08ea687cd" type="emendation"><table><tr><td><rend>((memet | iam))</rend></td><td><rend>]</rend></td><td><rend>((me me | tiam))</rend></td></tr></table></annot><annot startid="#m-83e63dfe-da90-4477-9e0b-c7a22532204f" endid="#m-66dcef39-24d3-43e3-b93a-e7256f76abd6" corresp="#m-comment-13"><table><tr><td><ptr target="#m-comment-13-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation ungenau, dem Eindruck nach:</rend></td><td><ptr target="#m-comment-13-notes-1"/></td><td><rend>(alles Folgende eine Stufe tiefer), 1. Note korrigiert aus</rend></td><td><ptr target="#m-comment-13-notes-2"/></td><td><rend>; die Edition orientiert sich an 9b, wo zwar der Anschluss nach vorne wegen des Zeilenwechsels offen ist, die Diastematik aber ansonsten deutlich scheint. Vgl. die abweichende Melodiefassung in der teiltextierten Aufzeichnung ((Pa 1118-135v-6)).</rend></td></tr></table></annot><annot startid="#m-6b7ab081-07f4-437e-be0a-e193d28636f4" endid="#m-4afe2d4b-738f-40b3-bb8b-d8db0efce91f"><table><tr><td><rend>((hympie))</rend></td><td><rend>]</rend></td><td><rend>lies ((impie))</rend></td></tr></table></annot><annot startid="#m-829b8158-e5de-4e13-862b-364c4f6bc1c9" endid="#m-4afe2d4b-738f-40b3-bb8b-d8db0efce91f" corresp="#m-comment-15"><table><tr><td><ptr target="#m-comment-15-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation ungenau, dem Eindruck nach:</rend></td><td><ptr target="#m-comment-15-notes-1"/></td><td><rend>(alles Folgende eine Stufe höher), die Edition orientiert sich an ((Pa 1138-76-7)) und der teiltextierten Aufzeichnung ((Pa 1118-135v-6)).</rend></td></tr></table></annot><annot startid="#m-325fbe7f-c88b-40fd-b57d-95ab080c1b0d" endid="#m-a2393ff0-9aa5-4ab8-8eca-979d07bc703e" type="emendation" corresp="#m-comment-16"><table><tr><td><ptr target="#m-comment-16-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-16-notes-1"/></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-16-notes-2"/></td></tr></table></annot><annot startid="#m-006f4b4c-e539-4a47-81cd-7ea5aaadf4f7" endid="#m-f243ee64-3a4a-42ad-aaad-ef998fa1c8b4"><table><tr><td><rend>((nexorum))</rend></td><td><rend>]</rend></td><td><rend>unklare Korrektur, möglicherweise aus ((nexuum)).</rend></td></tr></table></annot><annot startid="#m-52fe469a-9eeb-4d84-aa66-b4993dfb4ccb" endid="#m-bd187af1-13b5-4314-a1ab-405f15dc82fa" type="emendation"><table><tr><td><rend>((digna rependens)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((dignare pendens))</rend></td></tr></table></annot><annot startid="#m-537b7782-3521-40a9-84f4-808a77e18fa0" endid="#m-537b7782-3521-40a9-84f4-808a77e18fa0"><table><tr><td><rend>((hes))</rend></td><td><rend>]</rend></td><td><rend>lies ((es))</rend></td></tr></table></annot><annot startid="#m-b4fd506c-7fc6-4413-a34b-d67400aea71e" endid="#m-b4fd506c-7fc6-4413-a34b-d67400aea71e"><table><tr><td><rend>((qua))</rend></td><td><rend>]</rend></td><td><rend>über der Zeile zugefügt, regulär notiert.</rend></td></tr></table></annot><annot startid="#m-78b74be0-1973-47d5-8d72-52b315915fcc" endid="#m-d7dc8cda-86f6-452e-b873-9c94186e8d81" type="emendation"><table><tr><td><rend>((illa)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((illi))</rend></td></tr></table></annot><annot startid="#m-4ce479ae-3267-47c3-a119-ed55a235a407" endid="#m-c0e6298d-c0de-41d9-a319-af1b0b44031b"><table><tr><td><rend>((-num suscipe benignus |))</rend></td><td><rend>]</rend></td><td><rend>Notation korrigiert, vermutlich nur Verdeutlichung.</rend></td></tr></table></annot><annot startid="#m-7d1b7dbb-36a6-42a9-9e20-e1ad41e2dea4" endid="#m-cb3d1e6d-52e1-4044-9f71-c7e24dd79f14"><table><tr><td><rend>((nunc fraus))</rend></td><td><rend>]</rend></td><td><rend>Text möglicherweise auf Rasur.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1118"><bibl><identifier type="siglum">Pa 1118</identifier></bibl></sour