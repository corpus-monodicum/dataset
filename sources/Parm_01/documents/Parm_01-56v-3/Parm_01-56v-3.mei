><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Parm 01-56v-3</identifier><title>Hodie spiritus sanctus procedens</title><incip><incipText><p>Hodie spiritus sanctus procedens</p></incipText></incip><contents><contentItem><locus from="56v">f. 56v, l. 3</locus></contentItem></contents><biblList><bibl>Pent intr 78 A B C D 89 A 90 B 91 C E (CT III)</bibl><bibl type="printed-edition">II-4</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Introitus-Tropus</term><term type="feast">Pentecoste</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Bezugsgesang">Spiritus</term><term type="Endseite">58v</term><term type="Endzeile">4</term><term type="FestUndGattung">Pent intr</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Parm 01</identifier><titleStmt><title>Parm 01</title></titleStmt><creation><geogName role="origin">Parma</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><corpName role="origin-institution">Kathedrale</corpName><date>14. Jh – 15. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale mit Tropen (Temporale, Sommerteil)</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. F 01</identifier><physLoc><repository><geogName role="settlement">Parma</geogName><corpName>Archivio della Fabbriceria</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGr