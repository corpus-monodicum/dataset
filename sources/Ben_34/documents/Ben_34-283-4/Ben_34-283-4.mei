<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Ben 34-283-4</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/50558ddf-4426-4e14-826e-b41b294761ea</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-fa361ec6-bdbb-48ef-8a75-94268e62bc66" endid="#m-fd17087f-8327-4f85-9b8b-63a37bb072c8" type="emendation"><table><tr><td><rend>((maris)) (wie ((CT VII)))</rend></td><td><rend>]</rend></td><td><rend>((mare))</rend></td></tr></table></annot><annot startid="#m-7d793c7a-00a8-45c6-9a13-db37d4538404" endid="#m-6c7165ec-28b8-4c16-aeb2-c96275849556" type="emendation"><table><tr><td><rend>((terre)) (wie To 18)</rend></td><td><rend>]</rend></td><td><rend>((tellus)). Die Lesart des ((CT VII, telluris)), ist aufgrund der Notation nicht möglich.</rend></td></tr></table></annot><annot startid="#m-fb1334f0-a478-43ab-9002-5601f304d73a" endid="#m-6907b8a6-bf8c-4774-9b66-35d529a7754e"><table><tr><td><rend>[[-na]]</rend></td><td><rend>]</rend></td><td><rend>Das Zeichen für den zweiten Ton des Melismas ist durch eine Falte verdeckt. Seine Existenz ist aus der Form des vorangehenden Zeichens erschließbar, seine Tonhöhe nicht. Er ist hier nach der folgenden Prosula rekonstruiert.</rend></td></tr></table></annot><annot startid="#m-09bd41c5-408b-4d70-9fd7-545036c8a88f" endid="#m-383bbc8f-65a3-4e17-81dd-b3ad55b79e86"><table><tr><td><rend>((dona celestes))</rend></td><td><rend>]</rend></td><td><rend>grammatikalisch plausibler: ((donis celestibus)) oder ((dona celestia)), die Notation verhindert eine Emendation. (((CT VII)) emendiert zu ((dona celestis)), was die Grammatik nur wenig besser macht.)</rend></td></tr></table></annot><annot startid="#m-d1c38f99-81b0-4a1f-82f0-ab410566f4b5" endid="#m-37ddde9c-19e3-4873-822d-49596d2e43c5"><table><tr><td><rend>[[ter&lt;ra&gt;]]</rend></td><td><rend>]</rend></td><td><rend>Textverlust durch Loch im Pergament.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ben-34"><bibl><identifier type="siglum">Ben 34</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ben 34-283-4</identifier><title>Altissimeque rector</title><incip><incipText><p>Altissimeque rector</p></incipText></incip><contents><contentItem><locus from="283">f. 283, l. 4</locus></contentItem></contents><biblList><bibl>CT VII, 5: A1 A2 A3 A4 B1+B5+B6 C D</bibl></biblList><classification><termList><term type="genre">Sanctus</term><term type="genre">tropiert</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">283v</term><term type="Endzeile">4</term><term type="Melodiennummer_Katalog">Thannabaur 92</term><term type="Cantus_ID">509504</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ben 34</identifier><identifier type="cantus">Ben 34</identifier><titleStmt><title>Ben 34</title></titleStmt><creation><geogName role="origin">Benevent (Region)</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><date>12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale mit Tropen und Sequenzen, Kyriale</term></termList></classif