<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Lo 4-193v-6</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/92912f98-8113-43e7-a0bb-2001f86993ba</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Jasmin Hartmann-Strauß</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-99d88ed3-ad7a-4d2b-93d4-b14f6f5c6826" endid="#m-99d88ed3-ad7a-4d2b-93d4-b14f6f5c6826" corresp="#m-comment-0"><table><tr><td><ptr target="#m-comment-0-notes-0"/></td><td><rend>]</rend></td><td><rend>mi-Zeichen.</rend></td></tr></table></annot><annot startid="#m-e7307aa2-8c5b-4eb8-a7b1-b19bcfc469c9" endid="#m-e7307aa2-8c5b-4eb8-a7b1-b19bcfc469c9" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><rend>mi-Zeichen.</rend></td></tr></table></annot><annot startid="#m-77b40744-2394-4c7c-a303-787c6c9edc11" endid="#m-77b40744-2394-4c7c-a303-787c6c9edc11" corresp="#m-comment-2"><table><tr><td><ptr target="#m-comment-2-notes-0"/></td><td><rend>]</rend></td><td><rend>mi-Zeichen.</rend></td></tr></table></annot><annot startid="#m-a4687ff3-4e7d-49f8-9e45-9cc75edb355b" endid="#m-a4687ff3-4e7d-49f8-9e45-9cc75edb355b" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>mi-Zeichen.</rend></td></tr></table></annot><annot startid="#m-244bbea5-c307-4407-84b4-1f4412f70206" endid="#m-244bbea5-c307-4407-84b4-1f4412f70206" corresp="#m-comment-4"><tabl