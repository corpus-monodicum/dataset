5b34ef18"><table><tr><td><rend>((uos))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((nos)) (wie ((Apt 18)) und ((AH))).</rend></td></tr></table></annot><annot startid="#m-6030ecd4-1d75-46af-ac5e-2fa7932a04b3" endid="#m-6030ecd4-1d75-46af-ac5e-2fa7932a04b3" type="emendation"><table><tr><td><rend>((a)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((ad))</rend></td></tr></table></annot><annot startid="#m-526c06b8-6ada-45a4-80d9-338f6e1bd360" endid="#m-42234b1d-8dfe-4c2b-8525-fe2405dcbbd4"><table><tr><td><rend>((adorant))</rend></td><td><rend>]</rend></td><td><rend>danach ist offenbar Text ausgefallen, der nach ((Apt 18)) ergänzt werden kann: ((cuncta (Apt 18: cunctis) tribus et lingua / Set surgens adque leta / Gloria in excelsis deo / &lt;E&gt;t in terra pax hominibus / Psallentes (Apt 18: -is) in iubilo / Rex angelorum archangelorum et ordinum)). Anlass für den Textausfall war möglicherweise ein Sprung von ((cuncta)) (5) zu ((cunctum)) (9b).</rend></td></tr></table></annot><annot startid="#m-1f5aace1-04cc-489c-98e1-0ba1911cdfbd" endid="#m-0dacb7b3-61c4-4e30-add4-5272dc6c7e0b"><table><tr><td><rend>((&lt;O&gt;uantes))</rend></td><td><rend>]</rend></td><td><rend>Initiale nicht ausgeführt.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Aufzeichnung ohne Notation, auch die Parallelaufzeichnung in ((Apt 18)) o.N. Die zugehörige Sequenzmelodie ist offenbar ((Cignea)); ergänzt man den Text nach ((Apt 18)), so passt er mit Ausnahme von Strophe 12-13 nahezu problemlos auf die Melodie ((Pa 1118-134v-3)).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1118"><bibl><identifier type="siglum">Pa 1118</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1118-164v-6</identifier><title>Gaudeamus in hac die</title><incip><incipText><p>Gaudeamus in hac die</p></incipText></incip><contents><contentItem><locus from="164v">f. 164v, l. 6</locus></contentItem></contents><biblList><bibl>AH 53, 26</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Octava nativitatis</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">165</term><term type="Endzeile">7</term><term type="Melodie_Standard">Cignea</term><term type="Zusatz_zu_Textinitium">Ohne Notation</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1118</identifier><titleStmt><title>Pa 1118</title></titleStmt><creation><geogName role="origin">Tavèrnoles (möglicherweise)</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Sant Sadurní</corpName><date>10. Jh. 4. Viertel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 1118</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-105b9648-7151-42ff-9d2e-5fd187a560b4"><section xml:id="m-f765d90d-04a4-4cc4-82bb-12b65fecbe3d"/><section xml:id="m-6d5f6426-fcc5-4ec6-bdcc-d1aed54d48ad"/><section xml:id="m-0cbdc2ef-88d6-4be3-adb5-4dab87cc8b8c" label="1"><section xml:id="m-d11a2adc-4e73-45a6-97f4-4d166562fd16"><sb xml:id="m-b19a969f-d849-46f9-9c56-2d65a93aec8f"/><staff n="