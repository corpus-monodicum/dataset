<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Int 5-67-3</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/dd10d1e3-33b7-440a-b643-0f0dfe0235b4</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Text revision (Tropen)</resp><persName>Gunilla Iversen</persName></respStmt><respStmt><resp>Text revision (Tropen)</resp><persName>Ritva Maria Jacobsson</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-bc98b78f-cbd8-4c01-b3b9-163ee531d97b" endid="#m-37df4651-4c40-496a-8f15-09879dacebf9"><table><tr><td><rend>[[Viri ... celum]]</rend></td><td><rend>]</rend></td><td><rend>doppelte Schlüsselung mit F- und c-Schlüssel. Der c-Schlüssel entspricht der Färbung der Linien und ist vermutlich als Korrektur zugesetzt. Die Edition folgt dem c-Schlüssel, im anderen Fall wäre dieser Abschnitt eine Quinte tiefer zu lesen. Das hinter dieser Korrektur stehende Problem ist der Anschluss zwischen dem Einleitungselement im 1. Ton und der Antiphon im 7. Ton; vermutlich ist gemeint, dass das Einleitungselement eine Quinte höher bzw. die Antiphon eine Quinte tiefer zu singen ist als notiert.</rend></td></tr></table></annot><annot startid="#m-c6122ba9-14b0-40de-b482-3d71b967113e" endid="#m-3ddc97c5-640f-42ee-a259-60e2e60ee2c3"><table><tr><td><rend>((ei))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((eis)) (wie ((CT III))).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-int-5"><bibl><identifier type="siglum">Int 5</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Int 5-67-3</identifier><title>Hodie redemptor</title><incip><incipText><p>Hodie redemptor</p></incipText></incip><contents><contentItem><locus from="67">f. 67, l. 3</locus></contentItem></contents><biblList><bibl>Ascens intr 18 A (CT III)</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Introitus-Tropus</term><term type="feast">Ascensio domini</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">67v</term><term type="Endzeile">2</term><term type="FestUndGattung">Ascens intr</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Int 5</identifier><titleStmt><title>Int 5</title></titleStmt><creation><geogName role="origin">Novara (Region)</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><date>12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar, Prozessionar</term></termList></classification><itemList><item><identifier type="shelfmark">5 (14)</identifier><physLoc><repository><geogName role="settlement">Intra</geogName><corpName>Archivio Parrocchiale di San Vittore</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-bcc3d0a8-ddda-44f4-b441-95e3c9789b55"><section xml:id="m-5dde9305-c833-47a2-9ee5-d9886ced4596"/><section xml:id="m-01955b1e-7231-4