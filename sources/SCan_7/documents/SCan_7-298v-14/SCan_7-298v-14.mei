us</term><term type="genre">Introitus-Tropus</term><term type="feast">Omnes sancti</term><term type="feast">Messe</term><term type="Editor">Isabel Kraft</term><term type="Bezugsgesang">Gaudeamus</term><term type="Endseite">299</term><term type="Endzeile">2</term><term type="FestUndGattung">Gaudeamus intr</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">SCan 7</identifier><titleStmt><title>SCan 7</title></titleStmt><creation><geogName role="origin">Innichen (San Candido)</geogName><geogName role="origin-region">Quellen deutscher Herkunft</geogName><corpName role="origin-institution">Kollegiatstift</corpName><date>15. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale mit Tropen, Kyriale mit Tropen, Sequentiar, Tropar</term></termList></classification><itemList><item><identifier type="shelfmark">VII a 7</identifier><physLoc><repository><geogName role="settlement">Innichen (San Candido)</geogName><corpName>Bibliothek des Kollegiatstiftes</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-f75f3a3c-dff8-4ac5-b6a0-1ff61d297db4"><section xml:id="m-3546aa61-cc82-4247-bb9d-cbbee491fd51"/><section xml:id="m-241be025-a931-43f1-b4b4-df3758e76e92" label="1" type="Tropenelement"><sb xml:id="m-826e1f21-0a8f-431f-ab72-0d36a053a519"/><staff n="1"><layer n="1"><annot xml:id="m-f7257c02-cdc1-4ff2-8cef-5ef4b0c5cae8" type="paratext" label="Festtag">IN DIE OMNIUM SANCTORUM (f. 298v)</annot><syllable xml:id="m-c8a8e27e-04c5-48f1-bf27-0d6a03a357a3"><syl wordpos