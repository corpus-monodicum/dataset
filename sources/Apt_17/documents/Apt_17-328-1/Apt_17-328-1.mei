otation ohne Text ist nicht erkennbar, ob hier Noten fehlen oder ein kürzerer Text zugrunde liegt.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((1:)) Hexameter.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-apt-17"><bibl><identifier type="siglum">Apt 17</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Apt 17-328-1</identifier><title>Fert evangelium</title><incip><incipText><p>Fert evangelium</p></incipText></incip><contents><contentItem><locus from="328">f. 328, l. 1</locus></contentItem></contents><biblList><bibl>Beati mundo com 1 A (CT X)</bibl><bibl type="printed-edition">II-3</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Communio-Tropus</term><term type="feast">Omnes sancti</term><term type="feast">Messe</term><term type="Editor">David Catalunya</term><term type="Bezugsgesang">(Beati mundo)</term><term type="Endseite">328</term><term type="Endzeile">3</term><term type="FestUndGattung">Beati mundo com</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Apt 17</identifier><identifier type="cantus">F-APT 17</identifier><titleStmt><title>Apt 17</title></titleStmt><creation><geogName role="origin">Apt</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><date>11. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Prosar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 17</identifier><physLoc><repository><geogName role="settlement">Apt</geogName><corpName>Archive Basilique de Sainte Anne</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><