-353542569ee7" endid="#m-e9a2c910-7c21-4677-88d4-4e726ce0fc6e"><table><tr><td><rend>((matheriae))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((matheria))</rend></td></tr></table></annot><annot startid="#m-1d856293-8d92-4f53-9c50-8bd20f902f6d" endid="#m-8b3ada80-d779-427d-8ec2-948f0b5d1fd3"><table><tr><td><rend>((haustus))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((austus))</rend></td></tr></table></annot><annot startid="#m-92667586-08f7-4062-8d34-bcb8503b7953" endid="#m-7bc60da2-8866-4980-b90a-96fca89af210"><table><tr><td><rend>((sui))</rend></td><td><rend>]</rend></td><td><rend>korrigiert, vermutlich aus ((suo))</rend></td></tr></table></annot><annot startid="#m-70f24b1b-f369-48ef-9dcd-ac0eb2480ad2" endid="#m-70f24b1b-f369-48ef-9dcd-ac0eb2480ad2" type="emendation"><table><tr><td><rend>((temet)) (wie ((CT I)))</rend></td><td><rend>]</rend></td><td><rend>((tenet))</rend></td></tr></table></annot><annot startid="#m-e6473dbc-cd61-448e-9aa8-21817c6b1609" endid="#m-e6473dbc-cd61-448e-9aa8-21817c6b1609"><table><tr><td><rend>((Qui)) (wie ((CT I)))</rend></td><td><rend>]</rend></td><td><rend>((Cui)))</rend></td></tr></table></annot><annot startid="#m-9cff4657-2095-4fd1-a60f-ab3c52d1b45c" endid="#m-9cff4657-2095-4fd1-a60f-ab3c52d1b45c" type="emendation"><table><tr><td><rend>((aquam)) (wie ((CT I)))</rend></td><td><rend>]</rend></td><td><rend>((aqua))</rend></td></tr></table></annot><annot startid="#m-68e4880a-341a-4063-a98e-5167e52c5a02" endid="#m-68e4880a-341a-4063-a98e-5167e52c5a02"><table><tr><td><rend>((uino))</rend></td><td><rend>]</rend></td><td><rend>grammatikalisch plausibler: ((uinum)) (wie ((CT I))).</rend></td></tr></table></annot><annot startid="#m-286d1249-84d3-43dc-94d9-ad67da6f134e" endid="#m-eb2ddf12-9f71-43c5-acf3-3e149eb38945" type="emendation" corresp="#m-comment-10"><table><tr><td><ptr target="#m-comment-10-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-10-notes-1"/></td><td><rend>(alles Folgende eine Stufe tiefer) (falscher Kustos).</rend></td></tr></table></annot><annot startid="#m-f59d53ea-7f1d-4a5c-ae36-16a027c5737d" endid="#m-0ac9c75b-519b-4d22-9ae9-481a1e4af042"><table><tr><td><rend>((†Quem deuote magos sidus apparuit nomen†))</rend></td><td><rend>]</rend></td><td><rend>Der unverständliche Text wurde von Blume (((AH 49, 75))) emendiert: ((Quem devote magis sidus aperuit novum)) (vgl. den Kommentar ((CT I,)) S. 266). ((nouum)) scheint tatsächlich die älteste überlieferte Lesart zu sein (((Pa 1084, Pa 1118, Apt 17-88-4))), die dann in St. Martial zu ((nouus)) (((Pa 1120))) und nomen (((Pa 909)) und ((Pa 1119))) wurde. ((magis)) findet sich nur in ((Apt 17)), wo es als sekundäre Emendation gelten muss; ((aperuit)) ist nicht belegt.</rend></td></tr></table></annot><annot startid="#m-cefe07d3-dab4-4f8a-9f35-bd3820295fac" endid="#m-99e1bdd6-7558-4d28-84ee-658f7d11d0e0"><table><tr><td><rend>((†Cuius uentilabrum dextram gestas purgabit tunc nostrum†))</rend></td><td><rend>]</rend></td><td><rend>Der unverständliche Text wurde von Blume (((AH 49, 75))) emendiert: ((Cuius ventilabrum dextra purgabit cor nostrum)) (vgl. den Kommentar ((CT I,)) S. 257). ((gestas)) ist wiederum eine Lesart der Martialeser Handschriften gegen das offenbar ältere ((gestans)) (((Pa 1984, Pa 1118, Apt 17))). ((destra)) findet sich nur in ((Apt 17)), wo es als sekundäre Emendation gelten muss; ((cor)) ist nicht belegt.</rend></td></tr></table></annot><annot startid="#m-19bbd3fb-03f6-4c93-9cd4-956d33c07efd" endid="#m-f6e2984c-fdd2-436f-9ace-3b83485bc621"><table><tr><td><rend>((mistica munera))</rend></td><td><rend>]</rend></td><td><rend>Der Akkusativ steht hier offenbar anstelle des Ablativs. Anders ((CT I,)) S. 266.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((74, 75:)) Hexameter.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-909"><bibl><identifier type="siglum">Pa 909</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 909-18-1</identifier><title>Haec est praeclara dies</title><incip><incipText><p>Haec est praeclara dies</p></incipText></incip><contents><contentItem><locus from="18">f. 18, l. 1</locus></contentItem></contents><biblList><bibl>Epiph intr 79 A 89 B 81 C 82 E F 63 A 64 C 65 D 15 A 17 B 18 C 19 D 76 A 95 C 96 D F 72 A 74 C 75 D 98 A 99 C 100 D 90 A 91 C 92 D 93 A 94 C 88 A 73 C (CT I)</bibl><bibl type="printed-edition">II-3</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Introitus-Tropus</term><term type="feast">Epiphania</term><term type="feast">Messe</term><term type="Editor">(unlisted editor)</term><term type="Bezugsgesang">Ecce advenit</term><term type="Endseite">19v</term><term type="Endzeile">9</term><term type="FestUndGattung">Epiph intr</term><term type="Zusatz_zu_Textinitium">10 Tropenelemente ohne Notation</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 909</identifier><identifier type="cantus">Pa 909</identifier><titleStmt><title>Pa 909</title></titleStmt><creation><geogName role="origin">Limoges</geogName><geogName role="origin-region">Quellen französischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Martial, möglicherweise für Saint-Martin</corpName><date>11. Jh 1. Drittel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Mess- und Offiziumsgesänge, Sequentiar, Prosen, Prozessionar, Offertoriale, Tonar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 909</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList><relationList><re