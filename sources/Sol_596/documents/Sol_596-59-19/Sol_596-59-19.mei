<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Sol 596-59-19</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/c19ecc43-1ef3-437d-8753-2c5c07b3a01c</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Spiele)</resp><persName>Elaine Stratton Hild</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-493ff697-1a71-4f08-a129-b23236fa7848" endid="#m-e53e9453-f00b-42f6-8ebf-a5a1a90ae4f3" corresp="#m-comment-0"><table><tr><td><ptr target="#m-comment-0-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-0-notes-1"/></td></tr></table></annot><annot startid="#m-5a7eb21b-1c77-4540-8d2e-c9f80c56a49c" endid="#m-8415f021-fac2-4f18-8142-949e9092f88f" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><rend>Rasur zwischen 2. und 3. Note.</rend></td></tr></table></annot><annot startid="#m-f214cb55-008a-425b-aeb6-6eae0adbda7e" endid="#m-54601824-fbbf-433b-84e2-9c7b534f5cab"><table><tr><td><rend>((erant))</rend></td><td><rend>]</rend></td><td><rend>lies ((errant))</rend></td></tr></table></annot><annot startid="#m-ab29506b-6322-41f5-bec4-6ebf9c906ac0" endid="#m-d58b7689-55e9-47fd-8abd-7f83f6090be1"><table><tr><td><rend>((mortuum))</rend></td><td><rend>]</rend></td><td><rend>Text korrigiert, die Korrektur ((mortuum)) auch am Rand.</rend></td></tr></table></annot><annot startid="#m-a702f4a9-d23f-4a32-9995-ca2e0079bde6" endid="#m-4389fc65-62d9-4e59-b7a6-c1d3abdc0294" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>Rasur zwischen 2. und 3. Note, vermutlich ging vor Korrektur auf der 2. Silbe eine Note voran.</rend></td></tr></table></annot><annot startid="#m-6ae116f4-4bae-4eb2-901d-5f5ccc25e08c" endid="#m-dc26f3d7-a40c-478c-a530-37337f895433"><table><tr><td><rend>((ab))</rend></td><td><rend>]</rend></td><td><rend>Buchstabe ((b)) korrigiert.</rend></td></tr></table></annot><annot startid="#m-e28990b5-d3cb-4819-a7c9-94640b4a48ca" endid="#m-a9bbcfd4-fc4d-415a-95fe-32dd926d5977" type="emendation"><table><tr><td><rend>((hostio)) (wie [[Rankin]])</rend></td><td><rend>]</rend></td><td><rend>((hostium)), lies ((ostio)).</rend></td></tr></table></annot><annot startid="#m-4bf31ba5-2096-4d5b-9f93-fde53e759b4f" endid="#m-6b0c06a8-786a-47e3-a164-8ff431e24c0b" corresp="#m-comment-7"><table><tr><td><ptr target="#m-comment-7-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation auf Rasur, möglicherweise korrigiert aus gleichlautender Lesart, da ein Schlüsselwechsel direkt vorangeht, der Bestandteil der Korrektur sein kann.</rend></td></tr></table></annot><annot startid="#m-32a42eda-6408-4090-b62a-d2d8e595fba0" endid="#m-32a42eda-6408-4090-b62a-d2d8e595fba0" corresp="#m-comment-8"><table><tr><td><ptr target="#m-comment-8-notes-0"/></td><td><rend>]</rend></td><td><rend>ein c-Schlüssel hebt den b-Schlüssel vom Beginn der Zeile auf, in der Edition wird das durch das Auflösungszeichen wiedergegeben.</rend></td></tr></table></annot><annot startid="#m-f0431baf-c617-4f8e-a31f-d1c8f9a57456" endid="#m-f0431baf-c617-4f8e-a31f-d1c8f9a57456" corresp="#m-comment-9"><table><tr><td><ptr target="#m-comment-9-notes-0"/></td><td><rend>]</rend></td><td><rend>ein c-Schlüssel hebt den b-Schlüssel vom Beginn der Zeile auf, in der Edition wird das durch das Auflösungszeichen wiedergegeben.</rend></td></tr></table></annot><annot startid="#m-c84f0e2f-7838-421a-85b2-fe53761450ed" endid="#m-c84f0e2f-7838-421a-85b2-fe53761450ed" corresp="#m-comment-10"><table><tr><td><ptr target="#m-comment-10-notes-0"/></td><td><rend>]</rend></td><td><rend>ein c-Schlüssel hebt den b-Schlüssel vom Beginn der Zeile auf, in der Edition wird das durch das Auflösungszeichen wiedergegeben.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((Den)), ab f. 60 ((Cle)).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-sol-596"><bibl><identifier type="siglum">Sol 596</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Sol 596-59-19</identifier><title>Heu nobis internas mentes</title><incip><incipText><p>Heu nobis internas mentes</p></incipText></incip><contents><contentItem><locus from="59">f. 59, l. 19</locus></contentItem></contents><biblList><bibl type="printed-edition">CM V-1</bibl></biblList><classification><termList><term type="genre">Spiele-Passus</term><term type="feast">Pascha</term><term type="feast">Matutin</term><term type="Editor">Elaine Stratton Hild</term><term type="Endseite">60v</term><term type="Referenz_auf_Spiel">Sol 596-59-19S</term><term type="Endzeile">4</term><term type="SpielName">Easter play / Osterspiel</term><term type="Band_Genre">Spiele</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Sol 596</identifier><titleStmt><title>Sol 596</title></titleStmt><creation><geogName role="origin">Wilton</geogName><geogName role="origin-region">Quellen englischer Herkunft</geogName><corpName role="origin-institution">Benediktinerinnenabtei St Edith</corpName><date>13. Jh Ende. Kopie um 1860)</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Prozessionar mit liturgischen Spielen</term></termList></classification><itemList><item><identifier type="shelfmark">Atelier de Pal. mus. No. 596</identifier><physLoc><repository><geogName role="settlement">Solesmes</geogName><corpName>Abbaye Saint-Pierre</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-75533ebd-bf1d-4f4b-9b8a-3fb909a278ab"><section xml:id="m-0bd1fb95-69c5-4746-938f-64c44ea26780"/><section xml:id="m-4a3e6193-c25d-45e2-91a4-edc7cae7c582"><section xml:id="m-ee238394-9e31-4807-afe6-5973f4887458"><section xml:id="m-dc01c42e-09f8-45eb-ac02-8371517b96d8"><sb xml:id="m-a05487a3-9544-4fd2-aa74-4c8fd2972f69"/><staff n="1"><layer n="1"><annot xml:id="m-7dc3dfcc-c25c-4b41-bc96-5c7cf7b9bb4b" type="paratext" label="Feier">DEINDE SONATUR MATUTINIS</annot><annot xml:id="m-79bb8844-d1dd-44e6-b7b3-b51b7e36bdb9" type="paratext" label="Aufführung">ET DICANTUR FESTIUE 
DUM CANTATUR III LECTIO EXEANT TRES CANTRICES ET LAUENT MANUS SUAS 
ET ABSCONSO UELAMINE CANDIDUM UELUM CAPITIBUS SUIS INPONANT IN SIMILITUDINE MULIERUM 
DUMQUE TERTIUM RESPONSORIUM REPETATUR 
UNUS SACERDOS AMICTU INDUTUS ET ALBA SEPULCHRI LOCUM ADEAT 
IBIQUE MANU TENTUS PALMAM QUIETUS SEDEAT IN SIMILTUDINE ANGELI 
 
</annot><annot xml:id="m-f91880cf-e6f6-4316-a3d8-ca23a9226f0f" type="paratext" label="Aufführung">ET TRES MARIAS ANTE HOSTIUM CHORI TRIA FILATERIA MANIBUS GESTANTES 
DUABUS CANDELABRA TURRIBULA CUM INCENSU ANTE EAS DEFERRENTIBUS 
QUERENTES ET LAMENTANTES HOC MODO
HIC TRES UNO ORE DICANT</annot><sb xml:id="m-902dcc8f-0e11-4c57-b3f3-312c2413bec2" type="manuscriptLine"/><syllable xml:id="m-cd8dbcf4-a961-425b-b1de-378f15ab38a5"><syl wordpos="s">Heu</syl><neume><nc xml:id="m-0a2b610e-8a8b-40cd-b646-4a13ecb9e7a1" pname="a" oct="4"/><nc xml:id="m-215b7846-1317-44a7-a553-59385e7c4fe2" pname="c" oct="5"/></neume><neume><nc xml:id="m-b9ff2f1a-b8b5-4c40-877f-abbbfe3901d1" pname="d" oct="5"/><nc xml:id="m-bf9d7123-89f7-4f7b-8ac0-672476677625" pname="c" oct="5" con="g"/><nc xml:id="m-39de41ec-02e3-465c-b98d-b7ad0d6e9d0d" pname="b" oct="4" con="g"/><nc xml:id="m-e35a97d7-4e8a-4be9-97d9-640876a66837" pname="c" oct="5" con="g"/></neume></syllable><syllable xml:id="m-6d6104e6-0ba5-4d1c-89fc-8ed03528c9e1"><syl wordpos="i" con="d">no-</syl><neume><nc xml:id="m-04601232-c911-4583-b449-2ad21512b91d" pname="b" oct="4"/><nc xml:id="m-7d68b9aa-e33c-4b58-8313-7b630fcc94d1" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-aa836db5-1371-476e-ad44-e0ede0784291"><syl wordpos="t">bis</syl><neume><nc xml:id="m-edb1380d-9971-47a5-80e4-641ca58c0949" pname="c" oct="5"/><nc xml:id="m-f2f90447-0342-4420-bf30-be722502c5f0" pname="b" oct="4"/></neume><neume><nc xml:id="m-1f1092c4-834e-473e-a59a-50fbb1f699c6" pname="b" oct="4"/><nc xml:id="m-879407ee-f8a1-4600-8bcc-c33c70251816" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-d85746b5-3b92-4b71-8145-ac4ed997831f"><syl wordpos="i" con="d">in-</syl><neume><nc xml:id="m-0514a0c4-341e-44c3-8cef-4af0ad09db20" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-8d2903f6-4a5e-492f-b093-42147b6e8e47"><syl wordpos="m" con="d">ter-</syl><neume><nc xml:id="m-4c2af520-61ce-49b5-97c9-7a56719c8cea" pname="a" oct="4"/><nc xml:id="m-62f3985d-0f0f-4aad-9416-4909df3e9ba3" pname="b" oct="4"/><nc xml:id="m-678129a9-2815-4376-a94a-fe7595c0c987" pname="a" oct="4"><liquescent/></nc></neume></syllable><syllable xml:id="m-b3bf052f-533c-4663-a92e-39830fc1bf6d"><syl wordpos="t">nas</syl><neume><nc xml:id="m-7a40694