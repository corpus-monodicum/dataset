8bbd5" endid="#m-ce936552-9134-444a-b2d1-98f67f157c85" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>ungewöhnliche Graphie, vermutlich Selbstkorrektur des Notators.</rend></td></tr></table></annot><annot startid="#m-f47d2032-2422-47c1-9384-89af51dc9901" endid="#m-543235a7-3f8f-4002-bbd5-c4ccb07928b0"><table><tr><td><rend>((scandet))</rend></td><td><rend>]</rend></td><td><rend>formal und semantisch plausibler: ((candet)) (wie ((CT I))).</rend></td></tr></table></annot><annot startid="#m-f1699370-5bf5-4ee2-8de0-9d425b3a0c51" endid="#m-f1699370-5bf5-4ee2-8de0-9d425b3a0c51"><table><tr><td><rend>[[Magni]]</rend></td><td><rend>]</rend></td><td><rend>Auf f. 11 folgt nach einem Einleitungstropus zum Gloria das Tropenelement ((Natus est altissimi (Nat III intr 93))), hier aber als Einleitung zur Sequenz.</rend></td></tr></table></annot><annot startid="#m-9e228621-8837-4766-b931-8dc25c618b45" endid="#m-da613127-f1fb-40cb-88f1-4d329986c93f" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><rend>Diastematik nicht eindeutig, man könnte auch lesen:</rend></td><td><ptr target="#m-comment-6-notes-1"/></td><td><rend>(alles Folgende eine Stufe höher).</rend></td></tr></table></annot><annot startid="#m-fe3fce24-d567-4370-aac6-a6d36ae29485" endid="#m-acc466e3-b481-4a28-82b0-b5fd07822db8"><table><tr><td><rend>((Christus dominus princeps))</rend></td><td><rend>]</rend></td><td><rend>Text durchgestrichen.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((53, 54, 55, 77:)) Hexameter (((55)) mit metrischen Fehlern, ((77)) ohne Beachtung der Quantitäten).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-909"><bibl><identifier type="siglum">Pa 909</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDe