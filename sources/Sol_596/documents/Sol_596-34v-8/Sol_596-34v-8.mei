<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Sol 596-34v-8</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/26d445fd-1929-464c-94c6-9b2b3fd91eb7</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Spiele)</resp><persName>Elaine Stratton Hild</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-0e5983e8-2004-4127-90cc-b217107e4545" endid="#m-60c15375-4558-4a14-89db-69131b20e258" corresp="#m-comment-0"><table><tr><td><ptr target="#m-comment-0-notes-0"/></td><td><rend>]</rend></td><td><rend>die 5. Note hat einen Hals rechts abwärts, das ist im Editionskorpus singulär.</rend></td></tr></table></annot><annot startid="#m-a889d756-58be-4e59-9adc-6bb8b31dbae7" endid="#m-89325dd7-21a3-4abc-ad4b-9bc918238771" type="emendation" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-1-notes-1"/></td><td><rend>(folgt Schlüsselwechsel), emendiert nach dem modalen Zusammenhang.</rend></td></tr></table></annot><annot startid="#m-daf15104-8e0c-43e3-a115-5dc578f190e8" endid="#m-daf15104-8e0c-43e3-a115-5dc578f190e8" corresp="#m-comment-2"><table><tr><td><ptr target="#m-comment-2-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation auf Rasur.</rend></td></tr></table></annot><annot startid="#m-08385c33-fbf1-48c5-8aba-904aae927ee1" endid="#m-3c4b064e-029b-4cdd-8014-6029e38f68da" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>Rasur nach der letzten Note.</rend></td></tr></table></annot><annot startid="#m-c1dba988-037f-4a4d-950a-d239cd64d043" endid="#m-c1dba988-037f-4a4d-950a-d239cd64d043" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>ein c-Schlüssel hebt den b-Schlüssel vom Beginn der Zeile auf, in der Edition wird das durch das Auflösungszeichen wiedergegeben.</rend></td></tr></table></annot><annot startid="#m-80b8a6fb-156e-4d7f-8714-702c0257d65a" endid="#m-2aae41ae-3309-4f34-893b-2f82d7058ddf" corresp="#m-comment-5"><table><tr><td><ptr target="#m-comment-5-notes-0"/></td><td><rend>]</rend></td><td><rend>gerundete From der 17. Note im Editionskorpus singulär, möglicherweise Ergebnis einer Korrektur.</rend></td></tr></table></annot><annot startid="#m-ae115eb2-0efb-47f3-9c0e-cf86eba1071a" endid="#m-5d742a99-19e8-4fe8-ab73-5648c33371e0" type="emendation" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>(wie oben)</rend></td><td><rend>]</rend></td><td><rend>Notation mit zwei Schlüsseln (c3 und c4) übereinander:</rend></td><td><ptr target="#m-comment-6-notes-1"/></td><td><ptr target="#m-comment-6-notes-2"/></td><td><rend>, gemeint ist möglicherweise:</rend></td><td><ptr target="#m-comment-6-notes-3"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((Sol 596)).</rend></td></tr><tr><td><rend>Die Aufzeichnung enthält ein tonartliches Problem. Sie beginnt im 2. Ton auf Finalis ((G)) und rückt dann innerhalb des Melismas auf ((gentes)) auf Finalis ((a)). Dieses Melisma enthält mit ((b-e)) einen unwahrscheinlichen Tritonus-Sprung, lässt sich aber im Rahmen dieser Edition nicht sinnvoll emendieren.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-sol-596"><bibl><identifier type="siglum">Sol 596</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Sol 596-34v-8</identifier><title>Collegerunt pontifices</title><incip><incipText><p>Collegerunt pontifices</p></incipText></incip><contents><contentItem><locus from="34v">f. 34v, l. 8</locus></contentItem></contents><biblList><bibl>CAO 1852</bibl><bibl type="printed-edition">CM V-1</bibl></biblList><classification><termList><term type="genre">Spiele-Passus</term><term type="genre">Antiphon</term><term type="feast">Dominica in palmis</term><term type="feast">Prozession</term><term type="Editor">Elaine Stratton Hild</term><term type="Endseite">35v</term><term type="Referenz_auf_Spiel">Sol 596-27-7S</term><term type="Endzeile">2</term><term type="SpielName">Entry into Jerusalem</term><term type="Band_Genre">Spiele</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Sol 596</identifier><titleStmt><title>Sol 596</title></titleStmt><creation><geogName role="origin">Wilton</geogName><geogName role="origin-region">Quellen englischer Herkunft</geogName><corpName role="origin-institution">Benediktinerinnenabtei St Edith</corpName><date>13. Jh Ende. Kopie um 1860)</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Prozessionar mit liturgischen Spielen</term></termList></classification><itemList><item><identifier type="shelfmark">Atelier de Pal. mus. No. 596</identifier><physLoc><repository><geogName role="settlement">Solesmes</geogName><corpName>Abbaye Saint-Pierre</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-eeb59f5f-6429-4b88-8f2a-8876efa7d8ae"><secti