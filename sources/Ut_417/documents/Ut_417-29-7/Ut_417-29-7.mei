a12" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-3-notes-1"/></td><td><rend>, Lesart nach Korrektur nicht völlig klar.</rend></td></tr></table></annot><annot startid="#m-43b5c7ac-7fa2-4133-8af1-e37ddd7cd515" endid="#m-4bfb9b23-3684-431f-82d6-b289891250e9" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-4-notes-1"/></td></tr></table></annot><annot startid="#m-0c7696ac-cc21-4dd4-81ff-c2100dda15e2" endid="#m-44e455af-597d-4423-96a2-d0c6411d51f6" corresp="#m-comment-5"><table><tr><td><ptr target="#m-comment-5-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert zu</rend></td><td><ptr target="#m-comment-5-notes-1"/></td></tr></table></annot><annot startid="#m-e950cadf-8a5f-49dd-8275-a2c2d272b7cd" endid="#m-3db0b7f2-3940-4850-bfe9-bfa49d7c5b04" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert zu</rend></td><td><ptr target="#m-comment-6-notes-1"/></td></tr></table></annot><annot startid="#m-462d22d6-cd44-4a23-9168-ec46f3654a94" endid="#m-5f15f254-ddde-42de-aa95-24704324591c" corresp="#m-comment-7"><table><tr><td><ptr target="#m-comment-7-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-7-notes-1"/></td><td><rend>(Rasur über der 1. Silbe, Zufügung eines Halses zur letzten Note).</rend></td></tr></table></annot><annot startid="#m-8527c30f-7c81-4cf4-9cbb-e07bc82bf74b" endid="#m-7a6d835e-65ff-4352-bf53-f919bf485545" corresp="#m-comment-8"><table><tr><td><ptr target="#m-comment-8-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-8-notes-1"/></td><td><rend>(Rasur über der 1. Silbe, Zufügung eines Halses zur letzten Note).</rend></td></tr></table></annot><annot startid="#m-f8f80929-3fe1-48bf-8a21-dfae598824dc" endid="#m-83338d12-dfed-4f97-a780-78b1b2d8552e" corresp="#m-comment-9"><table><tr><td><ptr target="#m-comment-9-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation von späterer Hand durchgestrichen. Ob die letzte Note als Note oder als graphische Verzierung gemeint ist, bleibt unklar.</rend></td></tr></table></annot><annot startid="#m-48c15d9f-660c-49f7-aefd-fa8f4ba41584" endid="#m-5aaf73cb-b3a6-40f8-b91a-dcf119283c86" corresp="#m-comment-10"><table><tr><td><ptr target="#m-comment-10-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-10-notes-1"/></td><td><rend>(Rasur über der 1. Silbe, Zufügung einer Note am Ende).</rend></td></tr></table></annot><annot startid="#m-eada0afd-8a4d-4b74-be6e-b221088f1076" endid="#m-98af5c48-b6c5-4460-b77a-7614ef41fd9d" corresp="#m-comment-11"><table><tr><td><ptr target="#m-comment-11-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-11-notes-1"/></td><td><rend>(Rasur über der 1. Silbe, Zufügung eines Halses zur letzten Note). </rend></td></tr></table></annot><annot startid="#m-79c58702-7bf7-4771-98ea-508a9587dcee" endid="#m-79c58702-7bf7-4771-98ea-508a9587dcee" corresp="#m-comment-12"><table><tr><td><ptr target="#m-comment-12-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-12-notes-1"/></td></tr></table></annot><annot startid="#m-e5d2b243-8c9a-4bd1-8504-bbfb97f6d3dd" endid="#m-e5d2b243-8c9a-4bd1-8504-bbfb97f6d3dd" corresp="#m-comment-13"><table><tr><td><ptr target="#m-comment-13-notes-0"/></td><td><rend>]</rend></td><td><rend>von späterer Hand korrigiert zu</rend></td><td><ptr target="#m-comment-13-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Die Melodiekorrekturen von späterer Hand sind nicht konsequent durchgeführt, daher wird die Lesart vor Korrektur ediert. Die Korrekturen in den a-Strophen wären sinngemäß in die b-Strophen zu übertragen.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ut-417"><bibl><identifier type="siglum">Ut 417</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ut 417-29-7</identifier><title>O beata beatorum martyrum</title><incip><incipText><p>O beata beatorum martyrum</p></incipText></incip><contents><contentItem><locus from="29">f. 29, l. 7</locus></contentItem></contents><biblList><bibl>AH 55, 14</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Victor Xantensis</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">29v</term><term type="Endzeile">3</term><term type="Melodie_Standard">–</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ut 417</identifier><titleStmt><title>Ut 417</title></titleStmt><creation><geogName role="origin">Utrecht</geogName><geogName role="origin-region">Quellen deutscher Herkunft</geogName><corpName role="origin-institution">Stift Sankt Marien</corpName><date>13. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Sequentiar, Tropar, Kyriale mit Tropen</term></termList></classification><itemList><item><identifier type="shelfmark">417</identifier><physLoc><repository><geogName role="settlement">Utrecht</geogName><corpName>Universiteitsbibliotheek</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><