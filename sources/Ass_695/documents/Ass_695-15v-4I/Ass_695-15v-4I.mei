<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Ass 695-15v-4I</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/3664e4b4-f1f1-422c-9ffd-a3ac08b25d9f</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Charles M. Atkinson</persName></respStmt><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>David Hiley</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">1. Dreistimmig.</annot><annot startid="#m-5d9d4b9b-eb49-41f5-baa0-5e98c79ffd4e" endid="#m-0ad93774-5b04-4a08-9196-215103554344" type="emendation"><table><tr><td><rend>((regis)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((regi))</rend></td></tr></table></annot><annot startid="#m-071f197e-280b-438e-9653-d4e21221631b" endid="#m-071f197e-280b-438e-9653-d4e21221631b" type="emendation"><table><tr><td><rend>[[Christeleyson]]</rend></td><td><rend>]</rend></td><td><rend>[[Xxpisteleyson]]</rend></td></tr></table></annot><annot startid="#m-1d8d7f57-985c-4b71-88c6-3c0f6700d2e7" endid="#m-1d8d7f57-985c-4b71-88c6-3c0f6700d2e7" type="emendation"><table><tr><td><rend>((Par)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((Pax))</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Untere Stimme zu ((Ass 695-15v-II und Ass 695-15v-III)). In der Handschrift in Partitur notiert (1 Textzeile unter 3 Notenzeilen), die Abschnitte des Primärgesangs haben in allen Stimmen leere Systeme.</rend></td></tr><tr><td><rend>Eine Partiturdarstellung ist in der Funktion "Versionen vergleichen" möglich.</rend></td></tr><tr><td><rend>Das Wort ((eleyson)) wird teils dreisilbig, teils viersilbig behandelt, die drei Stimmen weichen darin öfters voneinander ab. Daher wird ab 2A in allen Stimmen ((e-le-y-son)) ediert, die dritte Silbe bleibt gegebenenfalls leer.</rend></td></tr><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>x</rend></td><td><rend>a</rend></td><td><rend>b</rend></td><td><rend>y</rend></td><td><rend>b</rend></td><td><rend>c</rend></td><td><rend>y'</rend></td><td><rend>c'</rend></td></tr><tr><td><rend>1A</rend></td><td><rend>1B</rend></td><td><rend>1C</rend></td><td><rend>2A</rend></td><td><rend>2B</rend></td><td><rend>2C</rend></td><td><rend>3A</rend></td><td><rend>3B</rend></td><td><rend>3C 3D 3E</rend></td></tr></table></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ass-695"><bibl><identifier type="siglum">Ass 695</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ass 695-15v-4I</identifier><title>Summe rex sempiterne</title><incip><incipText><p>Summe rex sempiterne</p></incipText></incip><contents><contentItem><locus from="15v">f. 15v, l. 4</locus></contentItem></contents><biblList><bibl>AH 47, 28</bibl></biblList><classification><termList><term type="genre">Kyrie</term><term type="genre">tropiert</term><term type="feast">Messe</term><term type="Editor">Charles M. Atkinson</term><term type="Endseite">16v</term><term type="Startposition">I</term><term type="Endzeile">4</term><term type="Melodiennummer_Katalog">Melnicki 171</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ass 695</identifier><titleStmt><title>Ass 695</t