f8885e3", "base": "D", "octave": 4, "noteType": "Normal", "focus": false, "liquescent": false}]}]}]}}, {"uuid": "3efdcbe2-9b74-499d-8090-99f92c189dfd", "kind": "Syllable", "text": "bes", "syllableType": "Normal", "notes": {"spaced": [{"nonSpaced": [{"grouped": [{"uuid": "ea55d638-c1f0-4e28-a82e-20fc50f237b9", "base": "C", "octave": 4, "noteType": "Normal", "focus": false, "liquescent": false}, {"uuid": "ef062a29-6d63-418f-8e14-7f568943ef82", "base": "D", "octave": 4, "noteType": "Normal", "focus": true, "liquescent": false}]}]}]}}]}], "data": []}], "data": []}], "data": [{"name": "Verweis", "data": "CAO 7484"}]}], "documentType": "Level3", "globalComment": {"kind": "CommentTreeGrid", "id": "190c1cac-64c1-4a82-9156-f0cddef5afc4", "items": [[{"kind": "CommentTreeLeaf", "id": "0d0a2b38-940b-4c0a-ab23-7fe610f9ca5c", "content": {"kind": "Text", "content": "The Exhortatio virtutum and the Ordo virtutum include personages and themes that occur earlier in Scivias.\n\nFor example,\nScivias Book 2, Vision 7 describes the devil bound. \nIn the Exhortatio virtutum, virtues bind the devil in the chants Ligate ergo, O regina nostra, and Gaudete o socii. \nIn the Ordo virtutum, the chants O victoria que, O fortissimi, O dulcissima bellatrix, Ligate ergo, O regina nostra, and Gaudete o socii describe the same actions.\n\nScivias Book 1, Vision 4 presents a lament of a pilgrim soul struggling to resist the devil (Querela anime de via erroris)—the same drama that forms the primary subject of the Exhortatio virtutum and the Ordo virtutum. Both the EV and the OV include a lament of pilgrim souls, Querela animarum in carne positarum. \n\nPersonified virtues (the primary personages in the Exhortatio virtutum and the Ordo virtutum) appear earlier in Scivias in:\nBook 1, Vision 2, Section 33\nBook 3, Vision 3\nBook 3, Vision 4, Section 15\nBook 3, Vision 6\nBook 3, Vision 8 (with the first seven virtues corresponding to the order they appear in the Ordo virtutum)\nBook 3, Vision 9\nBook 3, Vision 10\nAmong these personified virtues, Humility takes a prominent role, as in the Exhortatio virtutum and the Ordo virtutum.\n"}}]]}}
