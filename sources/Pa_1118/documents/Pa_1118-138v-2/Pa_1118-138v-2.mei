<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 1118-138v-2</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/94fef426-b682-49ed-ba5c-84b5aa12c042</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Melodiename in Pa 1084 und bei Notker!</annot><annot type="global-comment"><table><tr><td><rend>Eine Parallelaufzeichnung findet sich in ((Pa 1084)), f. 215v. Eine aquitanische Textierung ist bislang nicht identifiziert, die Melodie ist aber offenkundig identisch mit der von Notkers ((Tu civium deus)), die ansonsten nur adiastematisch überliefert ist. Die Gliederung folgt Notkers Text, vgl. aber den eventuell zuordenbaren Text ((Orbis redemptor, Pa 1118-203v-7)).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1118"><bibl><identifier type="siglum">Pa 1118</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1118-138v-2</identifier><title>Alleluia</title><incip><incipText><p>Alleluia</p></incipText></incip><contents><contentItem><locus from="138v">f. 138v, l. 2</locus></contentItem></contents><classification><termList><term type="genre">Sequenz</term><term type="genre">Textlos</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">138v</term><term type="Endzeile">3</term><term type="Melodie_Standard">Adorabo</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1118</identifier><identifier type="cantus">Pa 1118</identifier><titleStmt><title>Pa 1118</title></titleStmt><creation><geogName role="origin">Tavèrnoles (möglicherweise)</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Sant Sadurní</corpName><date>10. Jh. 4. Viertel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 1118</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList><relationList><relation rel="hasReproduction" target="https://gallica.bnf.fr/iiif/ark:/12148/btv1b8432314k/manifest.json" label="IIIF manifest"/></relationList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-105b9648-7151-42ff-9d2e-5fd187a560b4"><section xml:id="m-0cbdc2ef-88d6-4be3-adb5-4dab87cc8b8c" label="1"><section xml:id="m-d11a2adc-4e73-45a6-97f4-4d166562fd16"><sb xml:id="m-b19a969f-d849-46f9-9c56-2d65a93aec8f"/><staff n="1"><layer n="1"><syllable xml:id="m-c79a4fb5-1084-47ba-960b-a3177782b28f"><syl wordpos="i" con="d">Al-</syl><neume><nc xml:id="m-c12e5a8a-0919-4a57-becc-f8ff18b464a5" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-80bc3d6f-3b3e-4715-a4d2-f2dddcfb1d0b"><syl wordpos="m" con="d">le-</syl><neume><nc xml:id="m-324a9371-fb2e-4090-ba9b-20434bd811dc" pnam