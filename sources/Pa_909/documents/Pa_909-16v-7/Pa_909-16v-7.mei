-9eac5863c42a" endid="#m-e88f7170-9b37-49c7-82c4-9eeb68dd5a9f"><table><tr><td><rend>((paruulorum))</rend></td><td><rend>]</rend></td><td><rend>formal plausibler: ((paruorum)) (wie ((CT I))).</rend></td></tr></table></annot><annot startid="#m-c79e58eb-2a6e-4c98-99d8-7045de787425" endid="#m-c79e58eb-2a6e-4c98-99d8-7045de787425" type="emendation"><table><tr><td><rend>((praetioso)) (wie ((CT I)))</rend></td><td><rend>]</rend></td><td><rend>((praetiosi))</rend></td></tr></table></annot><annot startid="#m-a5bf065c-3202-4d88-99a9-42c860a95258" endid="#m-a5bf065c-3202-4d88-99a9-42c860a95258" type="emendation"><table><tr><td><rend>((lactis)) (wie ((CT I)))</rend></td><td><rend>]</rend></td><td><rend>((lactus))</rend></td></tr></table></annot><annot startid="#m-f33d401c-4eca-455d-91da-a4e566e3f873" endid="#m-9419af92-fc08-4eb5-81a5-10b4b3f08cdd" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><rend>vgl. die abweichende Fassung in ((Pa 1121)):</rend></td><td><ptr target="#m-comment-6-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((27, 28, 29, 30, 53, 34, 35, 56, 2:)) Hexameter (((28, 29)) ohne Beachtung der Quantitäten, ((34, 2)) mit metrischen Fehlern).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-909"><bibl><identifier type="siglum">Pa 909</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 909-16v-7</identifier><title>Filii carissimi</title><incip><incipText><p>Filii carissimi</p></incipText></incip><contents><contentItem><locus from="16v">f. 16v, l. 7</locus></contentItem></contents><biblList><bibl>Innoc intr 23 A 24 C 25 D 54 E 27 A 28 D 29 A 30 D 53 A 34 C 35 D 55 A 1 56 A 2 B 3 C 4 D (CT I)</bibl><bibl type="printed-edition">II-3</bibl></biblList><classification><termList><term type="genre">Tropus