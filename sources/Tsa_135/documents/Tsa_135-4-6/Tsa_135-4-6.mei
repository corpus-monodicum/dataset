l><identifier type="siglum">Tsa 135</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Tsa 135-4-6</identifier><title>Sume pater voces</title><incip><incipText><p>Sume pater voces</p></incipText></incip><contents><contentItem><locus from="4">f. 4, l. 6</locus></contentItem></contents><biblList><bibl>AH 47, 164: 1A 2A 3A 3C</bibl></biblList><classification><termList><term type="genre">Kyrie</term><term type="genre">tropiert</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">4v</term><term type="Endzeile">3</term><term type="Melodiennummer_Katalog">Melnicki deest (26.1)</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Tsa 135</identifier><identifier type="cantus">Tsa 135</identifier><titleStmt><title>Tsa 135</title></titleStmt><creation><geogName role="origin">Tortosa</geogName><geogName role="origin-region">Quellen spanischer Herkunft</geogName><date>13. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Kyriale, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">135</identifier><physLoc><repository><geogName role="settlement">Tortosa</geogName><corpName>Biblioteca Capitular</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-2f5e3bb1-7026-49ee-ad00-62f102072c5f"><section xml:id="