">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">223</term><term type="Endzeile">2</term><term type="Melodiennummer_Katalog">Schildbach 264</term><term type="Cantus_ID">509505</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Mod 7</identifier><identifier type="cantus">Mod 7</identifier><titleStmt><title>Mod 7</title></titleStmt><creation><geogName role="origin">Forlimpopoli</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><date>11. Jh – 12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale mit Tropen und Sequenzen, Kyriale</term></termList></classification><itemList><item><identifier type="shelfmark">O.I.7</identifier><physLoc><repository><geogName role="settlement">Modena</geogName><corpName>Biblioteca Capitolare</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-96489172-6897-4ef1-a02e-021ad7ffab80"><section xml:id="m-6cbf98f6-7ac8-46ac-ac09-d85a53eca606" label="1" type="Einsatzmarke"><sb xml:id="m-015bbddf-1edf-4917-8899-489b7d6af6c4"/><staff n="1"><layer n="1"><syllable xml:id="m-85d18f97-672f-4171-bc53-8bdd8fe80c85"><syl wordpos="i" con="d">A-</syl><neume><nc xml:id="m-81f9352b-8c6f-43f6-a7a9-76b5967769f2" pname="g" oct="4"/><nc xml:id="m-5236092b-bff4-4bce-ac88-d79b18390706" pname="a" oct="4"/><nc xml:id="m-2c7d8932-6f49-400b-a2e9-f579a61a78f2" pname="b" oct="4"/></neume></syllable><syllable xml:id="m-32eb8ce7-9812-430b-8c3f-4452626359b4"><syl wordpos="t">gnus</syl>