 endid="#m-97507a6d-47b8-4646-8858-0c7fa5097543">AH: mater</annot><annot startid="#m-c5c0a441-251c-4d8a-abfa-a4c71e6b42c4" endid="#m-06595fc0-e5c8-4a4c-8efd-c7a163213877">In AH: sumptam nobis</annot><annot startid="#m-d7cb95ff-4cdd-4f8e-a89e-a633d2896ff3" endid="#m-d7cb95ff-4cdd-4f8e-a89e-a633d2896ff3">Radierung?</annot><annot startid="#m-d2dd2e91-16f3-4a2b-90ab-b0c548c12c39" endid="#m-8013eb13-e9f9-426b-b0e5-2d83913b3c6a">AH: Audiit</annot><annot startid="#m-00a1c9cd-aba6-4d70-bd29-13a3ff4bb574" endid="#m-6f215832-e7e5-4e67-8db1-ae9ec4712885">AH: sacrarium</annot><annot startid="#m-d1005f5c-137e-4eb5-8fef-99236bd6a2a0" endid="#m-8507237a-426b-45f9-b11e-3833efd45d2f">AH: pace</annot><annot startid="#m-d99a5969-3adf-4885-a6cb-0fe4ecabf5ed" endid="#m-32776fcf-2382-45db-ac35-9e0273a4669d">AH ohne et und „ex dilecto“</annot><annot startid="#m-07ec699d-0bf5-4012-9178-6bc0a82ebc01" endid="#m-4bfc57ac-84ab-4f48-a288-d1cf2d6ce703">durch Bindung nicht lesbar</annot><annot startid="#m-7a0911a3-5599-4aca-8f07-77a7ebe740b0" endid="#m-e1fdd09f-f18e-4aa9-b2d7-775324071d6e"><table><tr><td><rend>((lilia))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((filia))</rend></td></tr></table></annot><annot startid="#m-6dc50701-66c0-445e-8543-6653205d0e8c" endid="#m-6dc50701-66c0-445e-8543-6653205d0e8c"><table><tr><td><rend>((&lt;-tes&gt; ||))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben vom Falz verdeckt.</rend></td></tr></table></annot><annot startid="#m-707308b6-f8fd-486c-b059-e1b3bba29d3b" endid="#m-5ea4590f-0e88-447b-a82a-0976128d8b48" type="emendation"><table><tr><td><rend>((summi))</rend></td><td><rend>]</rend></td><td><rend>((fummi))</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-l-11"><bibl><identifier type="siglum">Lü 11</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Lü 11-167v-2</ide