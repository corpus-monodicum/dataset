<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 14452-236-10</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/b1f80b98-7e04-4317-995d-6d6b450694b8</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Anna Sanda</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Nachtrag_6</annot><annot startid="#m-7df12b4e-60c3-4e04-896d-cc5072277b71" endid="#m-65f477b5-7bad-45b3-a9cc-55d8c39dc488">Noten gfelhen!</annot><annot startid="#m-2cacfc50-6ea3-4090-b4a8-60536fe6ee12" endid="#m-2cacfc50-6ea3-4090-b4a8-60536fe6ee12"><table><tr><td><rend>((Hec))</rend></td><td><rend>]</rend></td><td><rend>das Datum 1567 ist in Kleinschrift innerhalb des Buchstabens ((H)) angegeben.</rend></td></tr></table></annot><annot startid="#m-2e8b2f82-99b9-41d0-bda4-ec3a435ab337" endid="#m-2e8b2f82-99b9-41d0-bda4-ec3a435ab337" corresp="#m-comment-2"><table><tr><td><ptr target="#m-comment-2-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-2-notes-1"/></td></tr></table></annot><annot startid="#m-5b679ae1-920c-4af9-9423-d9ae3af4342a" endid="#m-5b679ae1-920c-4af9-9423-d9ae3af4342a"><table><tr><td><rend>((Hanc))</rend></td><td><rend>]</rend></td><td><rend>In die Initiale ist eine Verschränkung der Buchstaben H, N und D eingearbeitet. Bei den Buchstaben handelt es vermutlich um das Namenskürzel des Schreibers. Die Buchstaben tauchen in diesem Teil der Handschrift öfters auf, teilweise mit der Jahreszahl 1567 kombiniert.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Nachtragsschicht 6a (f. 226-244v), zusammen mit weiteren Sequenzen, danach marianische Antiphonen, Messproprien und anderes.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-14452"><bibl><identifier type="siglum">Pa 14452</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 14452-236-10</identifier><title>Regis et pontificis</title><incip><incipText><p>Regis et pontificis</p></incipText></incip><contents><contentItem><locus from="236">f. 236, l. 10</locus></contentItem></contents><biblList><bibl>AH 54, 133; AH 8, 16</bibl><bibl type="printed-edition">CM III</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Translatio sanctae coronae</term><term type="feast">Messe</term><term type="Editor">(unlisted editor)</term><term type="Endseite">237v</term><term type="Endzeile">5</term><term type="Melodie_Standard">–</term><term type="Nachtragsschicht">Nachtrag_6</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 14452</identifier><identifier type="cantus">Pa 14452</identifier><titleStmt><title>Pa 14452</title></titleStmt><creation><geogName role="origin">Paris</geogName><geogName role="origin-region">Quellen französischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Victor</corpName><date>13. Jh (1239 (F. Gasparri), Nachträge aus dem 16. Jh)</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale, Kyriale, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 14452</identifier><physLoc><repository><geogName role="settlement">Paris</geogN