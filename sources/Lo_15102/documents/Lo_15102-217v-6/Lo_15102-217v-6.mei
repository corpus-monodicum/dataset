ues)</term><term type="Band_Genre">Spiele</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Lo 15102</identifier><identifier type="cantus">Lo 15102</identifier><titleStmt><title>Lo 15102</title></titleStmt><creation><geogName role="origin-region">Quellen deutscher Herkunft</geogName><corpName role="origin-institution">Abtei St Martin</corpName></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="ordenstradition">Benediktiner</term></termList></classification><itemList><item><identifier type="shelfmark">Add. 15102</identifier><physLoc><repository><geogName role="settlement">London</geogName><corpName>British Library</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-3a79c853-f58a-49dd-a717-f667afb26b6a"><section xml:id="m-24edf297-b7b4-478a-93cd-36db93e16a1b"><section xml:id="m-40b2be39-208e-42a9-a985-b8fa2387dff1"><section xml:id="m-8f54bc01-baff-41c0-95e2-ae49342513c0"><sb xml:id="m-2d611cfd-832b-40f5-b236-d33fcf2e2df5"/><staff n="1"><layer n="1"><annot xml:id="m-68b7a541-6070-47bb-8f6f-12b0be7e0ff3" type="paratext" label="Aufführung">HUMILITAS</annot><syllable xml:id="m-d0ebb9f7-0ab2-45bc-9cda-f0558110be95"><syl wordpos="s">O</syl><neume><nc xml:id="m-309246c7-566f-45be-92ec-2cc6b698d0d8" pname="e" oct="4"/><nc xml:id="m-2c57f428-3044-4d51-8f37-a6944df06f51" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-1015ce5f-90ec-452a-9e87-fe6038b9aea1"><syl wordpos="i" con="d">om-</syl><neume><nc xml:id="m-6c451c36-cda8-4f54-8183-3b5ad5da3627" pname="g" oct="4"/><nc xml:id="m-27af2f37-daa4-4ee7-9e4c-f59e2fa94a40" 