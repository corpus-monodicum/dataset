-2c4f7c42e859"><table><tr><td><rend>((Hodie est))</rend></td><td><rend>]</rend></td><td><rend>Notation nur für 3 Silben, offenbar mit Aphärese/Krasis zu singen.</rend></td></tr></table></annot><annot startid="#m-bf6fa5c4-8740-435b-aaa2-920c1a0616b1" endid="#m-0092ee7b-c0b0-4012-8bf4-e980efc47a5c" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>Tonhöhe nicht ganz klar, man könnte auch ((F)) lesen (wie ((Pa 1119))), ((Pa 1121)) hat ebenfalls ((G)).</rend></td></tr></table></annot><annot startid="#m-e5613fe1-ef07-4e3d-a6e2-e269100ef10f" endid="#m-e5613fe1-ef07-4e3d-a6e2-e269100ef10f"><table><tr><td><rend>((fideles))</rend></td><td><rend>]</rend></td><td><rend>formal und semantisch plausibler: ((sidere)) (wie ((CT X))).</rend></td></tr></table></annot><annot startid="#m-3961bb17-f40b-498d-bf09-9287676259c6" endid="#m-2412da4e-79a7-4c5a-bc1f-56700eaac99c"><table><tr><td><rend>((ornatam))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((quis ornatam)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-fb21c9ef-fe07-4814-ab4e-ccc7c68c4271" endid="#m-d7ddf3c3-3dd5-409b-b0c3-b5e45006e334"><table><tr><td><rend>((festiuis))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((festiuus))</rend></td></tr></table></annot><annot startid="#m-e05a4f26-2ad6-42af-a817-63b95accc5c9" endid="#m-1f0d17b6-2d79-47da-b982-e4d349093019"><table><tr><td><rend>((&lt;H&gt;odie))</rend></td><td><rend>]</rend></td><td><rend>Initiale nicht ausgeführt.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((88, 89, 90, 44, 45, 86, 87, 91, 82, 92, 93, 94, 95, 83, 84, 85, 36, 96, 97, 15, 16, 17, 98, 99, 37, 38, 39:)) Hexameter (((90, 87, 93, 94, 85, 36, 15)) mit metrischen Fehlern, ((83, 84)) ohne Beachtung der Quantitäten).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-909"><bibl><identifier type="siglum">Pa 909</identifier></bibl></source><