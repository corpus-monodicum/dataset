<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>RoV 52-149v-12</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/09955a09-12fe-4271-8857-134fd7dffc28</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-ba4d9b84-0916-4c9b-bdbb-c8035edc3310" endid="#m-e387bd2f-2593-463c-a758-2a3fd6028775"><table><tr><td><rend>((AH)) kennt für diesen Text nur eine weitere Handschrift, ((RoA 123)) (((f. 196)) und ((265v))). Dort wird er (soweit die adiastematische Notation das erkennen lässt) auf Melodie b gesungen, wie an dieser formalen Stelle zu erwarten wäre. Die Silbenzahl passt dagegen besser zu Melodie a wie in ((RoV 52)).</rend></td></tr></table></annot><annot startid="#m-ba624000-da20-456b-9439-db5c0cc9c7fe" endid="#m-c835550f-590a-4504-9ffc-d97cfc19a143"><table><tr><td><rend>((umana))</rend></td><td><rend>]</rend></td><td><rend>lies ((humana))</rend></td></tr></table></annot><annot startid="#m-0fb913f8-a516-4989-959c-df03a657c12f" endid="#m-0b54be41-46a0-4d12-8fbf-7735375ed773" corresp="#m-comment-2"><table><tr><td><ptr target="#m-comment-2-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-2-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>c</rend></td><td><rend>c</rend></td><td><rend>d</rend></td></tr><tr><td><rend>1A</rend></td><td><rend>1B</rend></td><td><rend>1C</rend></td><td><rend>1D</rend></td><td><rend>2A</rend></td><td><rend>2B</rend></td><td><rend>3A</rend></td><td><rend>3B</rend></td><td><rend>3C</rend></td></tr></table></td></tr><tr><td><rend>In den textierten Teilen erscheint ungewöhnlicherweise Melodie a viermal, Melodie b nur zweimal, in den melismatischen Teilen ist die Abfolge dagegen regelmäßig (Melodie b nach Teil 1D).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-rov-52"><bibl><identifier type="siglum">RoV 52</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>RoV 52-149v-12</identifier><title>Lux et origo</title><incip><incipText><p>Lux et origo</p></incipText></incip><contents><contentItem><locus from="149v">f. 149v, l. 12</locus></contentItem></contents><biblList><bibl>AH 47, 12a: 1A 1B 1C 1D 2A 2B 3A 3B 3C</bibl></biblList><classification><termList><term type="genre">Kyrie</term><term type="genre">tropiert</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">150</term><term type="Endzeile">10</term><term type="Melodiennummer_Katalog">Melnicki 39</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">RoV 52</identifier><titleStmt><title>RoV 52</title></titleStmt><creation><geogName role="origin">Arezzo (Region, möglicherweise)</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><date>11. Jh – 12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale, Kyriale mit Tropen, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">C 52</identifier><physLoc><repository><geogName role="settlement">Rom</geogName><corpName>Biblioteca Vallicelliana</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-7596c55d-93d6-4f5d-8498-dceee2534589"><section xml:id="m-85798ebb-f44e-49ad-81a7-9b451d24d920"/><section xml:id="m-c7987f72-0c97-417b-8eff-ebcf8fb5539b" label="1A" type="Tropenelement"><sb xml:id="m-5f449a48-6e71-46e0-8a88-9a0bef7ac92f"/><staff n="1"><layer n="1"><annot xml:id="m-653cceb9-caf9-4d39-971c-0773c930a6be" type="paratext" label="Gesang">ALIO (f. 149v)</annot><syllable xml:id="m-d95982a3-20b8-4f04-a296-90e5901521b9"><syl wordpos="s">Lux</syl><neume><nc xml:id="m-caa1af5c-3844-4e82-badd-868cf878fe96" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-575210fc-efed-4a8a-88ef-9984206473d0"><syl wordpos="s">et</syl><neume><nc xml:id="m-8a81b6cf-a2a0-4708-be39-b42c677d6803" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-209003ef-e035-4cda-b377-d8a1ca9a86d1"><syl wordpos="i" con="d">or-</syl><neume><nc xml:id="m-7b3653cc-432a-4afe-9b70-399df208c9d3" pname="b" oct="4"/></neume></syllable><syllable xml:id="m-2bb86291-e482-4c78-b35e-9b3548ee943f"><syl wordpos="m" con="d">ri-</syl><neume><nc xml:id="m-d9be1403-a9dd-4ba8-a9d9-83a61e24ada4" pname="b" oct="4"/><nc xml:id="m-c2ee7133-e3a4-4d05-9765-1c62c51daf24" pname="a" oct="4" con="g"/><nc xml:id="m-38d5c321-ebac-4ead-ab0c-9f556c2bd70a" pname="g" oct="4" con="g"/></neume></syllable><syllable xml:id="m-e3d47932-e7cb-453a-8580-bc9abfb44f87"><syl wordpos="t">go</syl><neume><nc xml:id