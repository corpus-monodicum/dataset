<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 1871-99v-1</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/f0139930-31d4-4c78-86e2-076c71d53fc8</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Nachtrag auf Rasur von Christi hodiernae</annot><annot startid="#m-5bd700a7-8ae5-463f-b450-1debd67fabe2" endid="#m-42b2840c-b1c2-4f71-aae7-fa1404535d59"><table><tr><td><rend>((Afectus))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-fectus)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-4de8eaf2-36b2-4d0d-ba8d-515d0d9277c5" endid="#m-4de8eaf2-36b2-4d0d-ba8d-515d0d9277c5" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-1-notes-1"/></td><td><rend>(alles Folgende eine Stufe tiefer).</rend></td></tr></table></annot><annot startid="#m-294dc6b6-818f-4785-810a-66a7e7d83efc" endid="#m-c6519c7e-f95c-4e84-8806-8031b75d4135" type="emendation" corresp="#m-comment-2"><table><tr><td><ptr target="#m-comment-2-notes-0"/></td><td><rend>(wie 10b)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-2-notes-1"/></td><td><rend>(alles Folgende eine Stufe höher).</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Text und Notation von späterer Hand auf Rasur. Notation auf Blindlinie, die vermutlich eine tonale Bedeutung hat. In der letzten Zeile ist die Blindlinie nicht sicher erkennbar, davor liegt sie auf ((b (molle))); setzt man als Tonart den 4. Ton auf ((a)) an (wie das der Beginn suggeriert), entspricht das der gängigen Verwendung der Blindlinie, z.B. in ((Pa 903)).</rend></td></tr><tr><td><rend>Die radierte Sequenz war vermutlich ((Christi hodiernae)), die Initiale ((X)) ist auf f. 99 noch erkennbar.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1871"><bibl><identifier type="siglum">Pa 1871</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1871-99v-1</identifier><title>Caeleste organum</title><incip><incipText><p>Caeleste organum</p></incipText></incip><contents><contentItem><locus from="99v">f. 99v, l. 1</locus></contentItem></contents><biblList><bibl>AH 54, 1</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Nativitas domini</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">99v</term><term type="Endzeile">13</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1871</identifier><identifier type="cantus">Pa 1871</identifier><titleStmt><title>Pa 1871</title></titleStmt><creation><geogName role="origin">Moissac</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Pierre</corpName><date>11. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar, Prosar, Prosular</term></termList></classification><itemList><item><identifier type="shelfmark">Nouv. acq. lat. 1871</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpN