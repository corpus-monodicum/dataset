AP: Ich würde für Edition ohne Liqueszenz plädieren (vgl. die Fälle in Lux et origo). Kleine Strichlein rechts abwärts gibt es auch dort, wo kaum eine Liqueszenz gemeint sein kann, z.B. in der folgenden Zeile; wenn eine Liqueszenz gemeint ist, dann ist im Idealfall die Note selbst nach unten gezogen oder zumeindes der Strich länger.</annot><annot type="global-comment"><table><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>c</rend></td><td><rend>c</rend></td><td><rend>c</rend></td></tr><tr><td><rend>1A</rend></td><td><rend>1B</rend></td><td><rend>1C</rend></td><td><rend>2A</rend></td><td><rend>2B</rend></td><td><rend>2C</rend></td><td><rend>3A</rend></td><td><rend>3B</rend></td><td><rend>3C</rend></td></tr></table></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-paa-135"><bibl><identifier type="siglum">PaA 135</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>PaA 135-229b-7</identifier><title>Kyrie fons bonitatis</title><incip><incipText><p>Kyrie fons bonitatis</p></incipText></incip><contents><contentItem><locus from="229b">f. 229b, l. 7</locus></contentItem></contents><biblList><bibl>AH 47, 5</bibl></biblList><classification><termList><term type="genre">Kyrie</term><term type="genre">tropiert</term><term type="feast">Epiphania</term><term type="feast">Messe</term><term type="Editor">(unlisted editor)</term><term type="Endseite">229v b</term><term type="Endzeile">2</term><term type="Melodiennummer_Katalog">Melnicki 48</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">PaA 135</identifier><titleStmt>