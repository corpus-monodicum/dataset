-e226-4841-9db0-d8a69914a840" endid="#m-8fec09e0-6b76-4436-8015-55c1f35ecbec"><table><tr><td><rend>((harche))</rend></td><td><rend>]</rend></td><td><rend>lies ((arce))</rend></td></tr></table></annot><annot startid="#m-4b823757-cd69-4f6c-a05e-59abd435442d" endid="#m-f82a760a-a772-4f40-8bcc-5954b5c78745" type="emendation"><table><tr><td><rend>((admiti suma)) (wie ((Pa 1138-12v-3)))</rend></td><td><rend>]</rend></td><td><rend>((ad mitissima)), lies ((admitti summa)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-934fe707-89ba-49c6-b94b-8c77b3b4dbba" endid="#m-62da46b9-5a03-4199-9b97-945f544426cd"><table><tr><td><rend>((Magne))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((Manne)) (wie ((AH)) und ((Pa 1118-211v-2))).</rend></td></tr></table></annot><annot startid="#m-3b36658e-809b-47d4-bc68-ba2a354c4341" endid="#m-877fdd03-6dfb-4d45-a60b-57b7662af512"><table><tr><td><rend>((&lt;I&gt;deo))</rend></td><td><rend>]</rend></td><td><rend>Initiale nicht ausgeführt.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1871"><bibl><identifier type="siglum">Pa 1871</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1871-169v-5</identifier><title>Haec est festivitas</title><incip><incipText><p>Haec est festivitas</p></incipText></incip><contents><contentItem><locus from="169v">f. 169v, l. 5</locus></contentItem></contents><biblList><bibl>AH 7, 124</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">170</term><term type="Endzeile">2</term><term type="Melodie_Standard">(Almiflua caelorum)</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1871</identifier><identifier type="cantus">Pa 187