 endid="#m-97507a6d-47b8-4646-8858-0c7fa5097543">AH: mater</annot><annot startid="#m-c5c0a441-251c-4d8a-abfa-a4c71e6b42c4" endid="#m-06595fc0-e5c8-4a4c-8efd-c7a163213877">In AH: sumptam nobis</annot><annot startid="#m-d7cb95ff-4cdd-4f8e-a89e-a633d2896ff3" endid="#m-d7cb95ff-4cdd-4f8e-a89e-a633d2896ff3">Radierung?</annot><annot startid="#m-d2dd2e91-16f3-4a2b-90ab-b0c548c12c39" endid="#m-8013eb13-e9f9-426b-b0e5-2d83913b3c6a">AH: Audiit</annot><annot startid="#m-00a1c9cd-aba6-4d70-bd29-13a3ff4bb574" endid="#m-6f215832-e7e5-4e67-8db1-ae9ec4712885">AH: sacrarium</annot><annot startid="#m-d1005f5c-137e-4eb5-8fef-99236bd6a2a0" endid="#m-8507237a-426b-45f9-b11e-3833efd45d2f">AH: pace</annot><annot startid="#m-d99a5969-3adf-4885-a6cb-0fe4ecabf5ed" endid="#m-32776fcf-2382-45db-ac35-9e0273a4669d">AH ohne et und „ex dilecto“</annot><annot startid="#m-4bfc57ac-84ab-4f48-a288-d1cf2d6ce703" endid="#m-4bfc57ac-84ab-4f48-a288-d1cf2d6ce703"><table><tr><td><rend>((-l&lt;us&gt; |))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben vom Falz verdeckt.</rend></td></tr></table></annot><annot startid="#m-577fc0ed-84b4-40c8-b0b4-3d4a03fec280" endid="#m-aede2d73-f9ca-4e20-8c35-d2efa6695944"><table><tr><td><rend>((cla&lt;u&gt;- |))</rend></td><td><rend>]</rend></td><td><rend>Buchstabe vom Falz verdeckt.</rend></td></tr></table></annot><annot startid="#m-8cbfc6b8-754b-4fbd-a6f5-69d1a8bc005a" endid="#m-9e4daa7e-7945-49c4-8ba1-ad660c86f92b" type="emendation"><table><tr><td><rend>((inuoluat))</rend></td><td><rend>]</rend></td><td><rend>((inuolliat))</rend></td></tr></table></annot><annot startid="#m-8a649b9e-2ada-46dc-b55d-03a835bb0333" endid="#m-19ab2e0f-05e6-4e5f-8592-dd719a244964" corresp="#m-comment-18"><table><tr><td><ptr target="#m-comment-18-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert zu</rend></td><td><ptr target="#m-comment-18-notes-1"/></td></tr></table></annot><annot startid="#m-e76303d8-07b7-4c80-8ce8-0726aadd1166" endid="#m-44204ab7-0a34-4df4-9bf3-f324beb90b97" cor