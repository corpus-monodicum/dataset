<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 1871-52-11</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/c0f242b7-efdc-4041-af7d-be44d216f6af</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Nachtrag</annot><annot startid="#m-7c12a351-5a10-4937-8000-42632c11e6d6" endid="#m-adae3291-594c-40be-a22f-1204a874ddf7" corresp="#m-comment-0"><table><tr><td><ptr target="#m-comment-0-notes-0"/></td><td><rend>]</rend></td><td><rend>Vor und nach diesem Abschnitt des Melismas Zeichen // auf Höhe des Textes.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Nachtrag.</rend></td></tr><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>c</rend></td><td><rend>c</rend></td><td><rend>c'</rend></td></tr><tr><td><rend>1A</rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend>2A</rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend>3C</rend></td></tr></table></td></tr><tr><td><rend>Die Aufzeichnung ist unklar und vielleicht unvollständig hinsichtlich Melodieteil c. Der hier als 3C eingeordnete Melodieteil zeigt die typischen Wiederholungsstrukturen eines verlängerten letzten Teils (c'). 3A (c) wäre dann vermutlich durch Überspringen dieser Wiederholungen zu gewinnen. Zeichen in der Textzeile von 3C (nach der 15. und 28. Note) könnten ein solches Überspringen anzeigen.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1871"><bibl><identifier type="siglum">Pa 1871</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1871-52-11</identifier><title>Kyrie eleyson</title><incip><incipText><p>Kyrie eleyson</p></incipText></incip><contents><contentItem><locus from="52">f. 52, l. 11</locus></contentItem></contents><classification><termList><term type="genre">Kyrie</term><term type="genre">untropiert</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">52</term><term type="Endzeile">12</term><term type="Melodiennummer_Katalog">Melnicki 194: 1A 2A 3C</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1871</identifier><identifier type="cantus">Pa 1871</identifier><titleStmt><title>Pa 1871</title></titleStmt><creation><geogName role="origin">Moissac</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Pierre</corpName><date>11. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar, Prosar, Prosular</term></termList></classification><itemList><item><identifier type="shelfmark">Nouv. acq. lat. 1871</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList><relationList><relation rel="hasReproduction" target="https://gallica.