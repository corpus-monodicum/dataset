<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 778-119v-1</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/62bce74b-5b30-4ab1-85ce-f830086e8d9c</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-cb7b8d34-47be-44ac-aa27-750d842f9b54" endid="#m-b40a9afe-7318-4b71-84e3-7887af22ea00"><table><tr><td><rend>((Pvlcra ... lumina))</rend></td><td><rend>]</rend></td><td><rend>der grammatikalisch unverständliche Text scheint relativ einheitlich überliefert zu sein, daher bleibt er in unverändert. Ein verständlicher Text lässt sich mit ((AH)) so herstellen: ((Pvlcra prepollent in arua hac die duorum lumina)). Auch im Folgenden bleiben einheitlich überlieferte Textfassungen in der Edition stehen, die Emendationen der ((AH)) werden im Kommentar angeführt.</rend></td></tr></table></annot><annot startid="#m-d5fe714a-c882-48ff-938d-856b38aa3e7e" endid="#m-84160f6a-a81d-42e8-8b24-8ae6649422e7"><table><tr><td><rend>((Deinc))</rend></td><td><rend>]</rend></td><td><rend>lies ((Dehinc))</rend></td></tr></table></annot><annot startid="#m-a29796d9-7943-4dd4-a533-133934abba1e" endid="#m-f9015090-0c06-47ae-bb34-4585fb9516db"><table><tr><td><rend>((chamena recitemus alma))</rend></td><td><rend>]</rend></td><td><rend>((AH: cantica recitemus alta)) (mit ((Pa 1084)) und ((Pa 887))); alternativ könnte man zu ((chamenam recitemus almam)) emendieren.</rend></td></tr></table></annot><annot startid="#m-06c4833f-eff1-44d9-8221-7321693a49c3" endid="#m-c4821615-e609-4368-b1f4-faa3be379080"><table><tr><td><rend>((summa))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((suma))</rend></td></tr></table></annot><annot startid="#m-d291f10e-f06d-41ff-bd11-46dbb1bf3d3f" endid="#m-38587616-bf4a-47e7-a6ff-a9125861354b" type="emendation"><table><tr><td><rend>((tenens |))</rend></td><td><rend>]</rend></td><td><rend>((tenens | tens)), das 2. Wort o.N.; ((AH: tenet)) (mit ((Pa 887))).</rend></td></tr></table></annot><annot startid="#m-940299c9-b921-42e7-81a9-6b8cfedb2b03" endid="#m-949b4f19-05d6-46f9-af4c-4aa6a7ab06d5"><table><tr><td><rend>((herens))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((erens)) (?).</rend></td></tr></table></annot><annot startid="#m-5fc0a50a-ca29-4301-9150-b600c0ead185" endid="#m-42bf46e5-aab8-42be-80ec-2702342d6c68"><table><tr><td><rend>((hic te))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur.</rend></td></tr></table></annot><annot startid="#m-582487b3-d62f-4e67-a907-d354f2bc2dfe" endid="#m-07199e84-eacc-4e94-a4a6-afffd4a897e2"><table><tr><td><rend>((dei so-))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-i so-)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-63974661-40a9-4f77-b13b-fefd13ec547c" endid="#m-c76e13fc-5fb7-4003-ad2c-b8608998bc0b"><table><tr><td><rend>((-phismata))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((-phisma)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-293f8766-38fa-419d-8165-1edcfcf5ae3f" endid="#m-cf666c8a-d9f1-4a4e-b7f3-5e837aece935"><table><tr><td><rend>((Paulus ... gracie))</rend></td><td><rend>]</rend></td><td><rend>zahlreiche Korrekturen am Text, vor Korrektur stimmte er vermutlich mit den übrigen Handschriften überein; erkennbar ist: ((Paulus de terrestri.. uocatus ad supera sinagoga arida liquida ..erens d..... gracia)).</rend></td></tr></table></annot><annot startid="#m-c91576fb-386e-4a49-aa86-5a3ea9d7dbf3" endid="#m-c76e13fc-5fb7-4003-ad2c-b8608998bc0b"><table><tr><td><rend>((Rome ... sophismata))</rend></td><td><rend>]</rend></td><td><rend>((AH: Romae ducti moenia Simonis pestiferam haeresim contrariam vicerunt per Dei simul sophiam)).</rend></td></tr></table></annot><annot startid="#m-83874098-a13b-4a23-bf8c-b61314298efc" endid="#m-736a7822-e8ba-4d26-a89a-183e961a4658"><table><tr><td><rend>((Neroni))</rend></td><td><rend>]</rend></td><td><rend>((AH: Neronis)) (mit ((Pa 887))).</rend></td></tr></table></annot><annot startid="#m-a67cdedf-a73d-4940-99a1-499c02632a7a" endid="#m-90830a9b-bfa9-4d49-8e20-8748a0140458"><table><tr><td><rend>((uiperina))</rend></td><td><rend>]</rend></td><td><rend>((AH: uiperinam)) (mit ((Pa 887))).</rend></td></tr></table></annot><annot startid="#m-febf9545-b8e6-4315-85d7-9f3ff4e9a75b" endid="#m-1a5fdd62-dcf5-476b-95e9-3d135908d5a8"><table><tr><td><rend>((suprema))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((superni)) (?).</rend></td></tr></table></annot><annot startid="#m-07533273-fded-4615-afa1-b73c9dec1943" endid="#m-b0e68159-f989-46b1-973b-c80e7d53579a"><table><tr><td><rend>((properare duxit))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((propera reduxit))</rend></td></tr></table></annot><annot startid="#m-57fbdf0f-ae2f-44b2-a38c-db4e6e086058" endid="#m-97646a61-1f13-468a-bf8d-4db7195d0f96"><table><tr><td><rend>((uulneratus))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((uulnerati))</rend></td></tr></table></annot><annot startid="#m-53464476-2b71-4d8d-93d9-1684cf709f75" endid="#m-f7696de1-90d8-40f8-9865-bfaa4582afe9"><table><tr><td><rend>((cecidit))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((cecinit))</rend></td></tr></table></annot><annot startid="#m-f6f9273e-20cb-4225-96a6-cf05926d8d13" endid="#m-7149f706-c98f-4bb6-ad3a-ad2ef1d196f8"><table><tr><td><rend>((preclara))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur.</rend></td></tr></table></annot><annot startid="#m-53734d68-088f-4d18-a1a2-c0a5b96b45f1" endid="#m-f5243055-c2df-470f-bbfa-eaf5b79870ba"><table><tr><td><rend>((sitim))</rend></td><td><rend>]</rend></td><td><rend>lies ((scitim)), ((AH: statim)) (mit ((Pa 887))).</rend></td></tr></table></annot><annot startid="#m-74d61f92-0f4a-421f-b621-38b699905801" endid="#m-010e998a-e403-4cb1-ad05-c092249cb841" type="emendation"><table><tr><td><rend>((Neronis)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((Neroni))</rend></td></tr></table></annot><annot startid="#m-10bf638a-893f-4ec5-83dc-6def0ab2a5aa" endid="#m-70f0c3ed-0660-4060-a470-bb71eb709965"><table><tr><td><rend>((uulnera))</rend></td><td><rend>]</rend></td><td><rend>((AH: vulnere))</rend></td></tr></table></annot><annot startid="#m-8f99b7ca-ae43-4e73-b7f0-fa31344e60e1" endid="#m-75aa53cd-e7a2-46b7-ae6b-f84b59e07349"><table><tr><td><rend>((palma))</rend></td><td><rend>]</rend></td><td><rend>((AH: palmam))</rend></td></tr></table></annot><annot startid="#m-b3e96b06-26d0-4f2a-ae97-e5bc86541e59" endid="#m-8632a667-0297-445b-bcda-1e330fb4cb7a"><table><tr><td><rend>((secula))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((secla)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-79b7fa7c-5877-4fd2-b81d-953b1fd25206" endid="#m-62177da4-5f59-4dfb-aeb4-fc60309a13bf"><table><tr><td><rend>((Primeua nitet)</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((Prime uanitet))</rend></td></tr></table></annot><annot startid="#m-1f72e680-4a71-4402-8a09-ffdc48de3297" endid="#m-9b3b6a9d-e939-4c95-8314-de1cd92727fe"><table><tr><td><rend>((Symoni))</rend></td><td><rend>]</rend></td><td><rend>((AH: Simonis)) (mit ((Pa 1084)) und ((Pa 887))).</rend></td></tr></table></annot><annot startid="#m-6f580f83-1b3a-479c-b684-f0bb08cd0b35" endid="#m-b0e68159-f989-46b1-973b-c80e7d53579a"><table><tr><td><rend>((duxit))</rend></td><td><rend>]</rend></td><td><rend>((AH: dixit)) (mit ((Pa 1084)) und ((Pa 887))).</rend></td></tr></table