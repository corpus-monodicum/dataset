d></td></tr></table></annot><annot startid="#m-ae4916a2-c959-4a33-9413-d34ae78b27fb" endid="#m-af3802ca-2316-4f83-8b2f-b74057e79576"><table><tr><td><rend>((uti iam))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((utiam))</rend></td></tr></table></annot><annot startid="#m-bb714efc-a08c-4062-a764-747234f92f2e" endid="#m-170391c1-f721-4db6-908e-d302c9db405b" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation ungenau, dem Eindruck nach</rend></td><td><ptr target="#m-comment-6-notes-1"/></td><td><rend>(alles Folgende eine Stufe höher), die Edition orientiert sich an 5b nach Korrektur.</rend></td></tr></table></annot><annot startid="#m-1843a60c-5012-4235-8184-c75fc760a4e8" endid="#m-00cb76ec-09c4-42b6-8e29-ffe4c7347575" corresp="#m-comment-7"><table><tr><td><ptr target="#m-comment-7-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-7-notes-1"/></td><td><rend>(Sofortkorrektur des Notators, vielleicht nur Verdeutlichung).</rend></td></tr></table></annot><annot startid="#m-fbbc9869-ff2d-40f1-937d-3e29901e1aa1" endid="#m-fbbc9869-ff2d-40f1-937d-3e29901e1aa1"><table><tr><td><rend>((Es))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((Est)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-aaa82238-f70c-4c1e-9d73-42ecf07d42d9" endid="#m-aaa82238-f70c-4c1e-9d73-42ecf07d42d9"><table><tr><td><rend>((ca))</rend></td><td><rend>]</rend></td><td><rend>lies ((qua))</rend></td></tr></table></annot><annot startid="#m-27c2d6f5-f04e-49eb-a1fc-9418bed619a6" endid="#m-734baa18-de32-450c-b2b6-0f75f0ed2c6b"><table><tr><td><rend>((gaudia))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((gaudi)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-a8408eb8-f8bc-4c3e-a3b9-ae28d13749ce" endid="#m-7d7c7ba1-a400-4e94-b76b-e6718e3909c3" type="emendation"><table><tr><td><rend>((Comti stola)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((Comtis tola))</rend></td></tr></table></annot><annot startid="#m-034c99dd-60d8-438c-96fd-a91f4c9ffc90" endid="#m-675d455d-605c-4c86-b292-499adc25d8c2"><table><tr><td><rend>((†iuga nuta†))</rend></td><td><rend>]</rend></td><td><rend>((AH)) emendiert zu ((jugi nutat)), muss dazu aber eine transitive Verwendung des ansonsten intransitiven ((nuto)) annehmen.</rend></td></tr></table></annot><annot startid="#m-fc60f9c1-c739-4a13-a14a-002b1a968edb" endid="#m-665d2dbf-a623-4cce-be4f-86c07d7a9d22" corresp="#m-comment-13"><table><tr><td><ptr target="#m-comment-13-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-13-notes-1"/></td><td><rend>, möglicherweise nur Verdeutlichung.</rend></td></tr></table></annot><annot startid="#m-52623e16-1764-4238-9beb-2bd15a0ae359" endid="#m-168f2c89-94fb-4eae-8add-e9986dcd65c2" corresp="#m-comment-14"><table><tr><td><ptr target="#m-comment-14-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus gleichlautender Notation, graphisch eine Stufe tiefer; vermutlich Sofortkorrektur des Notators, andernfalls alles Folgende vor Korrektur eine Stufe höher.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Aufzeichnung beginnt in ((Pa 1338)), endet in ((Pa 1138)).</rend></td></tr><tr><td><rend>Teil 9-14 ist eine eigenständige Sequenz, in der Handschrift aber als Fortsetzung der vorigen aufgezeichnet.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1338"><bibl><identifier type="siglum">Pa 1338</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1338-71v-1</identifier><title>Vox prophetica</title><incip><incipText><p>Vox prophetica</p></incipText></incip><contents><contentItem><locus from="71v">f. 71v, l. 1</locus></contentItem></contents><bibl