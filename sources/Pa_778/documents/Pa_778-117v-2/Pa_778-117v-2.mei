tatis))</rend></td></tr></table></annot><annot startid="#m-0ef05d91-c495-4d37-bd3d-4d887d03cb6d" endid="#m-b7565a00-e8d2-4355-b1d6-e35f99a3459b"><table><tr><td><rend>((optines))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((optimes))</rend></td></tr></table></annot><annot startid="#m-77e2bf8c-1225-4ed0-9419-d3ab6fe7bc01" endid="#m-77e2bf8c-1225-4ed0-9419-d3ab6fe7bc01"><table><tr><td><rend>((Quis))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((Qui))</rend></td></tr></table></annot><annot startid="#m-abdb4bdf-e302-4c7c-a18e-38216fd4e99a" endid="#m-c7c56695-563f-4498-956b-7120c1e5ab8b"><table><tr><td><rend>((sollempnia))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-ia)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-995e883b-be51-44a5-8f20-644cd083533a" endid="#m-995e883b-be51-44a5-8f20-644cd083533a"><table><tr><td><rend>((rex))</rend></td><td><rend>]</rend></td><td><rend>1. Buchstabe auf Rasur einer Initiale.</rend></td></tr></table></annot><annot startid="#m-9e10a05f-1d15-46aa-97a8-96b6979587ba" endid="#m-9e10a05f-1d15-46aa-97a8-96b6979587ba"><table><tr><td><rend>((sit))</rend></td><td><rend>]</rend></td><td><rend>1. Buchstabe auf Rasur einer Initiale.</rend></td></tr></table></annot><annot startid="#m-5c7a16d1-7f70-402a-a2cb-4b2a6747989d" endid="#m-cace9a3e-df5c-4ce0-8d1c-796bd3d108a1"><table><tr><td><rend>((summa))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((suma))</rend></td></tr></table></annot><annot startid="#m-342359b1-ddd6-4580-a35a-cedf0b8ac731" endid="#m-342359b1-ddd6-4580-a35a-cedf0b8ac731"><table><tr><td><rend>((iam))</rend></td><td><rend>]</rend></td><td><rend>1. Buchstabe auf Rasur einer Initiale.</rend></td></tr></table></annot><annot startid="#m-1637c231-c2f7-46a9-94a7-aa88b5eb288f" endid="#m-2ccc28d6-f9eb-4dab-b43e-408ed84113b8"><table><tr><td><rend>((Iohannis))</rend></td><td><rend>]</rend></td><td><rend>1. Buchstabe auf Rasur einer Initiale.</rend></td></tr></table></annot><annot startid="#m-631eb678-a499-4e8c-ad96-cb106877f3aa" endid="#m-b492eb78-7937-42a2-a370-31dc976d35e8"><table><tr><td><rend>((Conscedens))</rend></td><td><rend>]</rend></td><td><rend>lies ((Concedens)), zwischen 2. und 3. Silbe vermutlich Rasur auf Textebene.</rend></td></tr></table></annot><annot startid="#m-2a27e331-6330-4679-a60c-c6debaeca156" endid="#m-fddf484d-02e4-45d2-ad3f-740fbb74e552"><table><tr><td><rend>((Uox ... amen))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur, von der Lesart vor Korrektur ist nur die Initiale ((A)) erkennbar.</rend></td></tr></table></annot><annot startid="#m-37cd8dbe-cb9f-4bb1-96fd-0d300c9bab6b" endid="#m-947a54d3-cbcb-4899-bb61-d0e95242f88e"><table><tr><td><rend>((Angelis))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((Angelus))</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Notation ohne Schlüssel. Schlüssel gibt es am Beginn der Notation (Γ-F), vor der 2. Zeile (a-c-e-g) und vor der 1. Zeile auf f. 118 (a-c-e-g). Diese drei Schlüsselungen passen nicht zusammen, die Edition folgt den Schlüsseln der 2. Zeile, die der gängigen Notationslage der Melodie entsprechen; die Schlüssel am Beginn der Notation stehen eine Oktave tiefer, die Schlüssel auf f. 118 eine Stufe tiefer.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-778"><bibl><identifier type="siglum">Pa 778</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 778-117v-2</identifier><title>Gaude caterva</title><incip><incipText><p>Gaude caterva</p></incipText></incip><contents><contentItem><locus from="117v">f. 117v, l. 2</locus></contentItem></contents><biblList><bibl>AH 53, 164</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Iohannes Baptista</term><term type="f