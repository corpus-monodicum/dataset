le><tr><td><rend>((dei))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((degens)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-4bb60164-56f5-4774-9ea2-76808973690d" endid="#m-6d9614b0-d56f-42d3-8810-790ea75833b3"><table><tr><td><rend>((palmis))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((aula)) (wie ((AH)) und ((Pa 887))), die älteste überlieferte Lesart ist ((almis)) (((Pa 1118-205-9, Pa 1084, Apt 18))).</rend></td></tr></table></annot><annot startid="#m-ddb9e27c-0e8a-4ea3-9627-f0b1e16df550" endid="#m-8411f09d-8612-44b4-8e11-311cde695ae2"><table><tr><td><rend>((aethereę))</rend></td><td><rend>]</rend></td><td><rend>grammatikalisch plausibler: ((aetherea)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-00906353-c0ee-4e56-8615-7d1e5b6c154e" endid="#m-63f6b974-be55-48db-951f-f7710fd9b8ae"><table><tr><td><rend>((&lt;G&gt;emmas))</rend></td><td><rend>]</rend></td><td><rend>Initiale nicht ausgeführt.</rend></td></tr></table></annot><annot startid="#m-4c98f498-eb68-46ca-bc7e-401cece9e0cd" endid="#m-a64e55c8-0263-4e85-8b15-e004ef8423db"><table><tr><td><rend>((horum))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((aurum)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-00906353-c0ee-4e56-8615-7d1e5b6c154e" endid="#m-294c5cca-d38e-4a48-bcfa-aa364027c0a9" type="emendation"><table><tr><td><rend>((&lt;G&gt;emma ... fulgure)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((&lt;G&gt;emmas ... fulgura))</rend></td></tr></table></annot><annot startid="#m-47187eed-6474-4e9c-9fd3-aef63e82ad40" endid="#m-bcd42bc4-3df5-400b-a8fe-61ebbf1070c4"><table><tr><td><rend>((redolet))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((renitet)) (wie ((AH))).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pst-121"><bibl><identifier type="siglum">Pst 121</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc>