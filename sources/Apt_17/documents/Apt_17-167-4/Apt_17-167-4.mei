on.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-apt-17"><bibl><identifier type="siglum">Apt 17</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Apt 17-167-4</identifier><title>Concine nunc</title><incip><incipText><p>Concine nunc</p></incipText></incip><contents><contentItem><locus from="167">f. 167, l. 4</locus></contentItem></contents><biblList><bibl>Fer V intr 1 A 2 B 3 C D E (CT III)</bibl><bibl type="printed-edition">II-3</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Introitus-Tropus</term><term type="feast">Feria V post Pascha</term><term type="feast">Messe</term><term type="Editor">David Catalunya</term><term type="Bezugsgesang">(Victricem)</term><term type="Endseite">168</term><term type="Endzeile">2</term><term type="FestUndGattung">Fer V intr</term><term type="Zusatz_zu_Textinitium">Ohne Notation</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Apt 17</identifier><titleStmt><title>Apt 17</title></titleStmt><creation><geogName role="origin">Apt</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><date>11. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Prosar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 17</identifier><physLoc><repository><geogName role="settlement">Apt</geogName><corpName>Archive Basilique de Sainte Anne</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scor