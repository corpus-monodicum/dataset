<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Ass 695-14v-1</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/6a01957a-9029-4b8c-9a6c-f14a5915bd8b</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Charles M. Atkinson</persName></respStmt><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>David Hiley</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Kyrie nach Christe ohne Notation (laut Version in Pa 1235, f. 251, auch nicht wie Kyrie vor Christe, daher definitiv unvollständig).</annot><annot type="global-comment"><table><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>b</rend></td><td><rend>c</rend></td><td><rend>c</rend></td><td><rend>c</rend></td></tr><tr><td><rend>1A</rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend>2A</rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend>&lt;3A&gt;</rend></td><td><rend> </rend></td><td><rend> </rend></td></tr></table></td></tr><tr><td><rend>Denkbar wäre ein Melodieschema aaa bbb aaa, dann wäre die Aufzeichnung vollständig. Da ein solches Schema aber anderweitig nicht belegt ist, liegt die Vermutung näher, dass die Notation in 3A versehentlich fehlt.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ass-695"><bibl><identifier type="siglum">Ass 695</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ass 695-14v-1</identifier><title>Kyrie eleyson</title><incip><incipText><p>Kyrie eleyson</p></incipText></incip><contents><contentItem><locus from="14v">f. 14v, l. 1</locus></contentItem></contents><classification><termList><term type="genre">Kyrie</term><term type="genre">untropiert</term><term type="feast">Messe</term><term type="Editor">Charles M. Atkinson</term><term type="Endseite">14v</term><term type="Endzeile">2</term><term type="Melodiennummer_Katalog">Melnicki 96</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ass 695</identifier><identifier type="cantus">Ass 695</identifier><titleStmt><title>Ass 695</title></titleStmt><creation><geogName role="origin">Reims (möglicherweise)</geogName><geogName role="origin-region">Quellen französischer Herkunft</geogName><date>13. Jh 2. Viertel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Prosar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 695</identifier><physLoc><repository><geogName role="settlement">Assisi</geogName><corpName>Fondo Antico presso la Biblioteca del Sacro Convento</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-6bdd06a3-b7eb-4592-8860-be6a54b818e0"><section xml:id="m-e7e515b7-b2dd-4993-a7e7-311e0db00a2b" label="1A" 