on</term><term type="feast">Pascha</term><term type="feast">Matutin</term><term type="Editor">Elaine Stratton Hild</term><term type="Endseite">138</term><term type="Referenz_auf_Spiel">Civ 41-138-1S</term><term type="Endzeile">5</term><term type="SpielName">Easter play / Osterspiel</term><term type="Band_Genre">Spiele</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Civ 41</identifier><identifier type="cantus">Civ 41</identifier><titleStmt><title>Civ 41</title></titleStmt><creation><geogName role="origin">Cividale del Friuli</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><corpName role="origin-institution">Kathedrale Santa Maria Assunta</corpName><date>14. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><itemList><item><identifier type="shelfmark">Ms. XLI</identifier><physLoc><repository><geogName role="settlement">Cividale</geogName><corpName>Museo Archeologico Nazionale</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-d7a5d24e-0bdc-4424-99bf-eea897280fac"><section xml:id="m-a84fad8c-49ec-4a7a-9663-6e13e2a98a82"><section xml:id="m-264c3513-9816-4208-976c-97929fa53fa4"><section xml:id="m-28bae52b-39a2-48b8-bfb7-130d015039c3"><sb xml:id="m-06a99cf2-c659-41fd-9bf3-e5d6d13813ed"/><staff n="1"><layer n="1"><annot type="verweis">CAO 4342</annot><annot type="verweis">vgl. Ps 2, 8</annot><annot xml:id="m-c87e226b-b338-4355-a250-f54d80847ae6" type="paratext" label="Gesang">ANTIPHONA</annot><syllable xml:id="m-56082c5e-2c30-420b-b6be-d00cd6f344e5"><syl wordpos="i" con="d">Po-</syl><neume><nc xml:id="m