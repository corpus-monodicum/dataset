<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Dar 868-112v-151</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/eb442277-a312-4fef-b76c-d9d33b4da854</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-11a17c15-904c-42dd-8b66-eeef8b39ea85" endid="#m-aed1b0a5-e90e-4bb5-a433-1821d2964f89" type="emendation" corresp="#m-comment-0"><table><tr><td><ptr target="#m-comment-0-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-0-notes-1"/></td><td><rend>(für die beiden Incipits sind offenbar unterschiedliche Schlüssel vorausgesetzt, damit die Notation übersichtlich bleibt).</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((Dar 868-112v-15-1)) und ((Dar 868-112v-15-2)) stehen im selben System über derselben Textzeile. Da diese Notationsweise mehrfach auftritt, ist sie offenbar geplant und soll wohl zwei alternative Verknüpfungen zwischen Kyrie und Gloria anzeigen.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-dar-868"><bibl><identifier type="siglum">Dar 868</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Dar 868-112v-151</identifier><title>Gloria in excelsis*</title><incip><incipText><p>Gloria in excelsis*</p></incipText></inci