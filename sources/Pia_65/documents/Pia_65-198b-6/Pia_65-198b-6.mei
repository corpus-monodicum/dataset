<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pia 65-198b-6</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/a3a01199-aa84-48e1-af8c-579be1a6dfa0</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Festangabe unklar: IN DEDICATIONE ĘCCLESIĘ SANCTI MICHAHELIS ET DEINCEPS IN SECUNDA FERIA CUIUSQUE EBDOMADĘ USQUE AD ADUENTUM DOMINI NISI FESTUM UEL UIGILIA INTERUENERIT; Mail von AP, 22. 1.: das Michaelsfest (29.9.) ist der Weihetag einer Michaelskirche nördlich von Rom. Daher ist es in manchen Hss. als Dedicatio Michahelis oder Dedicatio angeli rubriziert. Das kannst Du also einfach ignorieren und unter Michael aufführen. Die Feria secunda bezieht sich vermutlich auf den auf Alkuin zurückgehenden Zyklus von Votivmessen für die Wochentage. Das ist eine Sekundärverwendung, die es vermutlich auch anderswo gibt; nur dass sie dort nicht in der Rubrik zum 29.9. genannt wird, sondern irgendwo im Anhang bei den Votivmessen. Ich würde das ebenfalls ignorieren.</annot><annot startid="#m-30e784eb-c8a4-4ff4-9202-e6b073782f39" endid="#m-ef874571-659f-46a3-bec4-fed9b3ffba56"><table><tr><td><rend>[[uirtute qui]]</rend></td><td><rend>]</rend></td><td><rend>vermutlich korrigiert aus [[uirtutes quia]], regulär notiert.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pia-65"><bibl><identifier type="siglum">Pia 65</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pia 65-198b-6</identifier><title>Benedicite dominum</title><incip><incipText><p>Benedicite dominum</p></incipText></incip><contents><contentItem><locus from="198b">f. 198b, l. 6</locus></contentItem></contents><biblList><bibl>AMS 157</bibl><bibl type="printed-edition">II-4</bibl></biblList><classification><termList><term type="genre">Antiphon</term><term type="genre">Introitus</term><term type="feast">Michael</term><term type="feast">Messe</term><term type="Editor">Michael Klaper</term><term type="Endseite">198b</term><term type="Endzeile">11</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pia 65</identifier><identifier type="cantus">Pia 65</identifier><titleStmt><title>Pia 65</title></titleStmt><creation><geogName role="origin">Piacenza</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><corpName role="origin-institution">Kathedrale</corpName><date>12. Jh Ende</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tonar, Hymnar, Graduale, Kyriale, Tropar, Antiphonar</term></termList></classification><itemList><item><identifier type="shelfmark">65</identifier><physLoc><repository><geogName role="settlement">Piacenza</geogName><corpName>Biblioteca Capitolare</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-f4325279-7f9f-43cf-8a85-073cddafd952"><section xml:id="m-7b39e664-073e-4f8d-96c8-6c1a465401f5"/><section xml:id="m-89fae6b1-8dfe-404c-824b-8393935df