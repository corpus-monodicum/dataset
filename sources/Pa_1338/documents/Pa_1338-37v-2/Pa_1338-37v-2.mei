</rend></td></tr></table></annot><annot startid="#m-6dcc14b1-43fc-4835-9547-9b31a8fba465" endid="#m-a5541a30-5a39-4db8-b265-ec3c7bfb4949"><table><tr><td><rend>((orrea))</rend></td><td><rend>]</rend></td><td><rend>lies ((horrea)), korrigiert aus ((orea)).</rend></td></tr></table></annot><annot startid="#m-a88275af-d6d2-4500-b603-e115d8191443" endid="#m-dd8149a2-75a9-4832-8b08-0c71ab557e71" type="emendation"><table><tr><td><rend>((uoce)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((uoces))</rend></td></tr></table></annot><annot startid="#m-a37b96f6-31ff-47e2-8350-9bb1d312b4c0" endid="#m-c45dec00-c756-48ab-b10b-8d6d0a56e273"><table><tr><td><rend>((spreta))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((speta))</rend></td></tr></table></annot><annot startid="#m-006f4b4c-e539-4a47-81cd-7ea5aaadf4f7" endid="#m-1779009d-be7d-442d-8be8-bd334d1c1e83" type="emendation" corresp="#m-comment-22"><table><tr><td><ptr target="#m-comment-22-notes-0"/></td><td><rend>(wie 13b)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-22-notes-1"/></td></tr></table></annot><annot startid="#m-55c907a8-c013-4531-b613-98c6a241142b" endid="#m-59a9f42d-893a-4192-8919-5b33d6a18bca"><table><tr><td><rend>((donans))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((donas))</rend></td></tr></table></annot><annot startid="#m-8e0359dd-ff56-4a80-90d8-4ce14c8186b1" endid="#m-ccdead2f-ec38-4c13-b5fd-b06d8b63542a" type="emendation"><table><tr><td><rend>((gloriam)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((gloria))</rend></td></tr></table></annot><annot startid="#m-b95ae75d-4bd0-4f82-8cdf-2b86a06bdc9a" endid="#m-b95ae75d-4bd0-4f82-8cdf-2b86a06bdc9a"><table><tr><td><rend>((que))</rend></td><td><rend>]</rend></td><td><rend>die Konjektur ((quo)) in ((AH)) ist unnötig, da ((que)) auf ((regna)) oder ((collegia)) in 13b bezogen werden kann.</rend></td></tr></table></annot><annot startid="#m-436adfe0-1612-4757-a78a-fef46ad8a389" endid="#m-436adfe0-16