ischer Herkunft</geogName><date>11. Jh – 12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale mit Tropen und Sequenzen, Kyriale</term></termList></classification><itemList><item><identifier type="shelfmark">O.I.7</identifier><physLoc><repository><geogName role="settlement">Modena</geogName><corpName>Biblioteca Capitolare</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-549f69ff-a621-4d5f-948a-d3a121b67aed"><section xml:id="m-145852b5-e278-43ff-80b6-69de59518652"/><section xml:id="m-134dd06b-77d9-4e47-b866-fba2460ae8fc"/><section xml:id="m-da64bde1-8110-45c0-8c0d-ff3c39791b43"/><section xml:id="m-e979599a-7d71-4a8f-b508-4c36c1d253c4" label="62" type="Tropenelement"><sb xml:id="m-f5d441be-e5ab-4f1b-a5a6-fca5bac956e9"/><staff n="1"><layer n="1"><annot xml:id="m-be5cc515-8ded-4c17-bf1a-5d52c9e9da64" type="paratext" label="Festtag">IN DIE NATALIS D&lt;OMINI&gt; (f. 6v)</annot><annot xml:id="m-3659e36e-c91a-434e-9e74-8196ada2796f" type="paratext" label="Feier">&lt;STATIO AD SANCTUM&gt; PETRUM</annot><annot xml:id="m-b1d365ac-a2ce-4f9b-84f9-2eaf9410ae1c" type="paratext" label="Gesang">TROPHE</annot><syllable xml:id="m-be01af31-8ab0-4e95-8e48-da4823c3c93e"><syl wordpos="s">&lt;Quem</syl></syllable><syllable xml:id="m-a3c0dd20-fd1e-4c52-a004-1b604bb1b625"><syl wordpos="s">queritis</syl></syllable><syllable xml:id="m-f570aec5-ed96-4c1c-982a-557e8c5c6ef7"><syl wordpos="s">in</syl></syllable><syllable xml:id="m-a958f7af-eb0b-4363-b5b5-c055a9a0e600"><syl wordpos="i" con="d">pre-</syl></syllable><syllable xml:id="m-6aaaed93-e437-4bd8-9786-76a5d7c88d4e"><s