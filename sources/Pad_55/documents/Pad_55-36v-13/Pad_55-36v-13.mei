ier><titleStmt><title>Pad 55</title></titleStmt><creation><geogName role="origin">Padua</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><corpName role="origin-institution">Kathedrale Santa Maria Assunta</corpName><date>15. Jh Anfang</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Prozessionar mit liturgischen Spielen</term></termList></classification><itemList><item><identifier type="shelfmark">C 55</identifier><physLoc><repository><geogName role="settlement">Padua</geogName><corpName>Biblioteca Capitolare di Padova</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-ecb95a73-e6d0-492a-bf62-8bd81b19c15e"><section xml:id="m-c57cc72a-c002-4e0d-9c8b-80fd6b73c205"/><section xml:id="m-0cd8e86d-7b73-4674-b642-84b0d4ee632e"/><section xml:id="m-361709db-af7e-4f89-8a72-71375d388657"><section xml:id="m-4bc8cf7e-c03f-4b11-b1e7-3c0b33bde652"><section xml:id="m-fa49184e-c915-4904-a2f0-232b630467dd"><sb xml:id="m-59f34ea8-2e50-4fc7-b24c-292d4c575490"/><staff n="1"><layer n="1"><annot xml:id="m-a19f5387-4d18-4add-9032-f3f4c5a5808a" type="paratext" label="Festtag">IN DIE ANNUNTIATIONIS (f. 36v)</annot><annot xml:id="m-f9d1f498-219e-4421-ab69-df0116d9b23d" type="paratext" label="Aufführung">POST PRANDIUM HORA CONSUETA PULSETUR CAMPANA MAGNA
ET INTERIM CLERICI CONUENIANT AD ECCLESIAM
ET IN SACRISTIA MAIORI PREPARENT SE ALIQUI DE CLERICIS CUM PLUUIALIBUS ET ALIIS NECESSARIIS
ET IN DICTA SACRISTIA STENT MARIA HELISABET IOSEPH ET IOACHIM PREPARATI 
CUM DIACONO ET SUBDIACONO PORTANTES IN MANIBUS LIBROS ARGENTEOS
ET HORA DEBITA EXEANT PROCESSIONALITER DE SACRISTIA ET PERGANT AD LOCA EIS PREPARATA
HIIS DIMISSIS PROCESSIONALITER PERGANT AD BAPTISTERIUM
ET IBI STET PUER PREPARATUS IN MODUM GABRIELIS SUPER CATEDRAM
ET DE BAPTISTERIO ELEUETUR ET FERATUR IN ECCLESIA A LATERE PLATEE
ET PORTETUR SUPER SCALAM UERSUS CHORUM
ET CLERICI STENT PER MEDIUM ECCLESIE IN MODUM CHORI</annot><annot type="verweis">Jes 7, 10</annot><annot xml:id="m-f037ac1d-5aef-48b8-bae3-7e9fbfe1a19a" type="paratext" label="Aufführung">ET INTERIM SUBDIACONUS INCIPIAT </annot><annot xml:id="m-b71a98d6-5f13-4d57-b90f-7fdf317d43cd" type="paratext" label="Gesang">PROPHETIAM</annot><annot xml:id="m-849240ce-baf9-4f89-8d05-5698fbd33c06" type="paratext" label="Aufführung">SCILICET</annot><sb xml:id="m-23780574-38b1-4be3-8e57-e6f3c175e9d9" type="manuscriptLine"/><syllable xml:id="m-59a7c625-b4fd-4016-aeca-df99ce80cc64" type="withoutNotes"><syl wordpos="s">Locutus</syl><neume><nc xml:id="m-668ce69c-69f1-42c0-baee-4f08c9265720" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-aeea537c-231c-431f-9103-c9127fc7af07" type="withoutNotes"><syl wordpos="s">est</syl><neume><nc xml:id="m-47405976-a981-4085-8bfa-b033b9e67f6f" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-6fb1f791-ab0f-42ae-9442-ec7782e7cfa5" type="withoutNotes"><syl wordpos="s">dominus</syl><neume><nc xml:id="m-bdf7fca7-236f-451a-9a09-e0232e2911bb" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-3a42b93f-418e-4b87-adbb-ab3c12644f40" type="withoutNotes"><syl wordpos="s">ad</syl><neume><nc xml:id="m-db89f9b7-d57d-4400-833d-4c73b84f0473" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-6f8dc573-ada2-4907-84c9-b785db4c8da7" type="withoutNotes"><syl wordpos="s">Achaz</syl><neume><nc xml:id="m-0d7fdc2c-07fd-45ff-a834-b7c9bdc1f2fd" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-82974efe-d56e-4bf4-8dd4-1449cb289e99" type="withoutNotes"><syl wordpos="s">dicens</syl><neume><nc xml:id="m-f4b7bc2d-cd97-4652-90ee-c8beee81149d" pname="a" oct="4"/></neume></syllable></layer></staff></section></section></section></section></score></mdiv></body></music></mei>