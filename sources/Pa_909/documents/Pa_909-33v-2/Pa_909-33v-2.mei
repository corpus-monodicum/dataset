ium in ((Pa 909)) ist möglicherweise ein Irrtum des Schreibers.</rend></td></tr><tr><td><rend>((18^CM:)) elegisches Distichon;</rend></td></tr><tr><td><rend>((12, 11:)) Hexameter mit metrischen Fehlern.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-909"><bibl><identifier type="siglum">Pa 909</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 909-33v-2</identifier><title>Regi immortali</title><incip><incipText><p>Regi immortali</p></incipText></incip><contents><contentItem><locus from="33v">f. 33v, l. 2</locus></contentItem></contents><biblList><bibl>Ded off 18^CM 12 A 11 A 9 B 10 C 14 D 13 B (CT VIII)</bibl><bibl type="printed-edition">II-3</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Offertorium-Tropus</term><term type="feast">Dedicatio ecclesiae</term><term type="feast">Messe</term><term type="Editor">(unlisted editor)</term><term type="Bezugsgesang">Domine deus in simplificate</term><term type="Endseite">34</term><term type="Endzeile">1</term><term type="FestUndGattung">Ded off</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 909</identifier><titleStmt><title>Pa 909</title></titleStmt><creation><geogName role="origin">Limoges</geogName><geogName role="origin-region">Quellen französischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Martial, möglicherweise für Saint-Martin</corpName><date>11. Jh 1. Drittel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Mess- und Offiziumsgesänge, Sequentiar, Prosen, Prozessionar, Offertoriale, Tonar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 909</identifier><physLoc><r