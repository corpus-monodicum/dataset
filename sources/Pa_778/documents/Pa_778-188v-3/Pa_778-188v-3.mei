<?xml-model href="https://music-encoding.org/schema/5.0/mei-Neumes.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 778-188v-3</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/9fe27641-a693-41a5-93d6-2142914cc7ad</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-356ec62a-3df2-4362-9ba5-5c85b9ce8a0f" endid="#m-9bfcdd1a-26b8-4e08-87ab-ab6d270c0291" corresp="#m-comment-0"><table><tr><td><ptr target="#m-comment-0-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-0-notes-1"/></td><td><rend>(vermutlich ohne oder mit anderem Schlüssel), auf ((disserit loq-)) vermutlich mehrfach korrigiert.</rend></td></tr></table></annot><annot startid="#m-ac136738-9fd2-4142-a2e6-4719371bf6d0" endid="#m-14ea442f-bca7-428b-ad65-38076abff56b" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation teilweise mehrfach korrigiert, ausreichend erkennbar ist die 1a entsprechende Lesart:</rend></td><td><ptr target="#m-comment-1-notes-1"/></td></tr></table></annot><annot startid="#m-18f3eca1-47ab-4663-a45a-0e1a5ff11255" endid="#m-85679ec8-20c7-4810-adc5-abdbab5ab13a"><table><tr><td><rend>((Metum ... federis))</rend></td><td><rend>]</rend></td><td><rend>am unteren Rand (f. 188v-189) von anderer Hand nachgetragen (regulär rubriziert). Ob die Notation von derselben Hand stammt wie die korrigierte Notation des Haupttextes, ist unklar. Dafür würde sprechen, dass der Kustos am Ende von 1b auf 2a verweist, nicht auf 3a.</rend></td></tr></table></annot><annot startid="#m-9c6ad240-eaa2-4360-9a1f-0fe2c4cc7bc0" endid="#m-7c215fc9-b19e-4d89-8843-5b2a192786b1" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation korrigiert, vermutlich aus Lesart eine Stufe höher (Rasurspuren sind undeutlich).</rend></td></tr></table></annot><annot startid="#m-dbcb2b77-5292-410e-a1fd-e739ced5ab92" endid="#m-8b484bd9-621f-4a5b-87b8-5c626e12fa77" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation korrigiert, die Lesart vor Korrektur ist nur teilweise deutlich erkennbar, scheint aber durchgehend eine Stufe höher zu liegen.</rend></td></tr></table></annot><annot startid="#m-1efa9a8a-15b8-47a7-b229-ba9e6644f163" endid="#m-1efa9a8a-15b8-47a7-b229-ba9e6644f163"><table><tr><td><rend>((ne))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((nec))</rend></td></tr></table></annot><annot startid="#m-188c457b-360d-4b47-ab0c-9958f9a190bc" endid="#m-4f8ced6b-2ef8-4227-b8cf-c19975f206a7" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-6-notes-1"/></td><td><rend>(nur teilweise erkennbar); die ersten 4 Noten offenbar doppelt korrigiert, zusätzliche Lesart:</rend></td><td><ptr target="#m-comment-6-notes-2"/></td><td><rend>; der Rest der Strophe scheint frei von Korrekturen zu sein.</rend></td></tr></table></annot><annot startid="#m-a74e52bc-ae64-44fc-acdf-dedec0164221" endid="#m-57e59859-c7cb-44fc-bc9c-30e6b7462bb9"><table><tr><td><rend>((honus))</rend></td><td><rend>]</rend></td><td><rend>lies ((onus))</rend></td></tr></table></annot><annot startid="#m-3863789a-442c-4d4b-998c-31f2fef885e0" endid="#m-9b02aa8e-965e-4653-8f9e-c6784f6d6f50"><table><tr><td><rend>((audis))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((audit))</rend></td></tr></table></annot><annot startid="#m-4b079fb2-1554-4a0d-93a9-c4e9e622027e" endid="#m-d3571cff-ca08-4528-a6ca-b4e816555cbe" corresp="#m-comment-9"><table><tr><td><ptr target="#m-comment-9-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation korrigiert, Lesart vor Korrektur nur teilweise erkennbar:</rend></td><td><ptr target="#m-comment-9-notes-1"/></td><td><rend>; da die Position des Kustos vor Korrektur unklar ist, wurde die Lesart vor Korrektur so wiedergegeben, wie der Anschluss zu 1b nahe legt.</rend></td></tr></table></annot><annot startid="#m-f0961592-e704-4759-9dba-fd663cee3f00" endid="#m-fe4d5a58-a358-41d9-ad2f-8ecced35f04a" corresp="#m-comment-10"><table><tr><td><ptr target="#m-comment-10-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation korrigiert aus gleichlautender Lesart.</rend></td></tr></table></annot><annot startid="#m-4d39445a-3987-42ad-887a-92c0e25c38b9" endid="#m-2f76e5f9-5431-4b88-a125-9e79852d8bda" corresp="#m-comment-11"><table><tr><td><ptr target="#m-comment-11-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-11-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Notation ohne Schlüssel und farbige Linie, nur vor der 1. Zeile D-Schlüssel.
</rend></td></tr><tr><td><rend>Die umfangreichen Korrekturen machen den Eindruck, dass ein erster Notator nur die a-Strophen (außerdem 1b) notiert hatte, ein zweiter Notator diese Notation radierte und dann durch alle Strophen Notation eintrug. Der zweite Notator könnte auch für die Ergänzung des Strophenpaars 2a/b verantwortlich sein.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-778"><bibl><identifier type="siglum">Pa 778</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 778-188v-3</identifier><title>Missus Gabriel</title><incip><incipText><p>Missus Gabriel</p></incipText></incip><contents><contentItem><locus from="188v">f. 188v, l. 3</locus></contentItem></contents><biblList><bibl>AH 54, 192</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Beata Maria virgo</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">189v</term><term type="Endzeile">1</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 778</identifier><titleStmt><title>Pa 778</title></titleStmt><creation><geogName role="origin">Narbonne</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Kathedrale</corpName><date>12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 778</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-0d97fbee-0c88-447a-8b30-3be43a79343d"><section xml:id="m-4b6ba092-4ad9-4625-8202-5092b0db63c0"/><section xml:id="m-8fa6f142-3ff2-4a41-a615-22d5a761e115" label="1"><section xml:id="m-92c48451-a01d-4d52-816f-34cc38985a1e" label="a"><sb xml:id="m-c32b85eb-97a8-4f83-81c2-6e7aaea3a811"/><staff n="1"><layer n="1"><annot xml:id="m-496569bb-70e4-4315-8604-690209fd24f5" type="paratext" label="Gesang">PROSA</annot><annot xml:id="m-fff8714d-e9ac-471d-b719-9bd571cfa3f2" type="paratext" label="Festtag">BEATE MARIE (f. 188v) </annot><syllable xml:id="m-28f0a396-8dc5-41e9-973a-fe4436be8c73"><syl wordpos="i" con="d">Mis-</syl><neume><nc xml:id="m-356ec62a-3df2-4362-9ba5-5c85b9ce8a0f" pname="c" oct="4"/></neume></syllable><syllable xml:id="m-fc22a863-2267-4bae-a38f-56aa469124dc"><syl wordpos="t">svs</syl><neume><nc xml:id="m-d2fc2e0d-a440-40af-8778-0f09c510c1b2" pname="c" oct="4"/></neume></syllable><syllable xml:id="m-a9fec1a4-d024-447f-8ba2-be50dfe47b53"><syl wordpos="i" con="d">Ga-</syl><neume><nc xml:id="m-b9852134-6bfc-4078-980b-d42370b68a51" pname="d" oct="4"/></neume></syllable><syllable xml:id="m-2e57bcc3-7e62-4748-bd81-40d0e5e9bc88"><syl wordpos="m" con="d">bri-</syl><neume><nc xml:id="m-d1f1d202-3f65-4143-bf00-5bc64657f6b5" pname="d" oct="4"/></neume></syllable><syllable xml:id="m-069389df-9a3a-4d5b-87b7-7fe3c8461e89"><syl wordpos="t">el</syl><neume><nc xml:id="m-33421df9-cb31-4633-ac89-60237719326f" pname="d" oct="4"/></neume></syllable><syllable xml:id="m-647426ac-dcc4-4a32-bcb2-a58b516c1574"><syl wordpos="s">de</syl><neume><nc xml:id="m-a7fd8793-03fe-4cf5-a322-69e0bbb9d1d3" pname="c" oct="4"/></neume></syllable><syllable xml:id="m-ed44b80c-4dd3-47b0-b18f-9b28d453dde4"><syl wordpos="i" con="d">ce-</syl><neume><nc xml:id="m-b1561eb3-c7ab-498a-ab52-a0903c8c1947" pname="a" oct="3"/></neume></syllable><syllable xml:id="m-1bd9bfd2-49f0-42d2-9073-ba72d9285a63"><syl wordpos="t">lis</syl><neume><nc xml:id="m-c92c4a7d-02f8-46a7-9978-73d6de193197" pname="g" oct="3"/></neume></syllable></layer></staff><section xml:id="m-51492e13-04dd-4558-b606-e8b6279ff01e-line"><sb xml:id="m-51492e13-04dd-4558-b606-e8b6279ff01e"/><staff n="1"><layer n="1"><syllable xml:id="m-64f5540a-803e-4397-9d03-79857b13670c"><syl wordpos="i" con="d">uer-</syl><neume><nc xml:id="m-dbdafbbc-b8cd-4fe7-bc33-6f78b660870f" pname="c" oct="4"/></neume></syllable><syllable xml:id="m-810e9ec5-bde0-482f-9189-fcf50cdf9633"><syl wordpos="t">bi</syl><neume><nc xml:id="m-4e2c4768-8ea6-4c10-89dd-6ee6783fd78d" pname="c" oct="4"/></neume></syllable><syllable xml:id="m-54724768-ff7c-43b4-a7bb-abeb565dcf29"><syl wordpos="i" con="d">bai-</syl><neume><nc xml:id="m-9b469cd8-1222-42b0-95af-449d00d31f43" pname="d" oct="4"/></neume></syllable><syllable xml:id="m-10f1947e-f09b-467a-8cb0-4caa002d58a2"><syl wordpos="m" con="d">u-</syl><neume><nc xml:id="m-36f37626-ae69-4894-8073-8fa6d553e896" pname="d" oct="4"/><nc xml:id="m-7d7006dd-32b6-49bf-be67-1d47668dcbcf" pname="c" oct="4" con="g"/></neume></syllable><syllable xml:id="m-4bbd5efb-61cf-4f56-a4e7-b19c196ecca7"><syl wordpos="t">lus</syl><neume><nc xml:id="m-cda213f1-c489-42b8-8d3e-763901907324" pname="f" oct="4"/></neume></syllable><syllable xml:id="m-76dcb580-b0c9-4450-bce9-8ca639938ca2"><syl wordpos="i" con="d">fi-</syl><neume><nc xml:id="m-523bfd6a-cdd8-433f-a210-1a2edeb44347" pname="e" oct="4"/><nc xml:id="m-f34a4f7f-da64-4f11-8fd2-43f0b939e356" pname="d" oct="4" con="g"/><nc xml:id="m-f5f57433-2c35-45e8-a126-de751f283ffe" pname="c" oct="4" con="g"/></neume></syllable><syllable xml:id="m-2b0b3c42-05dc-4688-a685-4ec635eb5791"><syl wordpos="m" con="d">de-</syl><neume><nc xml:id="m-0353d90b-33a0-4f2d-8dca-729bebf580a0" pname="d" oct="4"/></neume></syllable><syllabl