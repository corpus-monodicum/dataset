aa58-d3544c451df1" endid="#m-a7d1992a-4856-4d45-b402-b2be5b2dad5c"><table><tr><td><rend>((propinaret))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((properaret))</rend></td></tr></table></annot><annot startid="#m-67167b26-0058-490d-a1f3-5acfc46d171e" endid="#m-d70decd5-5112-45ef-8353-09c8b55c8db7" type="emendation"><table><tr><td><rend>((meritis))</rend></td><td><rend>]</rend></td><td><rend>((meriti))</rend></td></tr></table></annot><annot startid="#m-3a1e6437-2d96-4378-aedf-782f42a42e80" endid="#m-76b484df-a5d4-4dd6-bffc-572d92f1d502" type="emendation"><table><tr><td><rend>((Constituens))</rend></td><td><rend>]</rend></td><td><rend>((Constitues))</rend></td></tr></table></annot><annot startid="#m-fdd551d3-697e-4fa2-afa0-e2987646919d" endid="#m-b69972a4-4896-4bee-98b1-1ae5d0e7d137"><table><tr><td><rend>((astris))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((castris))</rend></td></tr></table></annot><annot startid="#m-463f6c30-eb18-4879-a991-0ad18f9b5080" endid="#m-20174f82-5259-4d2c-a024-cefc4ccca116"><table><tr><td><rend>((Vt esset sa-))</rend></td><td><rend>]</rend></td><td><rend>Notation stellenweise schlecht lesbar.</rend></td></tr></table></annot><annot startid="#m-aa4d5f40-127e-4d7c-92f9-e6751c50d665" endid="#m-01198dfc-a3ab-4945-85f3-d92455916ace"><table><tr><td><rend>[[In]]</rend></td><td><rend>]</rend></td><td><rend>das notierte Melodieinzipit stimmt mit den übrigen Einsatzmarken nicht überein.</rend></td></tr></table></annot><annot startid="#m-d694d851-e4d0-4c7f-b121-67f2b664ce4b" endid="#m-321ce18f-92a1-49a7-8800-6c58b898c9df"><table><tr><td><rend>((-ge-))</rend></td><td><rend>]</rend></td><td><rend>Notation kaum lesbar.</rend></td></tr></table></annot><annot startid="#m-86fc4290-c593-4c60-ab78-eb35b6e4011b" endid="#m-92a08868-c2e7-47f1-beac-63c8d2accd34"><table><tr><td><rend>((Alme ... plebi))</rend></td><td><rend>]</rend></td><td><rend>In den übrigen aquitanischen Handschriften lautet dieses Element mit kleinen Varianten: ((Palma decoris velut lucet aether in ordine Phoebi)) (der schöne Palmzweig leuchtet wie die Luft in der Ordnung der Sonne). ((Apt 17)) korrigiert die metrischen Fehler (decoris, lūcet), der Text wird dabei aber unverständlich (in gütigem Licht den Chören wie die Luft in der Ordnung dem Volk).</rend></td></tr></table></annot><annot startid="#m-4da1f4ac-a617-492b-a16a-89521b3ac8b5" endid="#m-f575217e-5692-4db1-9009-2cd20743134c"><table><tr><td><rend>((imma))</rend></td><td><rend>]</rend></td><td><rend>lies ((ima))</rend></td></tr></table></annot><annot startid="#m-a3f4bb2e-b9f6-48b7-8738-c602265a7ab0" endid="#m-2ee06dfb-5475-4b31-8af5-ab13cf4fe608"><table><tr><td><rend>((fidei))</rend></td><td><rend>]</rend></td><td><rend>grammatikalisch plausibler: ((fide)) (wie ((CT X))).</rend></td></tr></table></annot><annot startid="#m-60f205d2-0605-4b39-b88a-707a05cb0161" endid="#m-7d688145-d94b-40f8-91a2-46ee4242f68d"><table><tr><td><rend>((sumus))</rend></td><td><rend>]</rend></td><td><rend>lies ((summus))</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>((65, 136, 67, 68, 109, 144, 110, 111, 46-49, 116, 58, 121, 122, 60, 3, 191, 192:)) Hexameter (((136)) mit metrischen Fehlern).</rend></td></tr><tr><td><rend>((34, 35, 145, 37:)) elegisches Distichon.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-apt-17"><bibl><identifier type="siglum">Apt 17</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Apt 17-328-4</identifier><title>Laetabunda per orbem</title><incip><incipText><p>Laetabunda per orbem</p></incipText></incip><contents><contentItem><locus from="328">f. 328, l. 4</locus></contentItem></contents><biblList><bibl>Statuit intr 108 A 65 A 136 C 67 D 68 E 104 A 105 C 106 D 107 E 109 A 144 C 110 D 111 E 34 A 35 C 145 D 37 E 46 A 47 C 48 D 49 E 147 A 113 C 114 D 115 E 148 A 1