y><geogName role="settlement">Padua</geogName><corpName>Biblioteca Capitolare di Padova</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-9fcccf22-d6f8-4f11-b572-3b87973069e5"><section xml:id="m-46caedb4-98fe-483f-b7ce-823ba75abc6c"/><section xml:id="m-cbe8d8e4-ebbe-450b-ab25-554cb4b3b928"><section xml:id="m-6cd624c5-8113-4103-8e7a-a1e2c1292cf4"><section xml:id="m-e1e333a3-ced7-43a1-893c-53481686c6d0"><sb xml:id="m-42306d4f-14c5-49fb-b5b6-7152e28291fc"/><staff n="1"><layer n="1"><annot xml:id="m-ae5f29be-db6e-4de4-b251-b0b5e84176e1" type="paratext" label="Festtag">IN DIE PURIFICATIONIS </annot><annot xml:id="m-39a8c75a-a5fa-422d-976e-0dd812ad9cd6" type="paratext" label="Aufführung">INMEDIATE POST PRANDIUM PULSETUR CANPANA MAGNA
ET INTERIM SCOLARES CONUENIANT AD ECCLESIAM
ET IN SACRISTIA MAIORI PREPARENT SE QUATUOR SACERDOTES IN MODUM PROPHETARUM 
ET DUO CLERICI CON DALMATICIS QUI CANTARE DEBENT</annot><sb xml:id="m-a7e6ef7e-5324-45c3-b7c7-5e687af35c43" type="manuscriptLine"/><syllable xml:id="m-1700292e-3cba-4f06-a39b-b1ea6f6cdb4e" type="withoutNotes"><syl wordpos="s">Aue</syl><neume><nc xml:id="m-44ec1bfe-968b-4814-a6e5-f1c31d539819" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-2e7e5647-5a2e-425e-8907-20ec5cbc8089" type="withoutNotes"><syl wordpos="s">gratia</syl><neume><nc xml:id="m-d59178ac-41cd-473c-a177-9d2006a608d3" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-aa7c81c5-8510-44d3-a128-ca226f30da2c" type="withoutNotes"><syl wordpos="s">plena</syl><neume><nc xml:id="m-b4cb60c3-097d-483a-9d29-498fb5c5f198" pname="a" oct="4"/></neume></syllable></layer></staff></section></section><section xml:id="m-22e2feeb-9423-4b72-a1e7-d328ac882189"><section xml:id="m-7fc1dab6-0877-4074-9d43-dd98d0bd914a"><sb xml:id="m-c42f3701-438f-495a-b6a2-2ada41ee8e66"/><staff n="1"><layer n="1"><annot xml:id="m-26285ca9-8dd8-4864-a8ad-e6242139bc7f" type="paratext" label="Aufführung">ET PREDICTI EXEANT CUM CRUCE CEREIS
ET ALIIS NECESSARIIS PROCESSIONALITER
ET PERGANT AD TEMPLUM PREPARATUM
POST ALTARE SANCTORUM FABIANI ET SEBASTIANI
POSTEA PROCESSIONALITER SACERDOTES ET CLERICI UADANT AD BAPTISTERIUM
ET IBI SINT DUO CLERICI PREPARATI IN MODUM ANGELORUM
ET ALTER PREPARATUS IN MODUM MARIE CUM PUERO IN ULNAS
IOSEPH ASOCIANTE CALATO PORTANTE SUPER HUMERUM
ET ALTER PREPARATUS || IN MODUM ANGELI SUPER CATHEDRAM (|| f. 15v)
ET POST MARIAM PERGIT ALTER CLERICUS PREPARATUS IN MODUM ANNE PROPHETISSE CUM CARTA MAGNA IN MANU
ET ITA PROCESSIONALITER EXEANT DE BAPTISTERIO A LATERE PLATEE
ET INTRENT ECCLESIAM ANGELIS CUM MARIA ET ANNA PRECEDENTIBUS
POST SEQUENTE ANGELO QUI EST SUPER CATHEDRAM 
PERUENTIS IN ECCLESIA POSTERIOR ANGELUS REMANEAT SUPER SCALAM UERSUS CHORUM
CUM DUOBUS CEREIS ET CRUCE
INTERIM SACERDOTES ET SCOLARES STENT PER MEDIUM ECCLESIE IN MODUM CHORI
ET MARIA CUM ANGELIS PRECEDENTIBUS
PUERO IN ULNIS PORTANTE PLANE PERGANT UERSUS TEMPLUM
ET INTERIM DUO PUERI QUI SUNT AD TEMPLUM INDUTI DALMATICIS
INCIPIANT CANTARE 
</annot><annot xml:id="m-eecc0938-d48f-45c5-a117-054e4dc356f6" type="paratext" label="Gesang">INFRASCRIPTAM ANTIPHONAM</annot><sb xml:id="m-5444989e-e8f5-4874-831e-85e1beeb2176" type="manuscriptLine"/><syllable xml:id="m-f64e330d-9854-459b-abc8-783d57396f4b"><syl wordpos="i" con="d">A-</syl><neume><nc xml:id="m-40ec34f3-6696-43d1-8e3e-60ae661d3141" pname="f" oct="4"/><nc xml:id="m-929521cd-fed6-4f82-9556-cea6797c6c1f" pname="c" oct="5"/></neume></syllable><syllable xml:id="m-d8e6335d-a4fe-468a-a360-c94e425f562b"><syl wordpos="t">ve</syl><neume><nc xml:id="m-41a5e272-3eb1-48c3-9014-71e46bdc9c8e" pname="a" oct="4"/></neume></syllable><syllable xml:id="m-15da198c-9d71-4265-9399-9e6bf1138474"><syl wordpos="i" con="d">gra-</syl><accid xml:id="m-00a1d931-8368-47de-b5de-4995e884c8df" accid="s" ploc="b" oloc="4"/><neume><nc xml:id="m-3ab2b2c6-15dd-4c77-b3c7-bddfcee1b06f" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-b990b370-41a9-40c7-8e20-425b62a5acf7"><syl wordpos="m" con="d">ci-</syl><neume><nc xml:id="m-1cb1e3f3-b9d0-4666-98ba-51be55695d18" pname="b" oct="4"/></neume></syllable><syllable xml:id="m-b79be691-22da-45c3-b8d3-b7d2c1c404f4"><syl wordpos="t">a</syl><neume><nc xml:id="m-631a0ce9-7bd4-40a6-b047-8eb44d7399b5" pname="c" oct="5"/></neume></syllable><syllable xml:id="m-060d5ef3-5817-4810-84b5-2eb0662fa278"><syl wordpos="i" con="d">ple-</syl><neume><nc xml:id="m-7d44bcb9-a2ba-4f53-9b01-86f4347d5ec5" pname="a" oct="4"/><nc xml:id="m-26e860d1-4503-4c03-b7e8-b71a04001671" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-ccd24cea-4192-4739-9565-2509fa2a4c81"><syl wordpos="t">na</syl><neume><nc xml:id="m-3695db7d-a313-4da6-812e-69dcc834a933" pname="f" oct="4"/></neume></syllable></layer></staff><section xml:id="m-841b6701-964a-432b-8af3-a302d1373572-line"><sb xml:id="m-841b6701-964a-432b-8af3-a302d1373572"/><staff n="1"><layer n="1"><syllable xml:id="m-203eace1-a541-4b2c-a25d-7a7ec10045e5"><syl wordpos="i" con="d">de-</syl><accid xml:id="m-8e629c39-ad