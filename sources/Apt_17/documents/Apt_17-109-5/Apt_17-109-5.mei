<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Apt 17-109-5</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/ad5e7e6b-9666-4c94-8492-e66ee7a6e3d4</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-cd643fc1-44a0-4d6d-9a9e-9f6df87a2245" endid="#m-4ee2b51e-5503-4377-8b61-60e40b95d01f"><table><tr><td><rend>((petamus))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((petimus))</rend></td></tr></table></annot><annot startid="#m-e23bec07-e512-4517-a4e0-acedafab9b87" endid="#m-f520ecc5-64b9-4245-b63e-17d89417bf94"><table><tr><td><rend>((quaeque))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((quae)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-52e0f2b0-1a67-48df-9bfe-391eef998daf" endid="#m-52e0f2b0-1a67-48df-9bfe-391eef998daf"><table><tr><td><rend>((Iam))</rend></td><td><rend>]</rend></td><td><rend>Dem Anschein nach schließt 3a unisonisch (((D))) an 2b an. Da der Notator von Apt 17 derartige Anschlüsse nicht konsequent mit Kustoden bezeichnet und eine graphisch korrekte Wiedergabe des Quartsprungs abwärts aus Platzgründen nicht möglich war, ist in der Edition die musikalisch sinnvollere Lesung gewählt, wonach die Melodie zwischen authentischem und plagalem Tonraum derselben Finalis wechselt.</rend></td></tr></table></annot><annot startid="#m-b39d0541-081e-45f8-81c1-14c961a1e844" endid="#m-97d05987-c5be-407e-aaa0-e66731e6d240" type="emendation" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>(wie 4a)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-3-notes-1"/></td><td><rend>der unisonische Anschluss zu 4b ist durch einen Kustos markiert.</rend></td></tr></table></annot><annot startid="#m-03f421f7-64a7-4805-b3ab-a2ed77a767cf" endid="#m-d3e28359-a824-4638-ab22-fc62cb691e44" type="emendation" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>(wie 4a)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-4-notes-1"/></td><td><rend>(Platzmangel).</rend></td></tr></table></annot><annot startid="#m-0e4d6f00-8a16-40c3-be0e-cdf76d82346a" endid="#m-0e4d6f00-8a16-40c3-be0e-cdf76d82346a"><table><tr><td><rend>((qui))</rend></td><td><rend>]</rend></td><td><rend>unter der Zeile zugefügt, regulär notiert.</rend></td></tr></table></annot><annot startid="#m-0cfbdb63-6eef-44b0-9c84-cf29f62b1098" endid="#m-c23c880b-c85a-424b-a12f-ce18c1bf1253"><table><tr><td><rend>((regem ae-))</rend></td><td><rend>]</rend></td><td><rend>Notation möglicherweise korrigiert, am Zeilenwechsel scheint der ursprüngliche Kustos auf ((F)) zu stehen, dann vermutlich korrigiert zu einem undeutlichen Kustos ((G)) oder ((a)). Die Edition orientiert sich an 4a und der textlosen Fassung.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-apt-17"><bibl><identifier type="siglum">Apt 17</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Apt 17-109-5</identifier><title>Haec est sancta sollemnitas cunctis</title><incip><incipText><p>Haec est sancta sollemnitas cunctis</p></incipText></incip><contents><contentItem><locus from="109">f. 109, l. 5</locus></contentItem></contents><biblList><bibl>AH 53, 240</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Auspicius</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">110</term><term type="Endzeile">10</term><term type="Melodie_Standard">Virgo plorans</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Apt 17</identifier><titleStmt><title>Apt 17</title></titleStmt><creation><geogName role="origin">Apt</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><date>11. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Prosar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 17</identifier><physLoc><repository><geogName role="settlement">Apt</geogName><corpName>Archive Basilique de Sainte Anne</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-ad1f628e-532c-4d44-a927-ea145e7cd0b4"><section xml:id="m-fa62dc53-f06d-474e-8706-016632dedc0a"/><section xml:id="m-6f21e26a-5cf6-47e2-a329-d103d713ce74"/><section xml:id="m-859e6341-84a1-4ed9-9777-dd3803ba61dc" label="1"><section xml:id="m-d2a77888-d2ff-4fa7-bfc5-93e4762df897" label="a"><sb xml:id="m-dd1d1928-8c23-47ba-b9a5-d2197412a580"/><staff n="1"><layer n="1"><annot xml:id="m-370045ab-850e-4cf6-b61f-7789f82c64aa" type="paratext" label="Festtag">&lt;NATALE SANCTI AVSPICII&gt;</annot><annot xml:id="m-9c234738-184a-473c-be39-21211807ebb8" type="paratext" label="Gesang">&lt;PROSA&gt; (p. 109)</annot><syllable xml:id="m-ded83663-487e-4633-9db7-bec04cdd3499"><syl wor