5f82cfb71a5"><table><tr><td><rend>((ens))</rend></td><td><rend>]</rend></td><td><rend>Rasur vor dem ersten Buchstaben, vermutlich korrigiert aus ((mens)).</rend></td></tr></table></annot><annot startid="#m-1e816d79-650c-4a13-ae9d-cf9dfbad3aa8" endid="#m-5e512ab8-b54b-4a6b-81ae-30df4226b3a9"><table><tr><td><rend>nunquam</rend></td><td><rend>]</rend></td><td><rend>formal plausibler: ((nunquam tamen)) (wie ((AH))); die textlose Fassung enthält die Töne für das in der textierten Fassung fehlende Wort.</rend></td></tr></table></annot><annot startid="#m-30ff62d3-d402-49d5-943a-2b3b09db6d96" endid="#m-9e3ce9f0-e968-4c1e-8b48-532c955cc98d"><table><tr><td><rend>((corporari))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-ri)) von späterer Hand auf Rasur.</rend></td></tr></table></annot><annot startid="#m-70831632-c134-44b2-be05-72ac4dbd568c" endid="#m-51deb039-abfa-4af1-8a9f-d42ce41e8ca2"><table><tr><td><rend>((tochos))</rend></td><td><rend>]</rend></td><td><rend>lies ((τοκος))</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ei-366"><bibl><identifier type="siglum">Ei 366</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ei 366-5-6a</identifier><title>Laetabundus exsultet</title><incip><incipText><p>Laetabundus exsultet</p></incipText></incip><contents><contentItem><locus from="5">f. 5, l. 6</locus></contentItem></contents><biblList><bibl>AH 54, 2</bibl><bibl type="printed-edition">CM III</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Octava nativitatis</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">6b</term><term type="Startposition">a</term><term type="Endzeile">5</term><term type="Melodie_Standard">–</term></termList></classification></work></workList><mani