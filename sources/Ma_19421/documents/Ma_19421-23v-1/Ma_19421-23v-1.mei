="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ma 19421-23v-1</identifier><title>Regnum ... Apostolorum</title><incip><incipText><p>Regnum ... Apostolorum</p></incipText></incip><contents><contentItem><locus from="23v">f. 23v, l. 1</locus></contentItem></contents><biblList><bibl>CT XII, 118</bibl></biblList><classification><termList><term type="genre">Gloria</term><term type="genre">tropiert</term><term type="feast">Messe</term><term type="Editor">David Hiley</term><term type="Endseite">23v</term><term type="Endzeile">4</term><term type="Melodiennummer_Katalog">Bosse 56</term><term type="Cantus_ID">509502</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ma 19421</identifier><titleStmt><title>Ma 19421</title></titleStmt><creation><geogName role="origin">Catania</geogName><geogName role="origin-region">Quellen normanno-sizilischer Herkunft</geogName><corpName role="origin-institution">Benediktinerkloster Sant’Agata</corpName><date>12. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 19421</identifier><physLoc><repository><geogName role="settlement">Madrid</geogName><corpName>Biblioteca Nacional</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-cd3d6cca-d04a-444b-a651-55f9140fdc5d"><section xml:id="m-b6d483ca-6406-4619-b018-afdd01c28878" label="118" type="Tropenelement"><sb xml:id="