<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Apt 17-104-2</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/28a120cf-afe5-4607-9ee8-070a115a86b4</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-3b9626a2-c18b-4268-8dbb-79411f5c65cc" endid="#m-635e5011-e25f-4ce9-a7e6-8b60971d55fd"><table><tr><td><rend>((eos))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((eosdem)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-6490d496-ab21-4121-93a2-2982ec08b8eb" endid="#m-7e2375f1-70e2-4d72-a23d-da40e0777b5e" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><rend>Zuordnung von Noten und Silben nach der horizontalen Anordnung; eine alternative Anordnung wird durch einen in der Notation eingefügten Trennstrich nahe gelegt:</rend></td><td><ptr target="#m-comment-1-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Diese Aufzeichnung weicht nur in 1a/b stark von der sonstigen Überlieferung ab. Die Melodie (((Iustus ut palma maior))) ist übertragen, wie sie in der Handschrift steht; sie moduliert um eine Stufe abwärts, d.h. ab 6a ist durchgehend ((b)) zu singen, ab 6b außerdem ((Es)). Eine Emendation im Sinne der Parallelüberlieferung wäre nur gewaltsam möglich. Vgl. ((Oramus te aeterna, Apt 17-73-8.))</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-apt-17"><bibl><identifier type="siglum">Apt 17</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Apt 17-104-2</identifier><title>Organicis ... qui in suis</title><incip><incipText><p>Organicis ... qui in suis</p></incipText></incip><contents><contentItem><locus from="104">f. 104, l. 2</locus></contentItem></contents><biblList><bibl>AH 53, 242</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Fabianus et Sebastianus</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">106</term><term type="Endzeile">2</term><term type="Melodie_Standard">Iustus ut palma maior</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Apt 17</identifier><identifier type="cantus">F-APT 17</identifier><titleStmt><title>Apt 17</title></titleStmt><creation><geogName role="origin">Apt</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><date>11. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Prosar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 17</identifier><physLoc><repository><geogName role="settlement">Apt</geogName><corpName>Archive Basilique de Sainte Anne</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-b57a1f22-e4e8-4572-b5a5-