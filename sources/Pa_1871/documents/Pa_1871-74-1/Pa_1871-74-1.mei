<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 1871-74-1</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/176c0dc7-51c7-4715-af10-0a6d01f75f30</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-4dfc3463-c234-4a26-969f-0c182e99406f" endid="#m-4dfc3463-c234-4a26-969f-0c182e99406f"><table><tr><td><rend>[[&lt;B&gt;enedici&lt;mus&gt;]]</rend></td><td><rend>]</rend></td><td><rend>Initiale radiert, offenbar um Platz für die Notation der vorangehenden Silbe zu schaffen.</rend></td></tr></table></annot><annot startid="#m-9c1aca3e-0802-43d1-a736-83d4b2644553" endid="#m-9ddca096-5b56-4f90-b732-856e1a5b8b64"><table><tr><td><rend>((manes))</rend></td><td><rend>]</rend></td><td><rend>in der Zeile ((canens)), korrigiert zu ((canes)), am Rand Maiuskel (M) offenbar als Korrektur.</rend></td></tr></table></annot><annot startid="#m-eda70472-9368-475f-a31d-ff760345b2d1" endid="#m-32093716-d017-4448-93d6-c9a9d7dda93d"><table><tr><td><rend>((sacrator mortis leto))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((sacrato mortis letum)) (wie ((CT XII))).</rend></td></tr></table></annot><annot startid="#m-938d59b5-9a60-48be-b002-2933dde74661" endid="#m-cd8a475b-4089-4d8e-9352-f4f8176639fb"><table><tr><td><rend>((te precamur))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((deprecamur)) (Maiuskel ((T)) am Rand).</rend></td></tr></table></annot><annot startid="#m-7e1ce962-625c-49ab-b3c9-b7bac62629b9" endid="#m-fb28310e-91ce-4380-ac0f-150c3900ff91" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation offenbar unvollständig und vermutlich diastematisch ungenau. Vgl. ((Laus tua deus Pa 1871-60-1)).</rend></td></tr></table></annot><annot startid="#m-d33a75a0-a504-4b3b-8fca-80b4ea3f5cc3" endid="#m-ab5c69ca-35c2-42db-9755-491f65c59654"><table><tr><td><rend>((celsi … Olimphi))</rend></td><td><rend>]</rend></td><td><rend>Notation auf Rasur, vermutlich zur Verdeutlichung der Diastematik.</rend></td></tr></table></annot><annot startid="#m-5be0eb2a-2f36-48b1-9783-a3704ab68e48" endid="#m-20055f99-21d5-44ef-83a8-22d3303b9795"><table><tr><td><rend>((Celorum))</rend></td><td><rend>]</rend></td><td><rend>Notation auf Rasur, vermutlich wegen der horizontalen Koordination.</rend></td></tr></table></annot><annot startid="#m-15131adb-3f5e-4735-8cd8-5ebea9d8ccc2" endid="#m-81f37b3a-96fc-49e5-a738-3cee28b53e9e"><table><tr><td><rend>((aeterne))</rend></td><td><rend>]</rend></td><td><rend>fehlende Initiale ((a)) von anderer Hand ergänzt.</rend></td></tr></table></annot><annot startid="#m-0b449c2d-a5df-4719-8bc7-88175675f906" endid="#m-911971f2-d476-4101-927a-8e023fac52ae"><table><tr><td><rend>((pium))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler, aber formal weniger plausibel: ((pontus)) (wie ((CT XII)) im Apparat).</rend></td></tr></table></annot><annot startid="#m-aa620fca-8c32-4b5e-865a-d60270548371" endid="#m-435c8621-c546-41c0-a411-ab8b9e2f5b37" corresp="#m-comment-9"><table><tr><td><ptr target="#m-comment-9-notes-0"/></td><td><rend>]</rend></td><td><rend>Zuordnung von Tönen und Silben nicht völlig klar.</rend></td></tr></table></annot><annot startid="#m-81a760f8-e3f8-44ff-b2bf-d61f6d5f45b8" endid="#m-84943241-9ddd-4991-8d23-39422cde4ac5"><table><tr><td><rend>((Quam decorasti))</rend></td><td><rend>]</rend></td><td><rend>Notation auf Rasur, offenbar wegen der Einpassung des Tonumfangs in den Schriftraum (am Beginn macht der Zusatz ((io(sum))) auf die graphische Verkürzung des Quintsprungs abwärts aufmerksam).</rend></td></tr></table></annot><annot startid="#m-689bcea8-0985-4d79-9aeb-020b1033fe16" endid="#m-9833facd-f88a-4368-b129-3491c0748d88" type="emendation"><table><tr><td><rend>((sanguine)) (wie ((CT XII)))</rend></td><td><rend>]</rend></td><td><rend>((sanguinis))</rend></td></tr></table></annot><annot startid="#m-afe7b421-2669-4848-816c-1fd73c0fa5cd" endid="#m-3c97d74b-aedf-4cf4-b766-5f1a04ee3582"><table><tr><td><rend>((factor))</rend></td><td><rend>]</rend></td><td><rend>unklare Korrektur an der Notation.</rend></td></tr></table></annot><annot startid="#m-4cca1786-ae64-4974-8a00-b83c0f681edd" endid="#m-31516857-174a-4e6a-bde8-f04911059034"><table><tr><td><rend>((†Christi … auctorem†))</rend></td><td><rend>]</rend></td><td><rend>vgl. die Konjektur in ((CT XII: Christe rex gratias indefessas agimus salutis auctori)).</rend></td></tr></table></annot><annot startid="#m-4fcdb84f-8588-4653-9a41-1b756cba4abd" endid="#m-4d411bb7-e891-4b76-8f3f-4799763b007c"><table><tr><td><rend>((†clauigior†))</rend></td><td><rend>]</rend></td><td><rend>Die nahe liegende Emendation zu ((clauiger)) (wie ((CT XII))) ist hier nicht möglich, da die Notation vier Silben voraussetzt.</rend></td></tr></table></annot><annot startid="#m-22e9bccd-a566-4cba-a873-3427ff394398" endid="#m-c6414f49-44a0-4854-8440-9d92f443070d"><table><tr><td><rend>((-pha-))</rend></td><td><rend>]</rend></td><td><rend>Notation auf Rasur.</rend></td></tr></table></annot><annot startid="#m-1608cc38-4028-4069-9555-70cb5c13c268" endid="#m-ef93d72c-c907-4cbe-bc3b-3129e2b6773d" corresp="#m-comment-16"><table><tr><td><ptr target="#m-comment-16-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-16-notes-1"/></td></tr></table></annot><annot startid="#m-cdd63956-14e2-4852-bb9d-5ce1b13d5bdc" endid="#m-6a0e1e2d-23ff-43f3-8c9c-80a8c94278f4" type="emendation" corresp="#m-comment-17"><table><tr><td><ptr target="#m-comment-17-notes-0"/></td><td><rend>(wie die folgende Parallelstelle)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-17-notes-1"/></td><td><rend>(alles Folgende eine Stufe höher).</rend></td></tr></table></annot><annot startid="#m-a6ea7645-ec33-4a2e-875e-05a6ef23de51" endid="#m-0d289397-163c-454f-8d4c-00d251d48608" corresp="#m-comment-18"><table><tr><td><ptr target="#m-comment-18-notes-0"/></td><td><rend>]</rend></td><td><rend>Der Vergleich mit ((Pa 1871-67-13)), Tropenelement R11 legt eine Emendation nahe:</rend></td><td><ptr target="#m-comment-18-notes-1"/></td><td><rend>, das würde aber die Korrespondenz zum vorangehenden textierten Abschnitt stören.</rend></td></tr></table></annot><annot startid="#m-9c1aca3e-0802-43d1-a736-83d4b2644553" endid="#m-0ca5fa00-0746-4da7-a837-ffc1aa61a8c0" corresp="#m-comment-19"><table><tr><td><ptr target="#m-comment-19-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation korrigiert, vermutlich aus</rend></td><td><ptr target="#m-comment-19-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Nachtrag. Die Notation verwendet keine Kustoden, ist daher an vielen Stellen nicht eindeutig. Auch innerhalb der Zeilen treten öfters Ungenauigkeiten in der vertikalen Anordnung auf, die im Folgenden nicht einzeln aufgeführt sind.</rend></td></tr><tr><td><rend>((1-6, 7:)) Hexameter (((2)) mit metrischen Fehlern).</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1871"><bibl><identifier type="siglum">Pa 1871</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1871-74-1</identifier><title>Rector ab arce</title><incip><incipText><p>Rector ab arce</p></incipText></incip><contents><contentItem><locus from="74">f. 74, l. 1</locus></contentItem></contents><biblList><bibl>CT XII, 87: 1 2 3 4 5 6 18 19 20 21 7 22 23 24 25 26 27 28 29 R12</bibl></biblList><classification><termList><term type="genre">Gloria</term><term type="genre">tropiert</term><term type="feast">Petrus et Paulus</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">74v</term><term type="Endzeile">7</term><term type="Melodiennummer_Katalog">Bosse 39</term><term type="Cantus_ID">509502</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1871</identifier><identifier type="cantus">Pa 1871</identifier><titleStmt><title>Pa 1871</title></titleStmt><creation><geogName role="origin">Moissac</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Pierre</corpName><date>11. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar, Prosar, Prosular</term></termList></classification><itemList><item><identifier type="shelfmark">Nouv. acq. lat. 1871</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList><relationList><relation rel="hasReproduction" target="https://gallica.bnf.fr/iiif/ark:/12148/btv1b85624659/manifest.json" label="IIIF manifest"/></relationList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-94b4c013-8915-4c03-8ed1-41677b86c2b7"><section xml:id="m-b299ab35-eca5-48e5-b061-b87e