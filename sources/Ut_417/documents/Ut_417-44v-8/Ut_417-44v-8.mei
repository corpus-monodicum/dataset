/></td><td><rend>]</rend></td><td><rend>zwischen den Silben Rasur auf Notationsebene (möglicherweise b-Akzidens).</rend></td></tr></table></annot><annot type="global-comment"><rend>((29, 30, 45, 32:)) Hexameter.</rend></annot></notesStmt><sourceDesc><source xml:id="wit-ut-417"><bibl><identifier type="siglum">Ut 417</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ut 417-44v-8</identifier><title>Summae tuum</title><incip><incipText><p>Summae tuum</p></incipText></incip><contents><contentItem><locus from="44v">f. 44v, l. 8</locus></contentItem></contents><biblList><bibl>Steph intr 29 A 30 B 45 C 32 D (CT I)</bibl><bibl type="printed-edition">II-2</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Introitus-Tropus</term><term type="feast">Stephanus</term><term type="feast">Messe</term><term type="Editor">Isabel Kraft</term><term type="Endseite">44v</term><term type="Endzeile">11</term><term type="FestUndGattung">Steph intr</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ut 417</identifier><titleStmt><title>Ut 417</title></titleStmt><creation><geogName role="origin">Utrecht</geogName><geogName role="origin-region">Quellen deutscher Herkunft</geogName><corpName role="origin-institution">Stift Sankt Marien</corpName><date>13. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Sequentiar, Tropar, Kyriale mit Tropen</term></termList></classification><itemList><item><identifier type="shelfmark">417</identifier><physLoc><repository><geogName role="settlement">Utrecht</geogName><corpName>Universiteitsbibliotheek</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change i