able><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-3-notes-1"/></td></tr></table></annot><annot startid="#m-87acf279-b3c8-41e4-b6da-bd63030e8ac6" endid="#m-034cd914-7afa-41cc-8122-b089baf193bb"><table><tr><td><rend>((ympnisemus))</rend></td><td><rend>]</rend></td><td><rend>lies ((hymnizemus))</rend></td></tr></table></annot><annot startid="#m-e4d55d41-5b01-4e1f-9a4e-fd96f901ce2c" endid="#m-db733b5a-cf45-45a7-914a-d6e98096f92b"><table><tr><td><rend>((Gratuletur))</rend></td><td><rend>]</rend></td><td><rend>Initiale nicht ausgeführt, Repräsentant ist jedoch vorhanden.</rend></td></tr></table></annot><annot startid="#m-e9036b80-7935-4bc1-b3b6-585a8ed183c9" endid="#m-e9036b80-7935-4bc1-b3b6-585a8ed183c9" type="emendation" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-6-notes-1"/></td></tr></table></annot><annot startid="#m-7a2619ba-d770-410e-ac4b-1f5226d2aae9" endid="#m-7a2619ba-d770-410e-ac4b-1f5226d2aae9" type="emendation" corresp="#m-comment-7"><table><tr><td><ptr target="#m-comment-7-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-7-notes-1"/></td></tr></table></annot><annot startid="#m-1d0e25ef-9c19-4cf5-be97-588871b57cc5" endid="#m-3fe86ce1-419a-40ac-84d8-e16a7e483d08" corresp="#m-comment-8"><table><tr><td><ptr target="#m-comment-8-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-8-notes-1"/></td></tr></table></annot><annot startid="#m-c4538ed1-61c7-4b9c-94d4-d9783ca94e92" endid="#m-712c2696-31a0-46bb-b074-857d7bb9ddad" type="emendation" corresp="#m-comment-9"><table><tr><td><ptr target="#m-comment-9-notes-0"/></td><td><rend>(wie 3a)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-9-notes-1"/></td></tr></table></annot><annot startid="#m-c4538ed1-61c7-4b9c-94d4-d9783ca94e92" endid="#m-aeea6949-beb9-44d0-ad93-ac0234294640"><table><tr><td><rend>((fatuarum))</rend></td><td><rend>]</rend></td><td><rend>Zuordung der Töne unklar, die Edition orientiert sic an 3a; Rasur zweier Noten ((a)) auf den Silben ((tu-a)) oder ((a-rum)) (nicht klar).</rend></td></tr></table></annot><annot startid="#m-5dffba05-7acf-46e8-9b98-fa55f6db242b" endid="#m-81981023-264e-440e-91e2-f2a5aaa183ad" type="emendation" corresp="#m-comment-11"><table><tr><td><ptr target="#m-comment-11-notes-0"/></td><td><rend>(wie 6a)</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-11-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Nachtrag; Der nur hier auftretende Notator hat deutliche Schwächen: Die Gruppierung der Noten und ihre Zuordnung zu den Silben ist öfters mehrdeutig, v.a. bei Climacus-Graphien, und die Tonhöhe von Noten unter der untersten Linie bleibt stellenweise unklar.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-scan-7"><bibl><identifier type="siglum">SCan 7</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>SCan 7-295-6</identifier><title>Gratuletur orbis totus</title><incip><incipText><p>Gratuletur orbis totus</p></incipText></incip><contents><contentItem><locus from="295">f. 295, l. 6</locus></contentItem></contents><biblList><bibl>AH 55, 232</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Margareta</term><term type="feast">Messe</term><term type="Editor">Gionata Brusa</term><term type="Endseite">296</term><term type="Endzeile">6</term><term type="Melodie_Standard">-</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">SCan 7</identifier><identifier type="cantus">SCan 7</identifier><titleStmt><title>SCan 7</title></titleStmt><creation><geogNam