id="#m-12b76986-67fa-4f62-8955-030736515d99" endid="#m-045866f8-31a3-471f-a00c-5d9ae7d94079"><table><tr><td><rend>((fecundata))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur, Lesart vor Korrektur möglicherweise ((benedicta)).</rend></td></tr></table></annot><annot startid="#m-483b6544-7092-4a7a-9e2b-9fb7609a823e" endid="#m-eb3e9c88-974f-41c8-8a94-5fce68f3a74e"><table><tr><td><rend>((Cui))</rend></td><td><rend>]</rend></td><td><rend>Initiale auf Rasur, Lesart vor Korrektur möglicherweise ((Sui)).</rend></td></tr></table></annot><annot startid="#m-2b5ec61d-4ad7-493a-bf00-36660d64e282" endid="#m-49d05323-1438-4bc3-adaf-ba2c154ccbc3"><table><tr><td><rend>((fies))</rend></td><td><rend>]</rend></td><td><rend>zwischen 2. und 3. Buchstaben Rasur, Lesart vor Korrektur könnte ((fides)) gewesen sein.</rend></td></tr></table></annot><annot startid="#m-cbe8e45d-1843-4032-8f13-5b37bfaf2390" endid="#m-994c20cb-e51c-459a-81bb-e9503da5de5c"><table><tr><td><rend>((ethera))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((etherea)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-d752a2ac-8958-41b9-b810-ef584bfbcae3" endid="#m-3ffda2db-0e4e-4188-8970-fe485cabe8b0"><table><tr><td><rend>((qui et))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((q?))</rend></td></tr></table></annot><annot startid="#m-70f45700-8c6c-4987-9bb5-59116d8f66b6" endid="#m-e6aba458-0779-4be0-93a5-c50ff1585153"><table><tr><td><rend>((Mariam))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((Maria))</rend></td></tr></table></annot><annot startid="#m-49a2c9e8-be4d-485b-b00d-f7786ee4cae4" endid="#m-64095b4c-8deb-4ba6-a7ff-b3c2b5db05ee"><table><tr><td><rend>((aphata))</rend></td><td><rend>]</rend></td><td><rend>lies ((affata))</rend></td></tr></table></annot><annot startid="#m-e6e03070-2200-4c83-82f4-9048aed7ddce" endid="#m-dae9a9fb-96bf-4bbd-97f0-4ab0a5e1458b"><table><tr><td><rend>((nullam ... copulam))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((nulla ... copula))</rend></td></tr></table></annot><annot startid="#m-dbcf65c7-26b8-4118-bb25-4e9550714ab6" endid="#m-31a20feb-083a-4e13-9e06-376419411a24"><table><tr><td><rend>((celo terre))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((celi terra))</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Strophe 1 ohne Schlüssel, aber durch einen Kustos mit dem Folgenden verknüpft, danach Notation mit Schlüsseln. Die reguläre Schlüsselung mit vier Buchstaben am Rand ist bis f. 73v, Zeile 3 so, dass die Melodie eine Terz höher steht als ediert (f. 73v, Zeile 1-3 stehen die Schlüsselbuchstaben auf Rasur). In den meisten Zeilen ist diese durch einen zugefügten F-Schlüssel korrigiert, die Korrektur fehlt f. 73, Zeile 8. Kustoden sind durchgehend vorhanden.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-778"><bibl><identifier type="siglum">Pa 778</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 778-73-5</identifier><title>Hac clara die</title><incip><incipText><p>Hac clara die</p></incipText></incip><contents><contentItem><locus from="73">f. 73, l. 5</locus></contentItem></contents><biblList><bibl>AH 53, 98</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Purificatio Mariae</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">73v</term><term type="Endzeile">9</term><term type="Melodie_Standard">Post partum</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 778</identifier><identifier type="cantus">Pa 778</identifier><titleStmt><title>Pa 778</title></titleStmt><creation><geogName role="origin">Narbonne</geogName><geogName role="origin-region">Quel