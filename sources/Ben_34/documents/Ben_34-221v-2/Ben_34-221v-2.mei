-b720-f68daf238251" endid="#m-b37e93b4-8f4e-454c-9fc9-d7e9bf8aae52" type="emendation"><table><tr><td><rend>((Ianua)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((Ianuam))</rend></td></tr></table></annot><annot startid="#m-1735f27d-dea4-47b3-9f69-e3688012f474" endid="#m-ff151775-b5e7-4378-b197-baefe4b8ea2c" type="emendation"><table><tr><td><rend>((fertilisque)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((fertilique))</rend></td></tr></table></annot><annot startid="#m-9aa415d1-3ecd-4f8a-bee3-c2e4e96f7d0b" endid="#m-d4375ccb-f8f6-4761-b466-9698003ecff4" type="emendation"><table><tr><td><rend>((sponsa))</rend></td><td><rend>]</rend></td><td><rend>((sponsam)). ((AH)) folgt ((Ben 35)) mit dem sicherlich ursprünglicheren Text: ((Nunc clamat sponsus O dilecta ueni propera mea)). In ((Ben 34)) ist jedoch die Umkehrung so konsequent durchgeführt, dass der hier edierte Text wohl dem Verständnis des Schreibers entspricht.</rend></td></tr></table></annot><annot startid="#m-828b91c6-2411-482a-9de5-ed3639883ae2" endid="#m-a53ce044-a898-4110-8712-6b5134b819cc" type="emendation"><table><tr><td><rend>((decliuis)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((decliuit))</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a'</rend></td><td><rend>a'</rend></td><td><rend>a'</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td></tr><tr><td><rend>1A</rend></td><td><rend>1B</rend></td><td><rend>1C</rend></td><td><rend>2A</rend></td><td><rend>2C</rend></td><td><rend>2B</rend></td><td><rend>3A</rend></td><td><rend>3B</rend></td><td><rend>3C</rend></td></tr></table></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ben-34"><bibl><identifier type="siglum">Ben 34</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application ver