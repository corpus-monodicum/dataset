otation bleiben, ist unklar, wie die Melodie an die veränderte Zahl von Silben angepasst werden soll.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1871"><bibl><identifier type="siglum">Pa 1871</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1871-12v-5</identifier><title>Martyrii viam</title><incip><incipText><p>Martyrii viam</p></incipText></incip><contents><contentItem><locus from="12v">f. 12v, l. 5</locus></contentItem></contents><biblList><bibl>Posuisti off 21 A B 5 C (CT X)</bibl><bibl type="printed-edition">II-3</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Offertorium-Tropus</term><term type="feast">Vincentius</term><term type="feast">Messe</term><term type="Editor">David Catalunya</term><term type="Bezugsgesang">(Posuisti)</term><term type="Endseite">12v</term><term type="Endzeile">7</term><term type="FestUndGattung">Posuisti off</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1871</identifier><titleStmt><title>Pa 1871</title></titleStmt><creation><geogName role="origin">Moissac</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Pierre</corpName><date>11. Jh 2. Hälfte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar, Prosar, Prosular</term></termList></classification><itemList><item><identifier type="shelfmark">Nouv. acq. lat. 1871</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="202