<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Ma 20-4-105v-12b</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/177031b4-fc33-470e-a1a4-eb1dad7d1b31</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Spiele)</resp><persName>Elaine Stratton Hild</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-25b2deb9-539d-4dad-8b45-30eefc9558eb" endid="#m-fff8f62f-e94a-4701-8c0d-7a0b3e5a2a0a"><table><tr><td><rend>((Tertia ... sunt))</rend></td><td><rend>]</rend></td><td><rend>((Tertia dies)) ist in vielen Tonaren eine Modellantiphon des dritten Modus (siehe [[Huglo]] ((1971, S. 323 und 337))). 
Der Inhalt des Textes passt später im Dialog nach ((et quomodo tradiderunt …));  möglicherweise singt der Chor die Antiphon am Beginn als eine Art Ankündigung des Datums für den folgenden Dialog. 
Quellen der Antiphonen sind aufgelistet in [[Rankin]] ((1989, Bd. 1, S. 217-227.))</rend></td></tr></table></annot><annot startid="#m-f2b3c3ff-b93e-4b65-aa57-40c7cf1d74a9" endid="#m-2c8eab47-2cfc-434d-bc6a-28676a091e27" type="emendation"><table><tr><td><rend>((| hęc))</rend></td><td><rend>]</rend></td><td><rend>((e- | hęc)), die 1. Silbe o.N.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ma-20-4"><bibl><identifier type="siglum">Ma 20-4</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ma 20-4-105v-12b</identifier><title>Tertia dies est</title><incip><incipText><p>Tertia dies est</p></incipText></incip><contents><contentItem><locus from="105v">f. 105v, l. 12</locus></contentItem></contents><biblList><bibl type="printed-edition">CM V-1</bibl></biblList><classification><termList><term type="genre">Spiele-Passus</term><term type="feast">Pascha; Feria II post Pascha</term><term type="feast">Vesper</term><term type="Editor">Elaine Stratton Hild</term><term type="Endseite">105v</term><term type="Startposition">b</term><term type="Referenz_auf_Spiel">Ma 20-4-105v-3S</term><term type="Endzeile">13</term><term type="SpielName">Journey to Emmaus</term><term type="Band_Genre">Spiele</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ma 20-4</identifier><titleStmt><title>Ma 20-4</title></titleStmt><creation><geogName role="origin">Palermo</geogName><geogName role="origin-region">Quellen normanno-sizilischer Herkunft</geogName><corpName role="origin-institution">Kathedrale</corpName><date>12. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale</term></termList></classification><itemList><item><identifier type="shelfmark">Vitrina a 20-4</identifier><physLoc><repository>