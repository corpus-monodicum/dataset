ic))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((hii)) (?)</rend></td></tr></table></annot><annot startid="#m-3baf1256-c84b-49a1-b612-f8ddfd37784b" endid="#m-ca6cd0c1-214c-4f05-8691-3de5925cdf32" type="emendation"><table><tr><td><rend>[[Christeleison]]</rend></td><td><rend>]</rend></td><td><rend>[[Christe eleison]], das zweite [[e-]] o.N.</rend></td></tr></table></annot><annot startid="#m-a882aae0-a15f-4d67-98ba-0fa2e3701a72" endid="#m-9a38f4af-c1eb-42ee-8acd-f481b804ae19" type="emendation"><table><tr><td><rend>((Celicis)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((Celici))</rend></td></tr></table></annot><annot startid="#m-17a8126f-0e57-402d-916c-4e7901385814" endid="#m-b8804b57-c4e0-4b37-b60b-c023b01c1fac"><table><tr><td><rend>((sufragari))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-ri)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-7b19d4d9-ebbd-4612-b872-22b0219f142b" endid="#m-36f6e4a3-ba7b-4b58-b4d8-4c63a9ed99e6"><table><tr><td><rend>((tuis))</rend></td><td><rend>]</rend></td><td><rend>semantisch plausibler: ((suis)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-873386b9-2541-492b-9fc9-449506428af9" endid="#m-73ba73fd-4eea-4ab7-8e04-65f858528774"><table><tr><td><rend>((paraclitus))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((paraclitus paraclitus)), regulär notiert.</rend></td></tr></table></annot><annot startid="#m-ca55e4c3-47ae-478e-aebc-373a900fa285" endid="#m-f3c018ef-0894-4758-b19f-c7f2c69cadfb"><table><tr><td><rend>((Christe))</rend></td><td><rend>]</rend></td><td><rend>über der Zeile zugefügt, regulär notiert.</rend></td></tr></table></annot><annot startid="#m-6cd7e4f7-8a09-48d6-8196-4a0b53f574b7" endid="#m-ddc224e4-a66c-4b6c-9db8-482dfe920ccd"><table><tr><td><rend>((Tuque ... cun-))</rend></td><td><rend>]</rend></td><td><rend>Notation radiert und (gleichlautend) nach oben versetzt (wegen Platzmangels bei ((Christe eleison))).</rend></td></tr></table></an