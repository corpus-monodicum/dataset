<rend>Der Vers [[In mente abete]] (E) ist textlich identisch mit dem Tropenelement ((Fer II intr 29)), wird aber auf das Psalmtonmodell gesungen und ist daher als Versus ad repetendum einzuordnen.</rend></td></tr><tr><td><rend>Elemente 36, 37 und 38 radiert, aber teilweise lesbar.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-mod-7"><bibl><identifier type="siglum">Mod 7</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Mod 7-110-11</identifier><title>Cunctipotens Christus</title><incip><incipText><p>Cunctipotens Christus</p></incipText></incip><contents><contentItem><locus from="110">f. 110, l. 11</locus></contentItem></contents><biblList><bibl>Fer II intr 35 A 36 B 37 C 38 D E F (CT III)</bibl><bibl type="printed-edition">II-4</bibl></biblList><classification><termList><term type="genre">Tropus</term><term type="genre">Introitus-Tropus</term><term type="feast">Feria II post Pascha</term><term type="feast">Messe</term><term type="Editor">Michael Klaper</term><term type="Bezugsgesang">Introduxit</term><term type="Endseite">110v</term><term type="Endzeile">5</term><term type="FestUndGattung">Fer II intr</term><term type="Band_Genre">Tropus</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Mod 7</identifier><identifier type="cantus">Mod 7</identifier><titleStmt><title>Mod 7</title></titleStmt><creation><geogName role="origin">Forlimpopoli</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><date>11. Jh – 12. Jh</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Graduale mit Tropen und Sequenzen, Kyriale</term></termList></classification><itemList><item><identifier type="shelfmark">O.I.7</identifier><physLoc><repository><geogName role="settlemen