)); da die Lesart vor Korrektur nicht radiert ist, könnte ((celsaque cum lira)) auch als Alternativlesart gemeint sein.</rend></td></tr></table></annot><annot startid="#m-b46956cd-2ebc-41ba-9b55-f943e5ce5baa" endid="#m-b46956cd-2ebc-41ba-9b55-f943e5ce5baa"><table><tr><td><rend>((nam))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur.</rend></td></tr></table></annot><annot startid="#m-093d266a-01bb-4d6b-80bd-d26d9933090d" endid="#m-84241dab-61b4-4a22-b5c6-2596b12b18fa"><table><tr><td><rend>((agmina ... organa))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur.</rend></td></tr></table></annot><annot startid="#m-f5a2a418-d893-4846-85a9-d1fca903a2ad" endid="#m-5079dde5-3e99-4aa8-ad11-f4c1721e73fb"><table><tr><td><rend>((armonia))</rend></td><td><rend>]</rend></td><td><rend>lies ((harmonia))</rend></td></tr></table></annot><annot startid="#m-86a8d40c-451a-429d-a9b6-f97f89145f13" endid="#m-08a2a239-6df3-47a6-b057-b3682f8558cb"><table><tr><td><rend>((friuola))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-iuola)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-2438a1dc-90c5-47c1-a05f-b7e597db9ec1" endid="#m-1067d232-91f8-4093-8e4c-125d5db1759a" type="emendation"><table><tr><td><rend>((Sticea))</rend></td><td><rend>]</rend></td><td><rend>((ticea)), lies ((Stygea)) (wie ((AH))).</rend></td></tr></table></annot><annot startid="#m-d3dd2a62-202a-407b-b98f-b475eaa190b2" endid="#m-828f90a1-5e10-469f-9d2c-b9ff7d242781"><table><tr><td><rend>((redemptvm))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-vm)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-d75737b3-2be5-4b35-90c4-840153f6c23a" endid="#m-5417031b-17a6-49e5-9a33-d4ec258797ad"><table><tr><td><rend>((amplvm))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-vm)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-cb2509f5-18e4-436b-9859-c3372ca4b1d7" endid="#m-a058d3df-83bb-45ba-b1da-642ca2581099"><table><tr><td><rend>((himo))</rend></td><td><rend>]</rend></td><td><rend>Buchstabe ((h-)) über der Zeile zugefügt, Buchstabe ((-o)) auf Rasur, lies ((imo)).</rend></td></tr></table></annot><annot startid="#m-8ad03434-cda1-4562-9f9d-b321e27b6074" endid="#m-1cd8a345-db98-42f8-8f97-ae2d5785851a"><table><tr><td><rend>((claustro))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((claustra))</rend></td></tr></table></annot><annot startid="#m-4deeff5e-e55e-45ee-91bc-447ed213383c" endid="#m-d6fa3d39-bef1-4834-b4cb-8053461ccd1a"><table><tr><td><rend>((beata))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((talia)); da die Lesart vor Korrektur nicht radiert ist, könnte ((beata)) auch als Alternativlesart gemeint sein.</rend></td></tr></table></annot><annot startid="#m-aa85f4e0-ec1f-42aa-8378-f162b1801d8b" endid="#m-1941e26e-915c-4836-b7dc-a98b287c8b38"><table><tr><td><rend>((absorta))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((aborta)), lies ((absorpta)).</rend></td></tr></table></annot><annot startid="#m-3797542d-6364-4fc2-9294-72edce86e284" endid="#m-1016d814-094c-4756-823e-18a848afd063"><table><tr><td><rend>((Galelea))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((Galeleam)), lies ((Galilaea)).</rend></td></tr></table></annot><annot startid="#m-3e5a9812-8d36-42d1-b27c-61c9d6fdb305" endid="#m-450c7578-4baa-42fd-a072-e634f5640b1e" type="emendation"><table><tr><td><rend>((anastasi)) (wie ((AH)))</rend></td><td><rend>]</rend></td><td><rend>((anastasim))</rend></td></tr></table></annot><annot startid="#m-273ddec4-c3af-4b90-b19f-fa88248b1329" endid="#m-d70d316c-e2af-4c6b-b8da-cacadf266ced"><table><tr><td><rend>((diuina))</rend></td><td><rend>]</rend></td><td><rend>über der Zeile zugefügt, regulär notiert.</rend></td></tr></table></annot><annot startid="#m-65f45b82-1db4-4c57-b4c8-e6db1662744b" endid="#m-919db5ee-28c5-49fc-89d7-a46f1d28af58"><table><tr><td><rend>((doctrina))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-octrina)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-f0b48910-ddee-47f0-ab40-70e72c7909f0" endid="#m-2fca1feb-d3f4-49f9-baa5-7df819c12c30"><table><tr><td><rend>((collegium))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-um)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-e72e0d15-3ea5-4b71-8005-debcc767abae" endid="#m-27c39f0b-5f49-4984-9847-0a7af7dc3c43"><table><tr><td><rend>((adest))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur; von der Lesart vor Korrektur ist am Ende ((ac)) lesbar, zu dieser Silbe hat vermutlich eine nicht mehr erkennbare Note ((G)) gehört.</rend></td></tr></table></annot><annot startid="#m-8f6033c8-b398-4dcd-bfa4-d4bed82e05f0" endid="#m-386a1411-af45-4ef5-a177-39c27183dd99"><table><tr><td><rend>((diuina per))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-uina per)) auf Rasur.</rend></td></tr></table></annot><annot startid="#m-8f6033c8-b398-4dcd-bfa4-d4bed82e05f0" endid="#m-8f6033c8-b398-4dcd-bfa4-d4bed82e05f0" corresp="#m-comment-23"><table><tr><td><ptr target="#m-comment-23-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation fehlt, die Tonhöhe ist jedoch durch den von ((G)) zu ((a)) korrigierten Kustos angegeben.</rend></td></tr></table></annot><annot startid="#m-5ad4e085-0b05-4056-a671-39461b26bc24" endid="#m-0dc382d4-de72-41c9-961c-3c4922727c60"><table><tr><td><rend>((nefas hoc in))</rend></td><td><rend>]</rend></td><td><rend>Text teils auf Rasur, teils über der Zeile.</rend></td></tr></table></annot><annot startid="#m-15a1d9ea-a242-4313-a311-b837434daae0" endid="#m-5ad4e085-0b05-4056-a671-39461b26bc24" corresp="#m-comment-25"><table><tr><td><ptr target="#m-comment-25-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-25-notes-1"/></td></tr></table></annot><annot startid="#m-0afa194b-1af1-4c69-a0e4-2d816debd5a7" endid="#m-b0628d58-64f8-4c17-bf14-04f888194e94" corresp="#m-comment-26"><table><tr><td><ptr target="#m-comment-26-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation korrigiert, von der Lesart vor Korrektur sind nur die letzten beiden (gleichlautenden) Noten erkennbar.</rend></td></tr></table></annot><annot startid="#m-db159d35-05ad-462d-9124-7682a67a62c3" endid="#m-b0628d58-64f8-4c17-bf14-04f888194e94"><table><tr><td><rend>((iam adest ... pascha))</rend></td><td><rend>]</rend></td><td><rend>Der Text ist stark korrigiert, die Indizien passen zu der Annahme, dass vor Korrektur eine Lesart stand, die der von ((Apt 17-156-1)) entsprach: ((iam decus at dindima mundi climata abolitum est adletim pascha)) (ähnlich ((Pa 778-81v-5))).</rend></td></tr></table></annot><annot startid="#m-91c5e318-efc2-4f3a-b358-ed65281d8bbe" endid="#m-6a26aef2-cad4-4f95-9159-a075e1692e3c"><table><tr><td><rend>((sonetque lira))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-etque lira)) auf Rasur, von der Lesart vor Korrektur ist die letzte Silbe ((-la)) erkennbar.</rend></td></tr></table></annot><annot startid="#m-f977b0ad-ee05-48b2-8d83-facc0a76ca59" endid="#m-5f335062-3483-4adb-9350-38e0acb16be5"><table><tr><td><rend>((hodas))</rend></td><td><rend>]</rend></td><td><rend>lies ((odas))</rend></td></tr></table></annot><annot startid="#m-b6ddf554-2072-4ee5-b73d-d92f355483a7" endid="#m-a1abd3a4-07d1-491f-91aa-c07a7ada4ec3"><table><tr><td><rend>((quoque))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur.</rend></td></tr></table></annot><annot startid="#m-b6ddf554-2072-4ee5-b73d-d92f355483a7" endid="#m-b50f6a38-633b-4f7c-8f8d-55278edbe639" corresp="#m-comment-31"><table><tr><td><ptr target="#m-comment-31-notes-0"/></td><td><rend>]</rend></td><td><rend>Notation vermutlich auf Rasur.</rend></td></tr></table></annot><annot startid="#m-026da7c3-8d3c-42e4-a74f-e3cfecc6fdf6" endid="#m-603ef0bb-0509-4695-85ea-60302661c125"><table><tr><td><rend>((perhite))</rend></td><td><rend>]</rend></td><td><rend>lies ((perite))</rend></td></tr></table></annot><annot startid="#m-fc6205e6-2253-488e-a71f-43c69097cd9b" endid="#m-50ab0742-9c66-463a-a15e-f49977a2cbaa"><table><tr><td><rend>((gaudio aeterno))</rend></td><td><rend>]</rend></td><td><rend>Buchstaben ((-o)) jeweils auf Rasur.</rend></td></tr></table></annot><annot startid="#m-4a307188-c69f-4466-859b-8c34f95a2e28" endid="#m-0356e209-e89e-4a7b-ae36-70428b9a2d3d"><table><tr><td><rend>((omnem))</rend></td><td><rend>]</rend></td><td><rend>vermutlich korrigiert aus ((omne))</rend></td></tr></table></annot><annot startid="#m-093d266a-01bb-4d6b-80bd-d26d9933090d" endid="#m-609c0b30-3caa-4aee-9ee4-df6c91bb649a"><table><tr><td><rend>((| agmina ... fidula))</rend></td><td><rend>]</rend></td><td><rend>Text auf Rasur, Initiale ((N)) regulär eingetragen.</rend></td></tr></table></annot><annot startid="#m-b5b53783-9dd5-4960-9765-75379cf0cb4c" endid="#m-ba4b5553-3360-4582-b193-359ff4189e8a"><table><tr><td><rend>((stridulam ... linguam))</rend></td><td><rend>]</rend></td><td><rend>vermutlich korrigiert aus ((stridula ... lingua))</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1871"><bibl><identifier type="siglum">Pa 1871</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1871-117-11</identifier><title>Gaudent ecce</title><incip><incipText><p>Gaudent ecce</p></incipText></incip><contents><contentItem><locus from="117">f. 117, l. 11</locus></contentItem></contents><biblList><bibl>AH 53, 64</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Pascha</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">118</term><term type="Endzeile">7</term><term type="Melodie_Standard">(Gaudent ecce)</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1871</identifier><identifier type="cantus">Pa 1871</identifier><titleStmt><title>Pa 