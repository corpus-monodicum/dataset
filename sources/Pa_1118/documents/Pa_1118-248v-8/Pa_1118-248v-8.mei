<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 1118-248v-8</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/c17df455-f82b-4463-b183-3806cceadef0</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Sequenzen)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot type="document">Nachtrag</annot><annot startid="#m-7d279487-0a58-49fc-910f-509c0929f79e" endid="#m-d1926778-5a02-47f0-b98b-0748cf467b9a"><table><tr><td><rend>2b ergänzt aufgrund von Wiederholungszeichen "d".</rend></td></tr></table></annot><annot startid="#m-6f85a640-8c6e-43c3-82d2-145923c72824" endid="#m-7a6cee27-fcaa-4905-ba1e-ae18f7b0f228"><table><tr><td><rend>7b ergänzt aufgrund von Wiederholungszeichen "d".</rend></td></tr></table></annot><annot startid="#m-e84aaf9a-02e0-40fb-88bc-7ec52f1f46c8" endid="#m-67cd25e9-827d-43c2-930a-430ee184418b"><table><tr><td><rend>8b ergänzt aufgrund von Wiederholungszeichen "d".</rend></td></tr></table></annot><annot startid="#m-0fde23ef-6067-44b7-9700-3de80d64aef8" endid="#m-d0899626-2df8-48b0-af09-a449539cbe87"><table><tr><td><rend>9b ergänzt aufgrund von Wiederholungszeichen "d".</rend></td></tr></table></annot><annot startid="#m-33e804ad-9f6d-4350-8ef9-efbbd9dab36c" endid="#m-542fd349-406f-43ab-81e2-12b73e522c9f"><table><tr><td><rend>10b ergänzt aufgrund von Wiederholungszeichen "d".</rend></td></tr></table></annot><annot startid="#m-0ba03cca-87e1-4649-8ccd-23ce3a00b942" endid="#m-4f30371c-c9c4-4887-8bee-78976b4046f3"><table><tr><td><rend>11b ergänzt aufgrund von Wiederholungszeichen "d".</rend></td></tr></table></annot><annot startid="#m-a367db77-a9d4-409e-93ae-8354b905b70d" endid="#m-26d30f15-6e21-4987-ac50-164f4418f74a" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>]</rend></td><td><rend>davor ((eq(aliter))), was zunächst überflüssig erscheint. Möglicherweise soll es auf die Abweichung gegenüber ((Pa 1121)) aufmerksam machen, wo die zweite Hälfte der Melodie eine Quinte höher steht.</rend></td></tr></table></annot><annot startid="#m-c12e5a8a-0919-4a57-becc-f8ff18b464a5" endid="#m-8accaec8-dc02-4830-8890-d03bb12e760b" corresp="#m-comment-7"><table><tr><td><ptr target="#m-comment-7-notes-0"/></td><td><rend>]</rend></td><td><rend>möglicherweise korrigiert aus</rend></td><td><ptr target="#m-comment-7-notes-1"/></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Nachtrag. Notation mit Kustoden.</rend></td></tr><tr><td><rend>Diese zweite Aufzeichnung der Melodie ((Cignea)) passt zu keiner der Textierungen in ((Pa 1118)), steht aber ((Adest namque, Pa 1235-212-12)) und ((Esxultet nunc, Pa 1235-241v-3)) nahe. Die weitgehende Übereinstimmung der Melodie mit den Handschriften von St. Martial legt nahe, dass der Nachtrag in St. Martial eingetragen wurde.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1118"><bibl><identifier type="siglum">Pa 1118</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1118-248v-8</identifier><title>Alleluia</title><incip><incipText><p>Alleluia</p></incipText></incip><contents><contentItem><locus from="248v">f. 248v, l. 8</locus></contentItem></contents><classification><termList><term type="genre">Sequenz</term><term type="genre">Textlos</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">248v</term><term type="Endzeile">15</term><term type="Melodie_Standard">Cignea</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1118</identifier><titleStmt><title>Pa 1118</title></titleStmt><creation><geogName role="origin">Tavèrnoles (möglicherweise)</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Sant Sadurní</corpName><date>10. Jh. 4. Viertel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 1118</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-105b9648-7151-42ff-9d2e-5fd187a560b4"><section xml:id="m-0cbdc2ef-88d6-4be3-adb5-4dab87cc8b8c" label="1"><section xml:id="m-d11a2adc-4e73-45a6-97f4-4d166562fd16"><sb xml:id="m-b19a969f-d849-46f9-9c56-2d65a93aec8f"/><staff n="1"><layer n="1"><syllable xml:id="m-c79a4fb5-1084-47ba-960b-a3177782b28f"><syl wordpos="i" con="d">Al-</syl><neume><nc xml:id="m-c12e5a8a-0919-4a57-becc-f8ff18b464a5" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-80bc3d6f-3b3e-4715-a4d2-f2dddcfb1d0b"><syl wordpos="m" con="d">le-</syl><neume><nc xml:id="m-324a9371-fb2e-4090-ba9b-20434bd811dc" pname="g" oct="4"/></neume></syllable><syllable xml:id="m-d49ac402-6b99-47ac-a66b-0e1cb15b05b8"><syl wordpos="m" con="d">lvi-</syl><neume><nc xml:id="m-6d999c1d-a71f-4026-858c-f4b86020e084" pname=