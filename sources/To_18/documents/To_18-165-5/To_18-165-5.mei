<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>To 18-165-5</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/67f9e9f5-8f1f-40b1-b501-833d95b3b98d</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-8c3c1533-48c7-4e7c-87e8-5b337ca1926d" endid="#m-735c4491-b733-47d5-9167-e136a2c2f4c1">Der dritte aufgezeichnete Teil ist in der Edition aufgrund der internen melodischen Erweiterung als 3C eingeordnet. Denkbar wäre auch eine Einordnung als 3A, d.h. ein Melodieschema aaa a’a’a‘ a‘‘a‘‘a‘‘.</annot><annot startid="#m-63d0a2ee-b1f9-4009-8112-54c29eb0a8c6" endid="#m-48f221f3-24f1-4d7a-8d79-6536a73a4009" corresp="#m-comment-1"><table><tr><td><ptr target="#m-comment-1-notes-0"/></td><td><rend>]</rend></td><td><rend>Rasur nach der 2. Note.</rend></td></tr></table></annot><annot startid="#m-d3753467-c8f6-4906-872a-97ed40bcc143" endid="#m-f4e19a7a-c174-4116-aafc-a5c9737b0ddf" corresp="#m-comment-2"><table><tr><td><ptr target="#m-comment-2-notes-0"/></td><td><rend>]</rend></td><td><rend>Rasur nach der 2. Note.</rend></td></tr></table></annot><annot startid="#m-5512955e-d37f-4234-ac8c-5de2d7a19a33" endid="#m-e07d512f-7b77-420c-ad56-13fe0d3f96d9" corresp="#m-comment-3"><table><tr><td><ptr target="#m-comment-3-notes-0"/></td><td><rend>]</rend></td><td><rend>Rasur nach der 2. Note.</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Melodieschema:</rend></td></tr><tr><td><table><tr><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a'</rend></td><td><rend>a'</rend></td><td><rend>a'</rend></td><td><rend>a</rend></td><td><rend>a</rend></td><td><rend>a"</rend></td></tr><tr><td><rend>1A</rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend>2A</rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend> </rend></td><td><rend>3C</rend></td></tr></table></td></tr><tr><td><rend>Der 3. aufgezeichnete Teil ist in der Edition aufgrund der internen melodischen Erweiterung, die für Schlussteile des Kyrie typisch ist, als 3C eingeordnet. Denkbar wäre auch eine Einordnung als 3A, dann lautet das Melodieschema aaa a'a'a' a"a"a".</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-to-18"><bibl><identifier type="siglum">To 18</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>To 18-165-5</identifier><title>Kyrie eleyson</title><incip><incipText><p>Kyrie eleyson</p></incipText></incip><contents><contentItem><locus from="165">f. 165, l. 5</locus></contentItem></contents><classification><termList><term type="genre">Kyrie</term><term type="genre">untropiert</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">165</term><term type="Endzeile">6</term><term type="Melodiennummer_Katalog">Melnicki 71: 1A 2A 3C</term><term type="Cantus_ID">509501</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">To 18</identifier><identifier type="cantus">To 18</identifier><titleStmt><title>To 18</title></titleStmt><creation><geogName role="origin">Bobbio</geogName><geogName role="origin-region">Quellen italienischer Herkunft</geogName><corpNam