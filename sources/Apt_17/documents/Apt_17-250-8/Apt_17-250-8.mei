46b-0519d8f6977b" endid="#m-c7a0ea3d-ea68-4182-bd92-b95cc3f3b17a"><table><tr><td><rend>((Omnipotens petimus))</rend></td><td><rend>]</rend></td><td><rend>Das Inzipit verweist auf die vollständige Aufzeichnung im Komplex ((O nova res, Apt 17-111-4)) als ((Susc 33)) bzw. ((Hodie est fratres, Apt 17-313-2)) als ((Gaudeamus intr 112)).</rend></td></tr></table></annot><annot startid="#m-dd177804-db37-4a66-8784-100806f2df27" endid="#m-0be9f14d-2b04-474e-99fc-c2ed8da13518" type="emendation" corresp="#m-comment-5"><table><tr><td><ptr target="#m-comment-5-notes-0"/></td><td><rend>(wie ((Pa 1871)))</rend></td><td><ptr target="#m-comment-5-notes-1"/></td><td><rend>, vermutlich ist der folgende Sprung, der für die Lesung des Anfangs entscheidend ist, aus Platzgründen zu eng notiert (Quarte statt Quinte).</rend></td></tr></table></annot><annot startid="#m-1b44308c-01d6-4cbd-9710-12e12e2be06c" endid="#m-cad8bb94-eaed-4519-8419-40b89adf5651" type="emendation" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>(wie ((Pa 1871)))</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-6-notes-1"/></td><td><rend>(alles Folgende eine Stufe tiefer).</rend></td></tr></table></annot><annot startid="#m-950078cc-f7bf-45fd-835b-9c712cf4c821" endid="#m-e03cd6ea-9ca4-40e2-8807-970701b950a8"><table><tr><td><rend>((imma))</rend></td><td><rend>]</rend></td><td><rend>lies ((ima))</rend></td></tr></table></annot><annot startid="#m-b2afe86b-4d0c-49f5-a4c2-e18ac78d89cc" endid="#m-f4a2d829-1368-4d18-a1d7-e10a92054940"><table><tr><td><rend>((Eia ca&lt;nendo&gt;))</rend></td><td><rend>]</rend></td><td><rend>Das Inzipit verweist auf die vollständige Aufzeichnung im Komplex ((O nova res, Apt 17-111-4)) als ((Susc 50)) bzw. ((Hodie est fratres, Apt 17- 313-2)) als ((Gaudeamus intr 36)).</rend></td></tr></table></annot><annot startid="#m-ac983810-b762-49ae-8d1c-3b7d07bbf76d" endid="#m-7935af81-c7cb-4444-b268-357cc821aa79" type="emendation" corresp="#m-comment-9"><