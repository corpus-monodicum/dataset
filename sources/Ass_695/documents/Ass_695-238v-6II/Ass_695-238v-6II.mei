ige Partituraufzeichnung mit zwei Texten; die Texte werden in der Edition separat wiedergegeben, dies ist der obere.</rend></td></tr><tr><td><rend>Obere Stimme zu ((Ass 695-238v-6-I)).</rend></td></tr><tr><td><rend>Eine Partiturdarstellung ist in der Funktion "Versionen vergleichen" möglich.</rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-ass-695"><bibl><identifier type="siglum">Ass 695</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Ass 695-238v-6II</identifier><title>Verbum bonum</title><incip><incipText><p>Verbum bonum</p></incipText></incip><contents><contentItem><locus from="238v">f. 238v, l. 6</locus></contentItem></contents><biblList><bibl>AH 54, 218</bibl><bibl type="printed-edition">CM III</bibl></biblList><classification><termList><term type="genre">Sequenz</term><term type="genre">Textiert</term><term type="feast">Beata Maria virgo</term><term type="feast">Messe</term><term type="Editor">Anna Sanda</term><term type="Endseite">239v</term><term type="Startposition">II</term><term type="Endzeile">5</term><term type="Melodie_Standard">–</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Ass 695</identifier><identifier type="cantus">Ass 695</identifier><titleStmt><title>Ass 695</title></titleStmt><creation><geogName role="origin">Reims (möglicherweise)</geogName><geogName role="origin-region">Quellen französischer Herkunft</geogName><date>13. Jh 2. Viertel</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Prosar</term></termList></classification><itemList><item><identifier type="shelfmark">Ms. 695</identifier><physLoc><repository><geogName role="settlement">Assisi</geogName><corpName>Fondo Antico presso la Biblioteca del Sacro Convento</corpName></repositor