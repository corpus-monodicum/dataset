<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0"><meiHead xml:lang="en"><fileDesc><titleStmt><title>Pa 1119-101-6</title></titleStmt><pubStmt><identifier>https://corpus-monodicum.de/d/574601b4-1309-4e67-9c23-5d3caa27df2c</identifier><respStmt><corpName role="publisher">Corpus Monodicum</corpName></respStmt><address><addrLine>Domerschulstraße 13</addrLine><addrLine>97070 Würzburg</addrLine></address><availability><useRestrict auth.uri="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</useRestrict></availability><date isodate="2026-11-04"/></pubStmt><seriesStmt><title>Corpus Monodicum</title><respStmt><resp>Edition (Ordinariumsgesänge)</resp><persName>Andreas Pfisterer</persName></respStmt><funder>Akademie der Wissenschaften und der Literatur Mainz</funder></seriesStmt><notesStmt><annot startid="#m-8220eb38-4b1c-49ee-aba3-b76b812c184c" endid="#m-a5d0d9f8-ce11-466b-8970-6777db96d7c5" type="emendation"><table><tr><td><rend>((restaurati)) (wie ((Pa 1119-239v-3)))</rend></td><td><rend>]</rend></td><td><rend>((restaurauti))</rend></td></tr></table></annot><annot startid="#m-af07df55-4fa7-4e7d-b2d2-7a94b370f910" endid="#m-42479677-57e6-419c-aa08-c2eb53575e5d"><table><tr><td><rend>((Himmolatus))</rend></td><td><rend>]</rend></td><td><rend>lies ((Immolatus))</rend></td></tr></table></annot><annot startid="#m-d54fdf60-4044-48c7-8612-fb5662a31839" endid="#m-e68cccf8-2114-4431-aad4-4936dcf535d9"><table><tr><td><rend>((deus))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((decus))</rend></td></tr></table></annot><annot startid="#m-3dce2239-c651-400c-8f60-72fb742d3288" endid="#m-13230af5-d57a-493e-ab6b-e1e64fddc1bc"><table><tr><td><rend>((Mittis))</rend></td><td><rend>]</rend></td><td><rend>lies ((Mitis))</rend></td></tr></table></annot><annot startid="#m-7566cb1c-a9e8-46c7-b9a9-e21d261a01e5" endid="#m-9aba29c1-7717-462a-bc97-eecdfeea28b9" type="emendation" corresp="#m-comment-4"><table><tr><td><ptr target="#m-comment-4-notes-0"/></td><td><rend>]</rend></td><td><rend>Dem Eindruck der Notation nach Beginn mit ((G)), alles Folgende eine Stufe tiefer. Die Edition passt die Transpositionslage dem Primärgesang (((Pa 1119-90-2))) an.</rend></td></tr></table></annot><annot startid="#m-a7d2a46d-33dd-47f3-bd84-01b0dc790e01" endid="#m-f36e4514-1c0f-4e9f-bf99-356ea99f35e3" type="emendation" corresp="#m-comment-5"><table><tr><td><table><tr><td><rend>((Christe))</rend></td><td><rend>]</rend></td><td><rend>((Chiste))</rend></td></tr></table></td></tr><tr><td><table><tr><td><ptr target="#m-comment-5-notes-0"/></td><td><rend>]</rend></td><td><rend>korrigiert aus</rend></td><td><ptr target="#m-comment-5-notes-1"/></td></tr></table></td></tr></table></annot><annot startid="#m-fec30231-e855-4822-9bbe-0881bd72eb7f" endid="#m-afb16e05-47f3-4448-9a77-040482fbed7a" type="emendation" corresp="#m-comment-6"><table><tr><td><ptr target="#m-comment-6-notes-0"/></td><td><rend>(wie ((Pa 1119-90-2)))</rend></td><td><rend>]</rend></td><td><ptr target="#m-comment-6-notes-1"/></td><td><rend>(alles Folgende eine Stufe tiefer).</rend></td></tr></table></annot><annot startid="#m-98e84ba3-e63e-4ddf-a427-eb54b505cb30" endid="#m-8384e2e0-780a-4cfa-b181-88e66c878e1f" type="emendation" corresp="#m-comment-7"><table><tr><td><ptr target="#m-comment-7-notes-0"/></td><td><rend>]</rend></td><td><ptr target="#m-comment-7-notes-1"/></td><td><rend>(alles Folgende eine Stufe höher), die Emendation ist notwendig, um die folgende Einsatzmarke in derselben Transpositionslage zu halten.</rend></td></tr></table></annot><annot startid="#m-39e538a8-0abd-476f-9469-faaa08b08dfb" endid="#m-2f121b06-d8a3-4308-998c-8823c1f4f2a9" corresp="#m-comment-8"><table><tr><td><ptr target="#m-comment-8-notes-0"/></td><td><rend>]</rend></td><td><rend>die intervallischen Anschlüsse zwischen den drei Worten sind unklar, die Edition orientiert sich an der parallelen Aufzeichnung ((Pa 1119-239v)).</rend></td></tr></table></annot><annot startid="#m-3bf5541a-e217-4125-b5c1-737908d07a85" endid="#m-18a4e572-dae8-45c1-acdd-c19dac74cffd"><table><tr><td><rend>((perpes))</rend></td><td><rend>]</rend></td><td><rend>korrigiert aus ((perspes))</rend></td></tr></table></annot><annot type="global-comment"><table><tr><td><rend>Diese nur in St. Martial überlieferte Fassung des Tropenkomplexes stellt eine Erweiterung der Fassung von ((Pa 1118)) dar. Dabei sind fast konsequent ältere und neu gedichtete Textelemente in eine einheitliche metrische Form gebracht (s.u.). Daher weicht stellenweise der Zeilenfall der Ausgabe von ((CT XII)) ab.</rend></td></tr><tr><td><rend>((3, 30, 31, 4, 13, 43:)) 2x 5p+6p, 5p (gekürzte Variante der sapphischen Strophe ohne Beachtung der Quantitäten, Unregelmäßigkeiten in Elementen ((3, 30, 31, 4));</rend></td></tr><tr><td><rend>((2, 7, 11+12, 41, 14, 15:)) freier Wechsel von 5p und 6p;</rend></td></tr><tr><td><rend>((32:)) Pentameter;</rend></td></tr><tr><td><rend>((33, 44:)) Hexameter;</rend></td></tr><tr><td><rend>((45:)) 4x 8pp (ambrosianische Hymnenstrophe, hier nur als Inzipit, vollständig ((Pa 1119-113v-5)). </rend></td></tr></table></annot></notesStmt><sourceDesc><source xml:id="wit-pa-1119"><bibl><identifier type="siglum">Pa 1119</identifier></bibl></source></sourceDesc></fileDesc><encodingDesc><appInfo><application version="0.9.1"><name>Monodi-Zero</name></application></appInfo></encodingDesc><workList><work><identifier>Pa 1119-101-6</identifier><title>Rerum creator</title><incip><incipText><p>Rerum creator</p></incipText></incip><contents><contentItem><locus from="101">f. 101, l. 6</locus></contentItem></contents><biblList><bibl>CT XII, 13: 2 3 30 31 4 32 13 33 7 34 35 36 37 38 39 40 11+12 41 14 15 42 43 44+45</bibl></biblList><classification><termList><term type="genre">Gloria</term><term type="genre">tropiert</term><term type="feast">Messe</term><term type="Editor">Andreas Pfisterer</term><term type="Endseite">103v</term><term type="Endzeile">2</term><term type="Melodiennummer_Katalog">Bosse 39</term><term type="Cantus_ID">509502</term><term type="Band_Genre">Ordinariumsgesänge</term></termList></classification></work></workList><manifestationList><manifestation><identifier type="siglum">Pa 1119</identifier><titleStmt><title>Pa 1119</title></titleStmt><creation><geogName role="origin">Limoges</geogName><geogName role="origin-region">Quellen aquitanischer Herkunft</geogName><corpName role="origin-institution">Abtei Saint-Martial</corpName><date>11. Jh Mitte</date></creation><langUsage><language xml:lang="la"/></langUsage><classification><termList><term type="quellentyp">Tropar, Sequentiar</term></termList></classification><itemList><item><identifier type="shelfmark">Lat. 1119</identifier><physLoc><repository><geogName role="settlement">Paris</geogName><corpName>Bibliothèque nationale de France</corpName></repository></physLoc></item></itemList></manifestation></manifestationList><revisionDesc><change isodate="2026-11-04"><changeDesc><p>Exported with Monodi-Zero 0.9.1.</p></changeDesc></change></revisionDesc></meiHead><music><body><mdiv type="main"><score><scoreDef><staffGrp><staffDef n="1" notationtype="neume" lines="5" clef.shape="G" clef.line="2"/></staffGrp></scoreDef><section xml:id="m-a7c987b7-6be4-423b-81aa-b9f17ddae4ca"><section xml:id="m-9c33733a-12e7-48e8-8a0d-54a0fd2dc833"/><section xml:id="m-097dc038-c62c-4ba4-868d-9947d70d0a9e" label="2" type="Tropenelement"><sb xml:id="m-f9258ec0-6bb9-4a48-b971-b05c1fd4e54b"/><staff n="1"><layer n="1"><annot xml:id="m-b6f1d97a-8e81-4399-8607-3e92cc85b8aa" type="paratext" label="Gesang">Alie (f. 101)</annot><syllable xml:id="m-f2fb5324-bb51-4f53-99a3-f0f9d8b67e6e"><syl wordpos="i" con="d">Re-</syl><neume><nc xml:id="m-09f574f6-da66-4ca0-916d-aaefd6d0fd1f" pname="a" oct="4"/><nc xml:id="m-10f760fc-d531-45a5-88ab-41e798a2e441" pname="g" oct="4" con="g"/></neume></syllable><syllable xml:id="m-e2a37beb-03cb-407d-8c14-37110dc778ec"><syl wordpos="t">rum</syl><neume><nc xml:id="m-0d1f626a-d5dc-4876-907a-657b62f4b6d3" pname="a" oct="4"/